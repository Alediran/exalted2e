{
  "id": "exalted2e",
  "title": "Exalted Second Edition",
  "description": "An unofficial Foundry VTT game system for Exalted 2nd Edition by White Wolf / Onyx Path Publishing.",
  "version": "1.1.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14",
    "maximum": "14"
  },
  "authors": [
    {
      "name": "Community",
      "discord": ""
    }
  ],
  "esmodules": [
    "module/exalted2e.mjs"
  ],
  "styles": [
    "styles/_variables.css",
    "styles/_base.css",
    "styles/_components.css",
    "styles/_sheet-layout.css",
    "styles/_actor-character.css",
    "styles/_actor-npc.css",
    "styles/_items.css",
    "styles/_chat.css",
    "styles/_dialog.css",
    "styles/_hud.css",
    "styles/_actor.css",
    "styles/_actor-unit.css",
    "styles/_charm-tree.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "es",
      "name": "Español",
      "path": "lang/es.json"
    }
  ],
  "documentTypes": {
    "Actor": {
      "character": {},
