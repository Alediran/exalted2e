      "meritflaw":  {},
      "knack":      {},
      "virtueflaw": {},
      "combo":      {},
      "form":       {},
      "animapower": {},
      "urge":       {},
      "destiny":    {},
      "equipment":  {},
      "hearthstone": {},
      "martialartsstyle": {},
      "poison": {},
      "disease": {},
      "drug": {},
      "mutation": {},
      "manse": {},
      "familiar": {},
      "cult": {},
      "command": {},
      "followers": {},
      "thaum-art": {},
      "procedure": {},
      "resplendency": {},
      "manse-power": {},
      "ammo": {},
      "malados": {}
    },
    "RegionBehavior": {
      "hazardDamage":    {},
      "terrainModifier": {}
    }
  },
  "socket": false,
  "initiative": "(@attributes.wits.value + @attributes.perception.value)d10cs>=7",
