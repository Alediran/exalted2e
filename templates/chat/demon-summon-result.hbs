<div class="ex2e-roll-card ex2e-spell-cast-card">
  <div class="card-header">
    <span class="roll-actor">{{actorName}}</span>
    <span class="roll-flavor">{{spellName}}</span>
  </div>
  <div class="spell-cast-summary">
    <div class="spell-name-row">
      <span class="spell-name">{{demonName}}</span>
      <span class="spell-meta">{{circleLabel}}</span>
    </div>
    <div class="spell-cost-ledger">
      <span><strong>Pool:</strong> {{pool}}</span>
      <span><strong>Successes:</strong> {{successes}} / {{difficulty}}</span>
    </div>
    <p style="margin:4px 0;font-style:italic">{{outcomeText}}</p>
  </div>
</div>
