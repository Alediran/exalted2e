<div class="ex2e-roll-card ex2e-spell-cast-card">
  <div class="card-header">
    <span class="roll-actor">{{actorName}}</span>
    <span class="roll-flavor">{{spellName}}</span>
  </div>
  <div class="spell-cast-summary">
    <div class="spell-name-row">
      <span class="spell-name">{{ghostName}}</span>
    </div>
    <p style="margin:4px 0;font-style:italic">{{outcomeText}}</p>
    <p style="margin:2px 0;color:#888;font-size:.9em">{{totalRounds}} rounds</p>
  </div>
</div>
