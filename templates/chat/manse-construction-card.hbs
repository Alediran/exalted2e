<div class="ex2e-roll-card manse-construction-card">
  <div class="card-header">
    <span class="roll-actor">{{actorName}}</span>
    <span class="roll-flavor">{{title}}</span>
  </div>
  <div class="manse-card-body">
    {{#each lines}}<div>{{this}}</div>{{/each}}
    {{#if warning}}<div class="limit-break-warning">{{warning}}</div>{{/if}}
  </div>
</div>
