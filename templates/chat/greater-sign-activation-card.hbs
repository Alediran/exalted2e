<div class="ex2e-roll-card sign-activation-card">
  <div class="card-header">
    <i class="fa-solid {{icon}}"></i>
    <span class="sign-name">{{name}}</span>
  </div>
  <div class="sign-cost">{{localize "EX2E.GreaterSignMotesSpent"}}</div>
  {{#unless reversed}}
  <div class="sign-footer">
    <button type="button" class="btn-roll btn-reverse-sign">
      {{localize "EX2E.GreaterSignReverse"}}
    </button>
  </div>
  {{/unless}}
</div>
