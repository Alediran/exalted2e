<div class="ex2e-roll-card ex2e-attack-card"
     data-actor-id="{{actorId}}" data-target-id="{{targetId}}"
     data-damage-pool="{{rawDamagePool}}" data-damage-type="{{damageType}}"
     data-overwhelming="{{overwhelming}}">
  <div class="roll-header">
    {{#if actorName}}<span class="roll-actor">{{actorName}}</span>{{/if}}
    <span class="roll-flavor">{{weaponName}} — {{localize "EX2E.AttackRoll"}}</span>
    {{#if moteCost}}<span class="roll-cost">−{{moteCost}}m ({{moteType}})</span>{{/if}}
    {{#if stunt}}<span class="roll-stunt">{{stunt}}-die Stunt</span>{{/if}}
  </div>

  <div class="dice-results">
    {{#each dice as |d|}}
    <div class="die-result {{d.cls}}" title="{{#if (eq d.cls 'double-success')}}Double Success!{{else if (eq d.cls 'success')}}Success{{else if (eq d.cls 'one')}}One (−1){{else}}Miss{{/if}}">
      {{d.face}}
    </div>
    {{/each}}
  </div>

  <div class="pool-summary">
    {{pool}}d10 {{localize "EX2E.AttackRoll"}}
    {{#if firstExcDice}} · +{{firstExcDice}} <abbr title="First Excellency">1st Exc.</abbr>{{/if}}
  </div>

  {{#if secondExcSuccesses}}
  <div class="exc-bonus-row">+{{secondExcSuccesses}} <abbr title="Second Excellency">2nd Exc.</abbr></div>
  {{/if}}

  <div class="attack-resolution">

  {{#if defenseChosen}}
    {{!-- Resolved view: defender has chosen defense, show hit/miss + damage --}}
    <div class="attack-vs">
      <span>{{successes}} {{localize "EX2E.Successes"}} vs {{localize defenseLabelKey}} {{targetDV}}{{#if targetName}} ({{targetName}}){{/if}}</span>
    </div>

    {{#if defenseCharms.length}}
    <div class="defense-charms">
      <span class="defense-charms-label">{{localize "EX2E.Step2CharmsUsed"}}:</span>
      {{#each defenseCharms}}<span class="charm-chip">{{this}}</span>{{/each}}
    </div>
    {{/if}}

    {{#if showResolution}}
      {{#if hit}}
      <div class="roll-result success">
        <span class="result-label success-label">{{localize "EX2E.Hit"}} — {{threshold}} {{localize "EX2E.Threshold"}}</span>
      </div>
      <div class="damage-pool-info">
        {{localize "EX2E.DamagePool"}}: {{weaponDamage}}{{damageTypeLabel}} + {{threshold}}
        {{#if addStrength}} + {{strengthValue}} Str{{/if}}
        = <strong>{{rawDamagePool}}d10 {{damageTypeLabel}}</strong>
      </div>

      {{#if hardnessStops}}
      <div class="roll-result failure hardness-absorbed">
        <span class="result-label failure-label">{{localize "EX2E.HardnessStopsAttack"}} ({{localize "EX2E.Hardness"}} {{targetHardness}})</span>
      </div>
      {{else if showCounterattack}}
      {{!-- Step 9: Counterattack offered to the defender --}}
      <div class="step-pending-label">{{localize "EX2E.Step9Pending"}}</div>
      <div class="third-exc-reroll">
        <button class="btn-roll btn-counterattack">
          <i class="fa-solid fa-hand-fist"></i> {{localize "EX2E.Counterattack"}}
        </button>
        <button class="btn-roll btn-skip btn-skip-counterattack"
                title="{{localize 'EX2E.SkipStep'}}"
                aria-label="{{localize 'EX2E.SkipStep'}}">
          <i class="fa-solid fa-forward-step"></i>
        </button>
      </div>
      {{else if showRollDamage}}
      {{#if counterattackCharm}}
      <div class="defense-charms">
        <span class="defense-charms-label">{{localize "EX2E.CounterattackUsed"}}:</span>
        <span class="charm-chip">{{counterattackCharm}}</span>
      </div>
      {{/if}}
      {{!-- Step 10: hardness + soak + roll button --}}
      <div class="damage-roll-section">
        <div class="damage-soak-row">
          {{#if targetHardness}}<label title="{{localize 'EX2E.Hardness'}}">{{localize "EX2E.Hardness"}} {{targetHardness}}</label>{{/if}}
          <label>{{localize "EX2E.Soak"}}</label>
          <label class="soak-input">{{targetSoak}}</label>
        </div>
        <button class="btn-roll btn-roll-damage">
          <i class="fa-solid fa-burst"></i> {{localize "EX2E.RollDamage"}}
        </button>
      </div>
      {{/if}}
      {{else if botch}}
      <div class="roll-result botch">
        <span class="result-label botch-label">Botch</span>
      </div>
      {{else}}
      <div class="roll-result failure">
        <span class="result-label failure-label">{{localize "EX2E.Miss"}}</span>
      </div>
      {{/if}}
    {{else if showAttackerReroll}}
      <div class="step-pending-label">{{localize "EX2E.Step4Pending"}}</div>
      <div class="third-exc-reroll">
        <button class="btn-roll btn-attacker-reroll">
          <i class="fa-solid fa-arrows-rotate"></i> {{localize "EX2E.AttackerReroll"}}
        </button>
        <button class="btn-roll btn-skip btn-attacker-pass"
                title="{{localize 'EX2E.SkipStep'}}"
                aria-label="{{localize 'EX2E.SkipStep'}}">
          <i class="fa-solid fa-forward-step"></i>
        </button>
      </div>
    {{else if showDefenderReroll}}
      <div class="step-pending-label">{{localize "EX2E.Step5Pending"}}</div>
      <div class="third-exc-reroll">
        <button class="btn-roll btn-defender-reroll">
          <i class="fa-solid fa-arrows-rotate"></i> {{localize "EX2E.DefenderReroll"}}
        </button>
        <button class="btn-roll btn-skip btn-defender-pass"
                title="{{localize 'EX2E.SkipStep'}}"
                aria-label="{{localize 'EX2E.SkipStep'}}">
          <i class="fa-solid fa-forward-step"></i>
        </button>
      </div>
    {{/if}}

  {{else}}
    {{!-- Pre-defense view: defender picks their defense (or GM enters DV) --}}
    <div class="attack-vs">
      <span>{{successes}} {{localize "EX2E.Successes"}}{{#if targetName}} → {{targetName}}{{/if}}</span>
    </div>

    {{#if targetId}}
    <div class="defense-buttons">
      <button class="btn-roll btn-defend" data-defense-type="dodge">
        <i class="fa-solid fa-person-running"></i> {{localize "EX2E.DodgeDV"}} {{targetDodgeDV}}
      </button>
      <button class="btn-roll btn-defend" data-defense-type="parry">
        <i class="fa-solid fa-shield"></i> {{localize "EX2E.ParryDV"}} {{targetParryDV}}
      </button>
    </div>
    {{else}}
    <div class="defense-manual">
      <label>{{localize "EX2E.TargetDV"}}</label>
      <input type="number" class="manual-dv-input" min="0" max="30" value="0">
      <button class="btn-roll btn-resolve-manual">
        <i class="fa-solid fa-gavel"></i> {{localize "EX2E.Resolve"}}
      </button>
    </div>
    {{/if}}
  {{/if}}

  </div>
</div>
