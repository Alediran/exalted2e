<div class="ex2e-roll-card ex2e-item-card ex2e-combined-card">
  <div class="card-header">
    <h3>{{title}}</h3>
    {{#if actorName}}<span class="item-card-actor">{{actorName}}</span>{{/if}}
  </div>
  <div class="item-card-charm-list">
    {{#each entries}}
    <div class="charm-activation-row">
      {{#if this.charmImg}}<img src="{{this.charmImg}}" alt="{{this.charmName}}" class="charm-row-img">{{/if}}
      <span class="charm-row-name">{{this.charmName}}</span>
      {{#if this.costDisplay}}<span class="charm-row-cost">{{this.costDisplay}}</span>{{/if}}
    </div>
    {{/each}}
  </div>
  {{#if canReverse}}
  <div class="item-card-actions">
    <button type="button" class="btn-roll btn-reverse-charm"
            data-tooltip="{{localize 'EX2E.ReverseCharmTooltip'}}">
      <i class="fa-solid fa-rotate-left"></i> {{localize "EX2E.ReverseCharm"}}
    </button>
  </div>
  {{/if}}
</div>
