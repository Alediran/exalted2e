<div class="ex2e-roll-card resonance-eruption-card">
  <div class="roll-card-header">
    <img src="{{actor.img}}" class="roll-card-actor-img" alt="{{actor.name}}">
    <div class="roll-card-actor-name">{{actor.name}}</div>
  </div>
  <div class="roll-card-body">
    <p class="eruption-label">{{localize "EX2E.ResonanceEruption"}}</p>
    <p class="eruption-level">
      {{localize "EX2E.EruptionEssenceLevel"}}: <strong>{{essenceLevel}}</strong>
    </p>
  </div>
</div>
