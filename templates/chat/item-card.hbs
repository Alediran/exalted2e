<div class="ex2e-roll-card ex2e-item-card">
  <div class="card-header">
    <img src="{{item.img}}" alt="{{item.name}}" class="item-card-img">
    <div class="item-card-title">
      <h3>{{item.name}}</h3>
      {{#if actor}}<span class="item-card-actor">{{actor.name}}</span>{{/if}}
      <span class="keyword-tag">{{item.type}}</span>
    </div>
  </div>
  {{#if (eq item.type "charm")}}
  <div class="item-card-stats">
    <span><strong>Cost:</strong>
      {{item.system.cost.motes}}m
      {{#if item.system.cost.willpower}} +{{item.system.cost.willpower}}wp{{/if}}
      {{#if item.system.cost.bashingHealth}} +{{item.system.cost.bashingHealth}}hl(B){{/if}}
      {{#if item.system.cost.lethalHealth}} +{{item.system.cost.lethalHealth}}hl(L){{/if}}
      {{#if item.system.cost.aggravatedHealth}} +{{item.system.cost.aggravatedHealth}}hl(A){{/if}}
      {{#if item.system.cost.xp}} +{{item.system.cost.xp}}xp{{/if}}
    </span>
    <span><strong>Type:</strong> {{item.system.charmType}}</span>
    <span><strong>Duration:</strong> {{item.system.duration}}</span>
  </div>
  {{/if}}
  <div class="item-card-description">
    {{{item.system.description}}}
  </div>
  {{#if activation.cooperation}}
  <div class="cooperation-summary">
    <strong>{{localize "EX2E.Cooperation"}}</strong>
    <ul>
      {{#each activation.cooperation.supporters}}
      <li>{{this.name}} — {{this.motesPaid}}m</li>
      {{/each}}
    </ul>
    {{#if activation.cooperation.bonusDice}}
    <div class="cooperation-bonus">+{{activation.cooperation.bonusDice}} {{localize "EX2E.CooperationBonusDice"}}</div>
    {{else}}
    <div class="cooperation-bonus">{{localize "EX2E.CooperationSeeDescription"}}</div>
    {{/if}}
  </div>
  {{/if}}
  {{#if canReverse}}
  <div class="item-card-actions">
    <button type="button" class="btn-roll btn-reverse-charm"
            data-tooltip="{{localize 'EX2E.ReverseCharmTooltip'}}">
      <i class="fa-solid fa-rotate-left"></i> {{localize "EX2E.ReverseCharm"}}
    </button>
  </div>
  {{/if}}
</div>
