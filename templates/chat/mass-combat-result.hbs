<div class="mass-combat-result chat-card">
  <div class="card-header">
    <i class="fas fa-shield-halved"></i>
    <span class="attacker-name">{{attackerName}}</span>
    <i class="fas fa-arrow-right"></i>
    <span class="defender-name">{{defenderName}}</span>
  </div>

  {{!-- Step 1: Attack Roll --}}
  <div class="combat-step">
    <div class="step-label">{{localize "EX2E.MassCombatAttack"}} — {{attackPool}}d10 vs {{localize "EX2E.Drill"}} {{defenderDrill}}</div>
    <div class="dice-results">
      {{#each atkDiceDetails as |d|}}
      <div class="die-result {{d.cls}}">{{d.face}}</div>
      {{/each}}
    </div>
    <div class="step-result {{#if hit}}success{{else}}failure{{/if}}">
      {{attackSuccesses}} {{localize "EX2E.Successes"}} —
      {{#if hit}}{{localize "EX2E.MassCombatHit"}}{{else}}{{localize "EX2E.MassCombatMiss"}}{{/if}}
    </div>
  </div>

  {{!-- Step 2: Damage Roll (only on hit) --}}
  {{#if hit}}
  <div class="combat-step">
    <div class="step-label">
      {{localize "EX2E.MassCombatDamage"}} — {{localize "EX2E.Might"}} {{might}}d10 vs {{localize "EX2E.Endurance"}} {{endurance}}d10
    </div>
    <div class="damage-rolls">
      <div class="damage-pool-row">
        <span class="pool-label">{{localize "EX2E.Might"}}:</span>
        <div class="dice-results">
          {{#each mightDiceDetails as |d|}}
          <div class="die-result {{d.cls}}">{{d.face}}</div>
          {{/each}}
        </div>
        <span class="pool-successes">{{mightSuccesses}}</span>
      </div>
      <div class="damage-pool-row">
        <span class="pool-label">{{localize "EX2E.Endurance"}}:</span>
        <div class="dice-results">
          {{#each enduranceDiceDetails as |d|}}
          <div class="die-result {{d.cls}}">{{d.face}}</div>
          {{/each}}
        </div>
        <span class="pool-successes">{{enduranceSuccesses}}</span>
      </div>
    </div>
    <div class="step-result {{#if netDamage}}success{{else}}failure{{/if}}">
      {{localize "EX2E.Magnitude"}}: {{magBefore}} → {{magAfterDamage}}
      ({{localize "EX2E.MassCombatDamage"}}: {{netDamage}})
    </div>
  </div>

  {{!-- Step 3: Rout Check (only when damage > 0) --}}
  {{#if netDamage}}
  <div class="combat-step">
    <div class="step-label">
      {{localize "EX2E.MassCombatRout"}} — {{localize "EX2E.Morale"}} {{morale}}d10 vs {{localize "EX2E.Difficulty"}} {{netDamage}}
    </div>
    <div class="dice-results">
      {{#each routDiceDetails as |d|}}
      <div class="die-result {{d.cls}}">{{d.face}}</div>
      {{/each}}
    </div>
    <div class="step-result {{#if holds}}success{{else}}failure{{/if}}">
      {{moraleSuccesses}} {{localize "EX2E.Successes"}} —
      {{#if holds}}{{localize "EX2E.MassCombatHolds"}}{{else}}{{localize "EX2E.UnitRouted"}}{{/if}}
      {{#unless holds}}({{localize "EX2E.Magnitude"}}: {{magAfterDamage}} → {{magAfterRout}}){{/unless}}
    </div>
  </div>
  {{/if}}
  {{/if}}
</div>
