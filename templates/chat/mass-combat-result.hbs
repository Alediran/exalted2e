<div class="mass-combat-result chat-card {{#if heroAttacker}}hero-attacker{{/if}}{{#if heroDefender}}hero-defender{{/if}}">
  <div class="card-header">
    {{#if heroAttacker}}
    <i class="fas fa-person-rifle"></i>
    {{else}}
    <i class="fas fa-shield-halved"></i>
    {{/if}}
    <span class="attacker-name">{{attackerName}}</span>
    <i class="fas fa-arrow-right"></i>
    <span class="defender-name">{{defenderName}}</span>
  </div>

  {{!-- Step 1: Attack Roll --}}
  <div class="combat-step">
    <div class="step-label">
      {{#if heroAttacker}}
        {{localize "EX2E.HeroAttacksUnit"}} — {{attackPool}}d10
        {{#if aimBonus}}(+{{aimBonus}} {{localize "EX2E.ActionAim"}}) {{/if}}
        vs {{#if ranged}}{{localize "EX2E.UnitDodgeDV"}}{{else}}{{localize "EX2E.UnitParryDV"}}{{/if}} {{defenderDV}}
      {{else}}
        {{#if heroDefender}}{{localize "EX2E.UnitAttacksHero"}}{{else}}{{localize "EX2E.MassCombatAttack"}}{{/if}} — {{attackPool}}d10
        {{#if aimBonus}}(+{{aimBonus}} {{localize "EX2E.ActionAim"}}) {{/if}}
        vs {{#if heroDefender}}{{localize "EX2E.DV"}} {{defenderDV}}{{else}}{{localize "EX2E.Drill"}} {{defenderDrill}}{{/if}}
      {{/if}}
    </div>
    <div class="dice-results">
      {{#each atkDiceDetails as |d|}}
      <div class="die-result {{d.cls}}">{{d.face}}</div>
      {{/each}}
    </div>
    {{#unless heroAttacker}}
    <div class="step-detail">
      {{attackSuccesses}} {{localize "EX2E.Successes"}}
      {{#if ccrBonus}}+ {{ccrBonus}} {{#if ranged}}{{localize "EX2E.RCR"}}{{else}}{{localize "EX2E.CCR"}}{{/if}}{{/if}}
      {{#if might}}+ {{might}} {{localize "EX2E.Might"}}{{/if}}
      {{#if magDiff}}{{#if (gt magDiff 0)}}+{{/if}}{{magDiff}} {{localize "EX2E.Magnitude"}}{{/if}}
      = {{effectiveSuccesses}} {{localize "EX2E.Effective"}}
    </div>
    {{/unless}}
    <div class="step-result {{#if hit}}success{{else}}failure{{/if}}">
      {{#if hit}}{{localize "EX2E.MassCombatHit"}}{{else}}{{localize "EX2E.MassCombatMiss"}}{{/if}}
    </div>
  </div>

  {{!-- Step 2: Damage Roll --}}
  {{#if hit}}
  <div class="combat-step">
    {{#if heroAttacker}}
    <div class="step-label">
      {{localize "EX2E.MassCombatDamage"}} — {{heroDmgPool}}d10 vs {{armor}} {{localize "EX2E.Armor"}}
    </div>
    <div class="dice-results">
      {{#each dmgDiceDetails as |d|}}
      <div class="die-result {{d.cls}}">{{d.face}}</div>
      {{/each}}
    </div>
    {{else}}
    <div class="step-label">
      {{localize "EX2E.MassCombatDamage"}} — {{dmgRating}}d10
      {{#if heroDefender}}vs {{localize "EX2E.Soak"}} {{soak}}{{else}}vs {{endurance}}d10 + {{armor}} {{localize "EX2E.Armor"}}{{/if}}
    </div>
    <div class="damage-pool-row">
      <span class="pool-label">{{#if ranged}}{{localize "EX2E.RangedDamageRating"}}{{else}}{{localize "EX2E.CloseDamageRating"}}{{/if}}:</span>
      <div class="dice-results">
        {{#each dmgDiceDetails as |d|}}
        <div class="die-result {{d.cls}}">{{d.face}}</div>
        {{/each}}
      </div>
      <span class="pool-successes">{{dmgSuccesses}}</span>
    </div>
    {{#unless heroDefender}}
    <div class="damage-pool-row">
      <span class="pool-label">{{localize "EX2E.Endurance"}}:</span>
      <div class="dice-results">
        {{#each endDiceDetails as |d|}}
        <div class="die-result {{d.cls}}">{{d.face}}</div>
        {{/each}}
      </div>
      <span class="pool-successes">{{endSuccesses}}</span>
    </div>
    {{/unless}}
    {{#if heroDefender}}
    <div class="soak-row">
      <span>{{localize "EX2E.Soak"}}: {{soak}}</span>
    </div>
    {{#if minDamage}}
    <div class="min-damage-note">{{localize "EX2E.MinDamageFloor"}}: {{minDamage}}</div>
    {{/if}}
    {{/if}}
    {{/if}}
    <div class="step-result {{#if netDamage}}success{{else}}neutral{{/if}}">
      {{localize "EX2E.NetDamage"}}: {{netDamage}}
      {{#unless heroDefender}}
      ({{localize "EX2E.UnitHealth"}}: {{healthBefore}} → {{healthAfter}})
      ({{localize "EX2E.Magnitude"}}: {{magBefore}} → {{magAfterDamage}})
      {{/unless}}
    </div>
  </div>

  {{!-- Step 3: Rout Check (hidden for unit→hero) --}}
  {{#unless heroDefender}}
  {{#if magLostToDamage}}
  <div class="combat-step">
    <div class="step-label">
      {{localize "EX2E.MassCombatRout"}} — {{routPool}}d10 vs {{localize "EX2E.Difficulty"}} {{routDiff}}
      {{#if routFormMod}}({{localize "EX2E.Formation"}} {{localize "EX2E.Modifier"}} {{#if (gt routFormMod 0)}}+{{/if}}{{routFormMod}}){{/if}}
    </div>
    <div class="dice-results">
      {{#each routDiceDetails as |d|}}
      <div class="die-result {{d.cls}}">{{d.face}}</div>
      {{/each}}
    </div>
    <div class="step-result {{#if routHolds}}success{{else}}failure{{/if}}">
      {{routSuccesses}} {{localize "EX2E.Successes"}} —
      {{#if routHolds}}
        {{localize "EX2E.MassCombatHolds"}}
      {{else}}
        {{localize "EX2E.UnitRouted"}}
        ({{localize "EX2E.Magnitude"}}: {{magAfterDamage}} → {{magAfterRout}})
        <br><strong>{{defenderName}} {{localize "EX2E.UnitHesitates"}}</strong>
      {{/if}}
    </div>
  </div>
  {{/if}}
  {{/unless}}
  {{/if}}

  {{!-- Chokepoint warning --}}
  {{#if defChokepoint}}
  <div class="mc-chokepoint-warning">
    <i class="fas fa-exclamation-triangle"></i>
    {{defChokepointLabel}}
  </div>
  {{/if}}

  {{!-- Exhaustion roll buttons --}}
  {{#if showExhaustionButtons}}
  <div class="mc-exhaustion-buttons">
    {{#if attackerIsUnit}}
    <button class="mc-exhaustion-btn" data-action="roll-exhaustion"
      data-actor-id="{{attackerActorId}}"
      data-charged="{{attackerCharged}}">
      {{localize "EX2E.RollExhaustion"}} ({{attackerName}})
    </button>
    {{/if}}
    {{#if defenderIsUnit}}
    <button class="mc-exhaustion-btn" data-action="roll-exhaustion"
      data-actor-id="{{defenderActorId}}"
      data-charged="false">
      {{localize "EX2E.RollExhaustion"}} ({{defenderName}})
    </button>
    {{/if}}
  </div>
  {{/if}}
</div>
