<div class="ex2e-roll-card ex2e-shapeshift-card">
  <div class="card-header">
    <i class="fa-solid fa-paw"></i>
    <span class="card-title">{{localize "EX2E.ShapeshiftCardTitle"}}</span>
    <span class="card-actor">{{actorName}}</span>
  </div>
  <div class="shapeshift-line">
    {{#if isDBT}}
    {{localize "EX2E.ShapeshiftCardDBT"}} ({{cost}}m)
    {{else}}
    {{toLabel}}: <strong>{{targetName}}</strong> ({{cost}}m)
    {{/if}}
  </div>
</div>
