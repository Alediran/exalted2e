<div class="ex2e-roll-card social-attack-card">
  <div class="card-header">
    <img class="actor-portrait" src="{{attackerImg}}" alt="{{attackerName}}"/>
    <span class="attacker-name">{{attackerName}}</span>
    <span class="arrow">→</span>
    <img class="actor-portrait" src="{{defenderImg}}" alt="{{defenderName}}"/>
    <span class="defender-name">{{defenderName}}</span>
  </div>

  <div class="card-body">
    {{#if isMotivationBreak}}
    <div class="motivation-break-banner">
      {{motivationBreakProgressLabel}}
    </div>
    {{/if}}

    {{#if hasAttackerCharms}}
    <div class="attacker-charms-row">
      <strong>{{localize "EX2E.AttackerCharmsActivated"}}:</strong>
      {{#each attackerCharmNames}}<span class="charm-pill">{{this}}</span>{{/each}}
    </div>
    {{/if}}

    {{#if hasAttackerExcellency}}
    <div class="attacker-excellency-row">{{attackerExcellencyLabel}}</div>
    {{/if}}

    <div class="line"><strong>{{localize "EX2E.Intent"}}:</strong> {{intentLabel}}</div>
    {{#if subject}}
    <div class="line"><strong>{{localize "EX2E.Subject"}}:</strong> {{subject}}</div>
    {{/if}}

    <div class="line"><strong>{{localize "EX2E.SocialPool"}}:</strong> {{attributeLabel}} {{attributeValue}} + {{abilityLabel}} {{abilityValue}}{{#if stuntDice}} + {{stuntDice}} stunt{{/if}} = {{pool}} dice → {{rollSuccesses}} successes</div>

    <div class="line"><strong>{{localize "EX2E.ModifierClaims"}}:</strong>
      {{localize "EX2E.ClaimSupporting"}} {{bestSupporting}}, {{localize "EX2E.ClaimOpposing"}} {{bestOpposing}}, {{localize "EX2E.AppearanceDelta"}} {{mdvShiftFromApp}}
    </div>

    {{#if step2Resolved}}
    <div class="line"><strong>{{localize "EX2E.EffectiveMDV"}}:</strong> {{baseMDV}} → {{effectiveMDV}}{{#if step2Result.firstExcDice}} (+{{step2Result.firstExcDice}} {{localize "EX2E.FirstExcellency"}}){{/if}}{{#if step2Result.secondExcSucc}} (+{{step2Result.secondExcSucc}} {{localize "EX2E.SecondExcellency"}}){{/if}}</div>

    <div class="line">
      <strong>{{localize "EX2E.NetSuccesses"}}:</strong> {{netSuccesses}}
      &middot;
      <strong>{{#if hit}}{{localize "EX2E.ResultHit"}}{{else}}{{localize "EX2E.ResultMiss"}}{{/if}}</strong>
      {{#if hit}}{{#unless motesResistApplied}}{{#unless perfectDefense}}&middot; <strong>{{localize "EX2E.WPToResist"}}:</strong> {{wpToResist}}{{/unless}}{{/unless}}{{/if}}
    </div>

    {{#if perfectDefense}}
    <div class="line social-resolved-perfect">
      {{localize "EX2E.SocialResolvedPerfectDefended"}}
    </div>
    {{/if}}

    {{#if motesResistApplied}}
    <div class="line social-resolved-motes">
      {{localize "EX2E.SocialResolvedResistedViaMotes"}}
    </div>
    {{/if}}
    {{else}}
    <div class="line"><strong>{{localize "EX2E.EffectiveMDV"}}:</strong> {{baseMDV}} → {{preStep2EffectiveMDV}} <em>({{localize "EX2E.SocialAttackStep2Pending"}})</em></div>

    {{#if canDefend}}
    <div class="social-step2-controls">
      <button type="button" class="btn-roll btn-social-step2">
        <i class="fa-solid fa-shield"></i> {{localize "EX2E.SocialDefendStep2Button"}}
      </button>
    </div>
    {{/if}}
    {{/if}}

    {{#if autoFailedByNaturalCap}}
    <div class="line auto-fail-natural-cap">
      {{localize "EX2E.AutoFailedNaturalCap"}}
    </div>
    {{/if}}

    {{#if step2Resolved}}
    {{#if hit}}
    {{#unless resolution}}
    {{#if canRespond}}
    {{#if isMotivationBreak}}
    {{!-- 3c-2: Motivation-break resolution buttons --}}
    <div class="motivation-break-buttons">
      <button type="button" class="btn-roll btn-motivation-refuse" {{#unless canRefuse}}disabled{{/unless}}>
        {{localize "EX2E.MotivationBreakRefuseButton"}}
      </button>
      <button type="button" class="btn-roll btn-motivation-break" {{#unless canBreak}}disabled{{/unless}}>
        {{localize "EX2E.MotivationBreakBreakButton"}}
      </button>
    </div>
    {{else}}
    <div class="social-response-controls">
      {{#if wpToResist}}
      <button type="button" class="btn-roll btn-social-resist"
              data-wp="{{wpToResist}}"
              {{#unless canAffordResist}}title="{{localize 'EX2E.InsufficientWillpower'}}"{{/unless}}>
        {{localize "EX2E.SpendWPToResist" count=wpToResist}}
      </button>
      {{/if}}
      <button type="button" class="btn-roll btn-social-accept">{{localize "EX2E.AcceptAttack"}}</button>
    </div>
    {{/if}}
    {{/if}}
    {{/unless}}

    {{#if resolution}}
    <div class="social-resolution">
      {{#if (eq resolution.outcome "resisted")}}
      <strong>{{localize "EX2E.ResolutionResisted" wp=resolution.wpSpentByDefender}}</strong>
      {{/if}}
      {{#if (eq resolution.outcome "accepted-narration")}}
      <strong>{{#if (eq intent "build")}}{{localize "EX2E.ResolutionAcceptedBuild"}}{{else}}{{localize "EX2E.ResolutionAcceptedCompel"}}{{/if}}</strong>
      {{/if}}
      {{#if (eq resolution.outcome "accepted-ablation")}}
      <strong>{{localize "EX2E.ResolutionAblation" name=resolution.erodedIntimacyName after=resolution.ablationDamageAfter}}</strong>
      {{/if}}
      {{#if (eq resolution.outcome "accepted-eroded")}}
      <strong>{{localize "EX2E.ResolutionEroded" name=resolution.erodedIntimacyName before=resolution.erodedIntimacyStrengthBefore after=resolution.erodedIntimacyStrengthAfter}}</strong>
      {{/if}}
      {{#if (eq resolution.outcome "perfect-defended")}}
      <strong>{{localize "EX2E.SocialResolvedPerfectDefended"}}</strong>
      {{/if}}
      {{#if (eq resolution.outcome "resisted-via-motes")}}
      <strong>{{localize "EX2E.SocialResolvedResistedViaMotes"}}</strong>
      {{/if}}
      {{#if (eq resolution.outcome "break-refused")}}
      <strong>{{motivationBreakRefusedLabel}}</strong>
      {{/if}}
      {{#if (eq resolution.outcome "broken")}}
      <strong>{{motivationBreakBrokenLabel}}</strong>
      {{/if}}
    </div>

    {{#if canReverse}}
    {{#unless reversed}}
    <div class="social-reverse-row">
      <button type="button" class="btn-roll btn-social-reverse">{{localize "EX2E.ReverseSocialAttack"}}</button>
    </div>
    {{/unless}}
    {{/if}}

    {{#if reversed}}
    <div class="social-resolution reversed"><em>{{localize "EX2E.SocialAttackReversed"}}</em></div>
    {{/if}}
    {{/if}}
    {{/if}}
    {{/if}}
  </div>
</div>
