<form class="ex2e-roll-dialog flurry-dialog" autocomplete="off">
  <div class="dialog-content">

    <p class="flurry-header">
      {{#if actorName}}<strong>{{actorName}}</strong> — {{/if}}
      {{localize "EX2E.FlurryIntro"}}
    </p>

    <div class="flurry-rows">
      <div class="flurry-row flurry-row-header">
        <span class="flurry-col-name">{{localize "EX2E.FlurryActionName"}}</span>
        <span class="flurry-col-speed">{{localize "EX2E.ActionSpeed"}}</span>
        <span class="flurry-col-dvmod">{{localize "EX2E.FlurryDvMod"}}</span>
        <span class="flurry-col-remove"></span>
      </div>

      {{#each actions as |a i|}}
      <div class="flurry-row" data-index="{{i}}">
        <select name="actions.{{i}}.actionKey" class="flurry-col-name">
          {{#each @root.actionOptions as |opt|}}
          <option value="{{opt.key}}"
                  {{#if opt.disabled}}disabled{{/if}}
                  {{#if (eq opt.key ../a.actionKey)}}selected{{/if}}>{{opt.label}}</option>
          {{/each}}
        </select>
        <input type="number"
               name="actions.{{i}}.speed"
               class="flurry-col-speed"
               value="{{a.speed}}"
               min="0" max="20">
        <input type="number"
               name="actions.{{i}}.dvMod"
               class="flurry-col-dvmod"
               value="{{a.dvMod}}"
               min="0" max="10">
        <button type="button"
                class="flurry-col-remove btn-row"
                data-action="removeAction"
                data-index="{{i}}"
                {{#unless @root.canRemove}}disabled{{/unless}}
                aria-label="{{localize 'EX2E.Remove'}}">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      {{!-- Draw-weapon picker: only interactive when this row's action is Draw. --}}
      <div class="flurry-draw-row {{#unless (eq a.actionKey @root.drawActionKey)}}hidden{{/unless}}"
           data-index="{{i}}">
        <label>{{localize "EX2E.FlurryDrawWeapon"}}</label>
        <select name="actions.{{i}}.weaponId">
          <option value="">{{localize "EX2E.FlurryDrawNone"}}</option>
          {{#each @root.unequippedWeapons as |w|}}
          <option value="{{w.id}}" {{#if (eq w.id ../a.weaponId)}}selected{{/if}}>{{w.name}}</option>
          {{/each}}
        </select>
      </div>
      {{/each}}
    </div>

    <div class="flurry-add-row">
      <button type="button" class="btn-preset" data-action="addAction">
        <i class="fa-solid fa-plus"></i> {{localize "EX2E.FlurryAddAction"}}
      </button>
    </div>

    <div class="flurry-preview">
      <div><strong>{{localize "EX2E.FlurryActions"}}:</strong> <span data-preview="count">{{preview.count}}</span></div>
      <div><strong>{{localize "EX2E.FlurryDicePenalty"}}:</strong> −<span data-preview="dicePenalty">{{preview.dicePenalty}}</span></div>
      <div><strong>{{localize "EX2E.FlurrySpeed"}}:</strong> <span data-preview="speed">{{preview.speed}}</span></div>
      <div><strong>{{localize "EX2E.FlurryDvPenalty"}}:</strong> −<span data-preview="dvPenalty">{{preview.dvPenalty}}</span></div>
    </div>

  </div>
  <footer class="form-footer">
    <button type="button" class="btn-roll" data-action="cancel">
      <i class="fa-solid fa-xmark"></i> {{localize "EX2E.Cancel"}}
    </button>
    <button type="button" class="btn-roll" data-action="confirm">
      <i class="fa-solid fa-burst"></i> {{localize "EX2E.FlurryDeclare"}}
    </button>
  </footer>
</form>
