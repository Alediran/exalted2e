<form class="ex2e-roll-dialog" autocomplete="off">
  <div class="dialog-content">

    {{!-- Target --}}
    <div class="field-group">
      <label>{{localize "EX2E.Target"}}</label>
      {{#if target}}
      <div class="target-row">
        <img src="{{target.img}}" alt="{{target.name}}" class="target-img"/>
        <span class="target-name">{{target.name}}</span>
        <button type="button" class="btn-pick-target" data-action="pickTarget">{{localize "EX2E.PickTarget"}}</button>
      </div>
      {{else}}
      <div class="target-row target-empty">
        <span class="target-name">—</span>
        <button type="button" class="btn-pick-target" data-action="pickTarget">{{localize "EX2E.PickTarget"}}</button>
      </div>
      {{/if}}
    </div>

    {{!-- Attribute / Ability --}}
    <div class="field-group">
      <label>{{localize "EX2E.SocialAttackAttribute"}}</label>
      <select name="attribute">
        <option value="charisma"     {{#if (eq attribute "charisma")}}selected{{/if}}>{{localize "EX2E.AttrCharisma"}}</option>
        <option value="manipulation" {{#if (eq attribute "manipulation")}}selected{{/if}}>{{localize "EX2E.AttrManipulation"}}</option>
      </select>
    </div>

    <div class="field-group">
      <label>{{localize "EX2E.SocialAttackAbility"}}</label>
      <select name="ability">
        <option value="presence"      {{#if (eq ability "presence")}}selected{{/if}}>{{localize "EX2E.AbilityPresence"}}</option>
        <option value="performance"   {{#if (eq ability "performance")}}selected{{/if}}>{{localize "EX2E.AbilityPerformance"}}</option>
        <option value="investigation" {{#if (eq ability "investigation")}}selected{{/if}}>{{localize "EX2E.AbilityInvestigation"}}</option>
        <option value="bureaucracy"   {{#if (eq ability "bureaucracy")}}selected{{/if}}>{{localize "EX2E.AbilityBureaucracy"}}</option>
      </select>
    </div>

    {{!-- Intent + Subject --}}
    <div class="field-group">
      <label>{{localize "EX2E.SocialIntent"}}</label>
      <select name="intent">
        <option value="build"            {{#if (eq intent "build")}}selected{{/if}}>{{localize "EX2E.IntentBuild"}}</option>
        <option value="erode"            {{#if (eq intent "erode")}}selected{{/if}}>{{localize "EX2E.IntentErode"}}</option>
        <option value="compel"           {{#if (eq intent "compel")}}selected{{/if}}>{{localize "EX2E.IntentCompel"}}</option>
        <option value="break-motivation" {{#if (eq intent "break-motivation")}}selected{{/if}}>{{localize "EX2E.IntentBreakMotivation"}}</option>
      </select>
    </div>

    <div class="field-group">
      <label>
        {{#if (eq intent "build")}}{{localize "EX2E.SubjectBuildLabel"}}
        {{else if (eq intent "erode")}}{{localize "EX2E.SubjectErodeLabel"}}
        {{else if (eq intent "compel")}}{{localize "EX2E.SubjectCompelLabel"}}
        {{else}}{{localize "EX2E.Subject"}}{{/if}}
      </label>
      <input type="text" name="subject" value="{{subject}}" />
    </div>

    {{!-- 3c-2: Motivation-break target --}}
    {{#if isBreakIntent}}
    <div class="field-group social-motivation-break">
      <label>{{localize "EX2E.MotivationBreakTargetLabel"}}</label>
      <input type="text"
             name="targetMotivation"
             value="{{effectiveTargetMotivation}}"
             {{#if campaignTargetReadOnly}}readonly{{/if}}
             placeholder="{{localize "EX2E.MotivationBreakTargetLabel"}}" />
      {{#if campaignInProgress}}
        <p class="hint">{{campaignProgressLabel}}</p>
      {{/if}}
    </div>
    {{/if}}

    {{!-- Modifier claims --}}
    <div class="field-group claim-group">
      <label>{{localize "EX2E.ModifierClaims"}}</label>
      <div class="claim-row">
        <span class="claim-header">{{localize "EX2E.ClaimSupporting"}}</span>
        <label class="claim-check"><input type="checkbox" name="supportingIntimacy"   {{#if claims.supportingIntimacy}}checked{{/if}}> {{localize "EX2E.IntimacyTie"}} <span class="claim-modifier">−1</span></label>
        <label class="claim-check"><input type="checkbox" name="supportingVirtue"     {{#if claims.supportingVirtue}}checked{{/if}}> {{localize "EX2E.Virtues"}} ≥3 <span class="claim-modifier">−2</span></label>
        <label class="claim-check"><input type="checkbox" name="supportingMotivation" {{#if claims.supportingMotivation}}checked{{/if}}> {{localize "EX2E.Motivation"}} <span class="claim-modifier">−3</span></label>
      </div>
      <div class="claim-row">
        <span class="claim-header">{{localize "EX2E.ClaimOpposing"}}</span>
        <label class="claim-check"><input type="checkbox" name="opposingIntimacy"   {{#if claims.opposingIntimacy}}checked{{/if}}> {{localize "EX2E.IntimacyTie"}} <span class="claim-modifier">+1</span></label>
        <label class="claim-check"><input type="checkbox" name="opposingVirtue"     {{#if claims.opposingVirtue}}checked{{/if}}> {{localize "EX2E.Virtues"}} ≥3 <span class="claim-modifier">+2</span></label>
        <label class="claim-check"><input type="checkbox" name="opposingMotivation" {{#if claims.opposingMotivation}}checked{{/if}}> {{localize "EX2E.Motivation"}} <span class="claim-modifier">+3</span></label>
      </div>
      <div class="claim-row">
        <label class="claim-check"><input type="checkbox" name="immediateThreat" {{#if claims.immediateThreat}}checked{{/if}}> {{localize "EX2E.ClaimImmediateThreat"}}</label>
      </div>
      <div class="claim-row">
        <label class="claim-check"><input type="checkbox" name="unnaturalInfluence" {{#if claims.unnaturalInfluence}}checked{{/if}}> {{localize "EX2E.UnnaturalInfluence"}} <span class="umi-charm-driven-hint" style="display:none">{{localize "EX2E.UMIChargeChipDriven"}}</span></label>
      </div>
    </div>

    {{!-- Stunt --}}
    <div class="field-group">
      <label>{{localize "EX2E.StuntDice"}}</label>
      <select name="stuntDice">
        {{#each stuntChoices as |label key|}}
        <option value="{{key}}" {{#if (eq ../stuntDice key)}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>

    <div class="field-group stunt-motivation-row" style="display:none">
      <label>
        <input type="checkbox" name="stuntAdvancesMotivation" {{#if advancesMotivation}}checked{{/if}}>
        {{localize "EX2E.StuntAdvancesMotivation"}}
      </label>
    </div>

    <div class="field-group stunt-reward-pref-row" style="display:none">
      <label>{{localize "EX2E.StuntRewardPreference"}}</label>
      <div class="stunt-reward-radio">
        <label><input type="radio" name="stuntRewardKind" value="motes"     {{#if (eq rewardKind "motes")}}checked{{/if}}> {{localize "EX2E.StuntRewardMotes"}}</label>
        <label><input type="radio" name="stuntRewardKind" value="willpower" {{#if (eq rewardKind "willpower")}}checked{{/if}}> {{localize "EX2E.StuntRewardWillpower"}}</label>
      </div>
    </div>

    {{!-- 3c-1: Charm picker --}}
    {{#if hasPickerCharms}}
    <div class="field-group attack-charm-picker">
      <label>{{localize "EX2E.SocialAttackCharmsLabel"}}</label>
      <ul class="attack-charm-list">
        {{#each pickerCharms}}
        <li class="attack-charm-row">
          <label class="attack-charm-label">
            <input type="checkbox" name="charm-{{this.id}}" data-umi="{{this.isUmi}}" />
            <span class="charm-name">{{this.name}}</span>
            {{#if this.tagLabel}}<span class="charm-kw">{{this.tagLabel}}</span>{{/if}}
            {{#if this.costLabel}}<span class="charm-cost">{{this.costLabel}}</span>{{/if}}
          </label>
        </li>
        {{/each}}
      </ul>
    </div>
    {{else}}
    <div class="field-group attack-charm-picker">
      <label>{{localize "EX2E.SocialAttackCharmsLabel"}}</label>
      <p class="charm-empty">{{localize "EX2E.SocialAttackCharmsEmpty"}}</p>
    </div>
    {{/if}}

    {{!-- 3c-1: Excellency block --}}
    <div class="field-group excellency-section exc-first-section">
      <label>{{localize "EX2E.FirstExcellency"}} <span class="exc-cost-tag">1m/{{localize "EX2E.Die"}}</span></label>
      <div class="exc-input-row">
        <input type="number" name="firstExcDice" value="{{firstExcDice}}" min="0" max="{{firstExcMax}}" class="exc-input" />
        <span class="exc-limit">/ <span class="exc-first-max">{{firstExcMax}}</span></span>
      </div>
    </div>

    <div class="field-group excellency-section exc-second-section">
      <label>{{localize "EX2E.SecondExcellency"}} <span class="exc-cost-tag">2m/{{localize "EX2E.Success"}}</span></label>
      <div class="exc-input-row">
        <input type="number" name="secondExcSucc" value="{{secondExcSucc}}" min="0" max="{{secondExcMax}}" class="exc-input" />
        <span class="exc-limit">/ <span class="exc-second-max">{{secondExcMax}}</span></span>
      </div>
    </div>

    <div class="field-group">
      <label>{{localize "EX2E.MoteType"}}</label>
      <select name="moteType">
        <option value="personal"   {{#if (eq moteType "personal")}}selected{{/if}}>{{lookup moteTypeChoices "personal"}}</option>
        <option value="peripheral" {{#if (eq moteType "peripheral")}}selected{{/if}}>{{lookup moteTypeChoices "peripheral"}}</option>
      </select>
    </div>

    <div class="field-group exc-total-row">
      <span class="exc-total-label">{{localize "EX2E.TotalMoteCost"}}</span>
      <span class="exc-total-cost">0</span>m
    </div>

  </div>

  <footer class="form-footer">
    <button type="button" class="btn-roll" data-action="confirmSocialAttack">
      <i class="fa-solid fa-comments"></i> {{localize "EX2E.RollSocialAttack"}}
    </button>
  </footer>
</form>
