<form class="ex2e-roll-dialog finish-turn-dialog" autocomplete="off">
  <div class="dialog-content">

    <p class="finish-turn-header">
      {{#if combatantName}}<strong>{{combatantName}}</strong> — {{/if}}
      {{localize "EX2E.CurrentTick"}}: {{currentTick}}
    </p>

    <div class="field-group">
      <label>{{localize "EX2E.ActionSpeed"}}</label>
      <input type="number" name="speed" value="{{defaultSpeed}}" min="0" max="20" autofocus>
    </div>

    <div class="finish-turn-presets">
      {{#each presets as |p|}}
      <button type="button" class="btn-preset" data-action="preset" data-speed="{{p.speed}}">
        {{localize p.labelKey}} ({{p.speed}})
      </button>
      {{/each}}
    </div>

  </div>
  <footer class="form-footer">
    <button type="button" class="btn-roll" data-action="cancel">
      <i class="fa-solid fa-xmark"></i> {{localize "EX2E.Cancel"}}
    </button>
    <button type="button" class="btn-roll" data-action="confirm">
      <i class="fa-solid fa-forward-step"></i> {{localize "EX2E.FinishTurn"}}
    </button>
  </footer>
</form>
