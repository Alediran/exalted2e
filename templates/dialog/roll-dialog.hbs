<form class="ex2e-roll-dialog" autocomplete="off">
  <div class="dialog-content">

    {{!-- Hidden pool so it is always submitted even without a visible input --}}
    <input type="hidden" name="pool" value="{{pool}}">

    {{#if attributeChoices.length}}
    <div class="field-group">
      <label>{{localize "EX2E.Attribute"}}</label>
      <select name="attribute">
        {{#each attributeChoices as |choice|}}
        <option value="{{choice.value}}" {{#if (eq choice.value ../attribute)}}selected{{/if}}>{{choice.label}}</option>
        {{/each}}
      </select>
    </div>
    {{/if}}

    {{#if specialties.length}}
    <div class="field-group">
      <label>{{localize "EX2E.Specialty"}}</label>
      <select name="specialty">
        <option value="">{{localize "EX2E.NoSpecialty"}}</option>
        {{#each specialties as |spec|}}
        <option value="{{@index}}">{{spec.name}} (+{{spec.value}} {{#if (gt spec.value 1)}}{{localize "EX2E.Dice"}}{{else}}{{localize "EX2E.Die"}}{{/if}})</option>
        {{/each}}
      </select>
    </div>
    {{/if}}

    <div class="field-group">
      <label>{{localize "EX2E.Flavor"}}</label>
      <input type="text" name="flavor" value="{{flavor}}" placeholder="{{localize 'EX2E.RollDescriptionPlaceholder'}}">
    </div>

    <div class="field-group">
      <label>{{localize "EX2E.StuntBonus"}}</label>
      <select name="stunt">
        {{#each stuntChoices as |label value|}}
        <option value="{{@key}}" {{#if (eq @key ../stunt)}}selected{{/if}}>{{this}}</option>
        {{/each}}
      </select>
    </div>

    <div class="field-group stunt-motivation-row" style="display:none">
      <label>
        <input type="checkbox" name="stuntAdvancesMotivation" {{#if advancesMotivation}}checked{{/if}}>
        {{localize "EX2E.StuntAdvancesMotivation"}}
      </label>
    </div>

    <div class="field-group stunt-reward-pref-row" style="display:none">
      <label>{{localize "EX2E.StuntRewardPreference"}}</label>
      <div class="stunt-reward-radio">
        <label><input type="radio" name="stuntRewardKind" value="motes"     {{#if (eq rewardKind "motes")}}checked{{/if}}> {{localize "EX2E.StuntRewardMotes"}}</label>
        <label><input type="radio" name="stuntRewardKind" value="willpower" {{#if (eq rewardKind "willpower")}}checked{{/if}}> {{localize "EX2E.StuntRewardWillpower"}}</label>
      </div>
    </div>

    {{!-- ── Excellency sections (shown only when the actor owns the charm) ── --}}

    {{#if excellency.first}}
    <div class="field-group excellency-section exc-first-section">
      <label>{{localize "EX2E.FirstExcellency"}} <span class="exc-cost-tag">1m/{{localize "EX2E.Die"}}</span></label>
      <div class="exc-pip-track" data-exc="first" data-max="{{firstExcMax}}">
        <input type="hidden" name="firstExcDice" value="0">
      </div>
    </div>
    {{/if}}

    {{#if excellency.second}}
    <div class="field-group excellency-section exc-second-section">
      <label>{{localize "EX2E.SecondExcellency"}} <span class="exc-cost-tag">2m/{{localize "EX2E.Success"}}</span></label>
      <div class="exc-pip-track" data-exc="second" data-max="{{secondExcMax}}">
        <input type="hidden" name="secondExcSucc" value="0">
      </div>
    </div>
    {{/if}}

    {{#if excellency.third}}
    <div class="field-group excellency-section exc-third-section">
      <label>{{localize "EX2E.ThirdExcellency"}} <span class="exc-cost-tag">4m</span></label>
      <label class="exc-checkbox-label">
        <input type="checkbox" name="useThirdExc"> {{localize "EX2E.RerollFailures"}}
      </label>
    </div>
    {{/if}}

    {{#if virtueChoices.length}}
    <div class="field-group virtue-channel-section">
      <label>{{localize "EX2E.VirtueChannelMode"}}</label>
      <div class="virtue-channel-radio">
        <label><input type="radio" name="virtueChannelMode" value="none" checked> {{localize "EX2E.VirtueChannelNone"}}</label>
        <label><input type="radio" name="virtueChannelMode" value="success"> {{localize "EX2E.VirtueChannelSuccess"}}</label>
        <label><input type="radio" name="virtueChannelMode" value="dice"> {{localize "EX2E.VirtueChannelDice"}}</label>
      </div>
    </div>
    <div class="field-group virtue-select-row" style="display:none">
      <label>{{localize "EX2E.VirtueChannelSelect"}}</label>
      <select name="virtueChannel">
        <option value="">—</option>
        {{#each virtueChoices as |v|}}
        <option value="{{v.key}}">{{v.label}} ({{v.current}}/{{v.rating}})</option>
        {{/each}}
      </select>
    </div>
    {{/if}}

    {{#if clarityInfo}}
    <div class="field-group clarity-autochthon-reminder">
      <span>+{{clarityInfo.autochthonBonus}} {{localize "EX2E.ClarityAutochthonBonus"}}</span>
    </div>
    {{/if}}

    {{!-- ── Mental Influence effects (Emotion / Compulsion / Servitude AEs) ── --}}
    {{#if mentalInfluenceEffects.length}}
    <div class="field-group mental-influence-section">
      <label>{{localize "EX2E.MentalInfluenceSection"}}</label>
      {{#each mentalInfluenceEffects}}
      <label class="mental-influence-row">
        <input type="checkbox" name="mi-{{this.keyword}}-{{this.id}}">
        <span class="mi-charm-name">{{this.charmName}}</span>
        {{#if (eq this.keyword "Emotion")}}
        <span class="mi-note">{{localize "EX2E.EmotionActingContrary"}}
          ({{localize "EX2E.MentalInfluenceDicePenalty" penalty=this.penaltyMinor}})</span>
        {{else if (eq this.keyword "Compel")}}
        <span class="mi-note">{{localize "EX2E.CompulsionResisting"}}
          ({{localize "EX2E.MentalInfluenceWpNote" wpCost=this.wpCostPerResist}})</span>
        {{else}}
        <span class="mi-note" data-tooltip="{{localize 'EX2E.ServitudeGmRemovalNote'}}">{{localize "EX2E.ServitudeResisting"}}
          ({{localize "EX2E.MentalInfluenceWpNote" wpCost=this.wpCostPerResist}})</span>
        {{/if}}
      </label>
      {{/each}}
    </div>
    {{/if}}

    <div class="field-group">
      <label>{{localize "EX2E.MoteType"}}</label>
      <select name="moteType">
        {{#each moteTypeChoices as |label value|}}
        <option value="{{@key}}" {{#if (eq @key ../moteType)}}selected{{/if}}>{{this}}</option>
        {{/each}}
      </select>
    </div>

    <div class="field-group exc-total-row">
      <span class="exc-total-label">{{localize "EX2E.TotalMoteCost"}}</span>
      <span class="exc-total-cost">{{moteCost}} </span>
    </div>

  </div>
  <footer class="form-footer">
    <button type="button" class="btn-roll" data-action="confirmRoll">
      <i class="fa-solid fa-dice"></i> {{localize "EX2E.Roll"}}
    </button>
  </footer>
</form>
