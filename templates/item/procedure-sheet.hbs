<div class="sheet-body">
  <div class="form-group">
    <label>{{localize "EX2E.ThaummArt"}}</label>
    <input type="text" name="system.art" value="{{system.art}}"
           {{#unless isEditable}}disabled{{/unless}}>
  </div>
  <div class="form-group">
    <label>{{localize "EX2E.ThaummMinDegree"}}</label>
    <select name="system.minDegree" {{#unless isEditable}}disabled{{/unless}}>
      <option value="1" {{#if (eq system.minDegree 1)}}selected{{/if}}>1</option>
      <option value="2" {{#if (eq system.minDegree 2)}}selected{{/if}}>2</option>
      <option value="3" {{#if (eq system.minDegree 3)}}selected{{/if}}>3</option>
    </select>
  </div>
  <div class="form-group">
    <label>{{localize "EX2E.Attribute"}}</label>
    <select name="system.attribute" {{#unless isEditable}}disabled{{/unless}}>
      {{#each attributeOptions as |opt|}}
      <option value="{{opt.key}}" {{#if (eq ../system.attribute opt.key)}}selected{{/if}}>{{opt.label}}</option>
      {{/each}}
    </select>
  </div>
  <div class="form-group">
    <label>{{localize "EX2E.ThaummDifficulty"}}</label>
    <input type="number" name="system.difficulty" value="{{system.difficulty}}" min="1"
           {{#unless isEditable}}disabled{{/unless}}>
  </div>
  <div class="form-group">
    <label>{{localize "EX2E.ThaummCastingTime"}}</label>
    <input type="text" name="system.castingTime" value="{{system.castingTime}}"
           {{#unless isEditable}}disabled{{/unless}}>
  </div>
  <div class="form-group">
    <label>{{localize "EX2E.ThaummExtended"}}</label>
    <input type="checkbox" name="system.extended" {{#if system.extended}}checked{{/if}}
           {{#unless isEditable}}disabled{{/unless}}>
  </div>
  <div class="form-group stacked">
    <label>{{localize "ITEM.DescriptionLabel"}}</label>
    {{#if isEditable}}
    <prose-mirror name="system.description" data-document-uuid="{{item.uuid}}"
                  value="{{system.description}}" collaborate="true" toggled="true">
      {{{enrichedDescription}}}
    </prose-mirror>
    {{else}}
    <div class="editor-content">{{{enrichedDescription}}}</div>
    {{/if}}
  </div>
</div>
