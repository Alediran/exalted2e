<div class="item-header charm-header">
  <img class="item-portrait" src="{{item.img}}" alt="{{item.name}}"
       data-action="editImage" {{#unless isEditable}}disabled{{/unless}}>
  <div class="item-header-fields">
    <input class="item-name-input" type="text" name="name" value="{{item.name}}"
           {{#unless isEditable}}readonly{{/unless}}>
    <div class="charm-identity-row">
      <!-- Exalt Type -->
      <div class="field-group">
        <label>{{localize "EX2E.ExaltType"}}</label>
        <select name="system.exaltType" {{#unless isEditable}}disabled{{/unless}}>
          {{#each exaltTypes}}
          <option value="{{this.value}}" {{#if (eq this.value ../system.exaltType)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </div>
      <!-- Ability / Attribute (swaps based on the charm's exaltType) -->
      <div class="field-group">
        <label>{{abilityFieldLabel}}</label>
        <select name="system.ability" {{#unless isEditable}}disabled{{/unless}}>
          {{#each abilities}}
          <option value="{{this.value}}" {{#if (eq this.value ../system.ability)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </div>
    </div>
    <!-- Cost Summary -->
    <div class="charm-cost-summary">
      <strong>Cost:</strong>
      {{system.cost.motes}}m
      {{#if system.cost.willpower}} +{{system.cost.willpower}}wp{{/if}}
      {{#if system.cost.bashingHealth}} +{{system.cost.bashingHealth}}hl(B){{/if}}
      {{#if system.cost.lethalHealth}} +{{system.cost.lethalHealth}}hl(L){{/if}}
      {{#if system.cost.aggravatedHealth}} +{{system.cost.aggravatedHealth}}hl(A){{/if}}
      {{#if system.cost.xp}} +{{system.cost.xp}}xp{{/if}}
      &nbsp;·&nbsp; <strong>Type:</strong> {{system.charmType}}
      &nbsp;·&nbsp; <strong>Duration:</strong> {{system.duration}}
    </div>
  </div>
</div>
