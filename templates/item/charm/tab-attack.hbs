<div class="tab {{cssClass}} sheet-body charm-attack-body" data-tab="tabAttack" data-group="sheet">

  <label class="attack-enable-row">
    <input type="checkbox" name="system.attack.enabled" {{#if system.attack.enabled}}checked{{/if}}
           {{#unless isEditable}}disabled{{/unless}}>
    <span>{{localize "EX2E.CharmAttackEnable"}}</span>
  </label>

  <p class="attack-help">
    {{localize "EX2E.CharmAttackHelp"}}
  </p>

  {{#if system.attack.enabled}}
  <div class="charm-attack-stats">
    <div class="field-group">
      <label>{{localize "EX2E.CharmAttackWeaponName"}}</label>
      <input type="text" name="system.attack.name" value="{{system.attack.name}}"
             placeholder="{{item.name}}" {{#unless isEditable}}readonly{{/unless}}>
    </div>

    {{!-- Each stat field accepts a plain number or a formula (e.g.
         "@str + @essence / 2"). The fx button opens the Formula
         Builder dialog, which writes its result back to the same input. --}}
    <div class="charm-attack-grid">
      <div class="field-group">
        <label>{{localize "EX2E.Speed"}}</label>
        <div class="formula-field-row">
          <input type="text" name="system.attack.speed" value="{{system.attack.speed}}"
                 {{#unless isEditable}}readonly{{/unless}}>
          {{#if isEditable}}
          <button type="button" class="btn-fx" data-action="openFormula"
                  data-path="system.attack.speed" data-label="{{localize 'EX2E.Speed'}}"
                  data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
            <i class="fa-solid fa-function"></i>
          </button>
          {{/if}}
        </div>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.Accuracy"}}</label>
        <div class="formula-field-row">
          <input type="text" name="system.attack.accuracy" value="{{system.attack.accuracy}}"
                 {{#unless isEditable}}readonly{{/unless}}>
          {{#if isEditable}}
          <button type="button" class="btn-fx" data-action="openFormula"
                  data-path="system.attack.accuracy" data-label="{{localize 'EX2E.Accuracy'}}"
                  data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
            <i class="fa-solid fa-function"></i>
          </button>
          {{/if}}
        </div>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.Damage"}}</label>
        <div class="formula-field-row">
          <input type="text" name="system.attack.damage" value="{{system.attack.damage}}"
                 {{#unless isEditable}}readonly{{/unless}}>
          {{#if isEditable}}
          <button type="button" class="btn-fx" data-action="openFormula"
                  data-path="system.attack.damage" data-label="{{localize 'EX2E.Damage'}}"
                  data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
            <i class="fa-solid fa-function"></i>
          </button>
          {{/if}}
        </div>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.DamageType"}}</label>
        <select name="system.attack.damageType" {{#unless isEditable}}disabled{{/unless}}>
          {{#each damageTypes}}
          <option value="{{this.value}}" {{#if (eq this.value ../system.attack.damageType)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.Overwhelming"}}</label>
        <div class="formula-field-row">
          <input type="text" name="system.attack.overwhelming" value="{{system.attack.overwhelming}}"
                 {{#unless isEditable}}readonly{{/unless}}>
          {{#if isEditable}}
          <button type="button" class="btn-fx" data-action="openFormula"
                  data-path="system.attack.overwhelming" data-label="{{localize 'EX2E.Overwhelming'}}"
                  data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
            <i class="fa-solid fa-function"></i>
          </button>
          {{/if}}
        </div>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.Defense"}}</label>
        <div class="formula-field-row">
          <input type="text" name="system.attack.defense" value="{{system.attack.defense}}"
                 {{#unless isEditable}}readonly{{/unless}}>
          {{#if isEditable}}
          <button type="button" class="btn-fx" data-action="openFormula"
                  data-path="system.attack.defense" data-label="{{localize 'EX2E.Defense'}}"
                  data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
            <i class="fa-solid fa-function"></i>
          </button>
          {{/if}}
        </div>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.Rate"}}</label>
        <div class="formula-field-row">
          <input type="text" name="system.attack.rate" value="{{system.attack.rate}}"
                 {{#unless isEditable}}readonly{{/unless}}>
          {{#if isEditable}}
          <button type="button" class="btn-fx" data-action="openFormula"
                  data-path="system.attack.rate" data-label="{{localize 'EX2E.Rate'}}"
                  data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
            <i class="fa-solid fa-function"></i>
          </button>
          {{/if}}
        </div>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.Range"}}</label>
        <div class="formula-field-row">
          <input type="text" name="system.attack.range" value="{{system.attack.range}}"
                 {{#unless isEditable}}readonly{{/unless}}>
          {{#if isEditable}}
          <button type="button" class="btn-fx" data-action="openFormula"
                  data-path="system.attack.range" data-label="{{localize 'EX2E.Range'}}"
                  data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
            <i class="fa-solid fa-function"></i>
          </button>
          {{/if}}
        </div>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.MinStrength"}}</label>
        <div class="formula-field-row">
          <input type="text" name="system.attack.minStrength" value="{{system.attack.minStrength}}"
                 {{#unless isEditable}}readonly{{/unless}}>
          {{#if isEditable}}
          <button type="button" class="btn-fx" data-action="openFormula"
                  data-path="system.attack.minStrength" data-label="{{localize 'EX2E.MinStrength'}}"
                  data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
            <i class="fa-solid fa-function"></i>
          </button>
          {{/if}}
        </div>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.MinDexterity"}}</label>
        <div class="formula-field-row">
          <input type="text" name="system.attack.minDexterity" value="{{system.attack.minDexterity}}"
                 {{#unless isEditable}}readonly{{/unless}}>
          {{#if isEditable}}
          <button type="button" class="btn-fx" data-action="openFormula"
                  data-path="system.attack.minDexterity" data-label="{{localize 'EX2E.MinDexterity'}}"
                  data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
            <i class="fa-solid fa-function"></i>
          </button>
          {{/if}}
        </div>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.MinMartialArts"}}</label>
        <div class="formula-field-row">
          <input type="text" name="system.attack.minMartialArts" value="{{system.attack.minMartialArts}}"
                 {{#unless isEditable}}readonly{{/unless}}>
          {{#if isEditable}}
          <button type="button" class="btn-fx" data-action="openFormula"
                  data-path="system.attack.minMartialArts" data-label="{{localize 'EX2E.MinMartialArts'}}"
                  data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
            <i class="fa-solid fa-function"></i>
          </button>
          {{/if}}
        </div>
      </div>
    </div>

    <div class="charm-attack-tags tags-block" style="margin-top:10px">
      <div class="tags-header">
        <label>{{localize "EX2E.Tags"}}</label>
        {{#if isEditable}}
        <button data-action="addAttackTag"><i class="fa-solid fa-plus"></i></button>
        {{/if}}
      </div>
      <div class="tags-list">
        {{#each system.attack.tags as |tg idx|}}
        <span class="keyword-tag-edit">
          <select name="system.attack.tags.{{idx}}" {{#unless @root.isEditable}}disabled{{/unless}}>
            {{#each @root.weaponTags as |opt|}}
            <option value="{{opt}}" {{#if (eq opt tg)}}selected{{/if}}>{{opt}}</option>
            {{/each}}
          </select>
          {{#if @root.isEditable}}
          <button data-action="removeAttackTag" data-index="{{idx}}">✕</button>
          {{/if}}
        </span>
        {{/each}}
      </div>
    </div>
  </div>
  {{/if}}
</div>
