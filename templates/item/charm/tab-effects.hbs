                <select name="system.upgradeTiers.{{../i}}.dvBonus.ignorePenaltyTypes.{{j}}"
                        {{#unless @root.isEditable}}disabled{{/unless}}>
                  {{#each @root.dvPenaltyTypeChoices as |choice|}}
