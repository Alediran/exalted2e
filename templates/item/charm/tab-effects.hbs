            </div>
            <div class="field-group" style="grid-column:1/-1">
              <label>{{localize "EX2E.MRFormula"}}</label>
              <div class="formula-field-row">
                <input type="text" name="system.upgradeTiers.{{i}}.moteRecovery.formula"
                       value="{{tier.moteRecovery.formula}}"
                       {{#unless @root.isEditable}}readonly{{/unless}}>
                {{#if @root.isEditable}}
                <button type="button" class="btn-fx" data-action="openFormula"
                        data-path="system.upgradeTiers.{{i}}.moteRecovery.formula"
                        data-label="{{localize 'EX2E.MRFormula'}}"
                        data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
                  <i class="fa-solid fa-function"></i>
                </button>
                {{/if}}
              </div>
            </div>
            <div class="field-group" style="grid-column:1/-1">
              <label>{{localize "EX2E.MRSource"}}</label>
              <div class="radio-group">
                {{#each @root.moteRecoverySources as |src|}}
                <label class="radio-label">
                  <input type="radio" name="system.upgradeTiers.{{i}}.moteRecovery.source"
                         value="{{src.value}}"
                         {{#if (eq src.value tier.moteRecovery.source)}}checked{{/if}}
                         {{#unless @root.isEditable}}disabled{{/unless}}>
                  {{src.label}}
                </label>
                {{/each}}
              </div>
            </div>
          </div>
          {{/if}}
        </div>

        {{!-- Soak Bonus --}}
        <div class="effect-section">
          <label class="effect-enable-row">
            <input type="checkbox" name="system.upgradeTiers.{{i}}.soakBonus.enabled"
                   {{#if tier.soakBonus.enabled}}checked{{/if}}
                   {{#unless @root.isEditable}}disabled{{/unless}}>
            <span>{{localize "EX2E.EffectSoakBonus"}}</span>
          </label>
          {{#if tier.soakBonus.enabled}}
          <div class="effect-body effect-grid-2">
            <div class="field-group">
              <label>{{localize "EX2E.SBABashing"}}</label>
              <input type="number" name="system.upgradeTiers.{{i}}.soakBonus.bashing"
                     value="{{tier.soakBonus.bashing}}"
                     min="0" {{#unless @root.isEditable}}readonly{{/unless}}>
            </div>
            <div class="field-group">
              <label>{{localize "EX2E.SBALethal"}}</label>
              <input type="number" name="system.upgradeTiers.{{i}}.soakBonus.lethal"
                     value="{{tier.soakBonus.lethal}}"
                     min="0" {{#unless @root.isEditable}}readonly{{/unless}}>
            </div>
            <div class="field-group">
              <label>{{localize "EX2E.SBAAggravated"}}</label>
              <input type="number" name="system.upgradeTiers.{{i}}.soakBonus.aggravated"
                     value="{{tier.soakBonus.aggravated}}"
                     min="0" {{#unless @root.isEditable}}readonly{{/unless}}>
            </div>
            <div class="field-group">
              <label>{{localize "EX2E.SBHardnessAdd"}}</label>
              <input type="number" name="system.upgradeTiers.{{i}}.soakBonus.hardnessAdd"
                     value="{{tier.soakBonus.hardnessAdd}}"
                     min="0" {{#unless @root.isEditable}}readonly{{/unless}}>
            </div>
            <div class="field-group">
              <label>{{localize "EX2E.SBHardnessSetTo"}}</label>
              <input type="number" name="system.upgradeTiers.{{i}}.soakBonus.hardnessSetTo"
                     value="{{tier.soakBonus.hardnessSetTo}}"
                     min="0" {{#unless @root.isEditable}}readonly{{/unless}}>
            </div>
            <div class="field-group">
              <label>{{localize "EX2E.SBABashingFormula"}}</label>
              <div class="formula-field-row">
                <input type="text" name="system.upgradeTiers.{{i}}.soakBonus.bashingFormula"
                       value="{{tier.soakBonus.bashingFormula}}"
                       placeholder="e.g. @sta"
                       {{#unless @root.isEditable}}readonly{{/unless}}>
                {{#if @root.isEditable}}
                <button type="button" class="btn-fx" data-action="openFormula"
                        data-path="system.upgradeTiers.{{i}}.soakBonus.bashingFormula"
                        data-label="{{localize 'EX2E.SBABashingFormula'}}"
                        data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
                  <i class="fa-solid fa-function"></i>
                </button>
                {{/if}}
              </div>
            </div>
            <div class="field-group">
              <label>{{localize "EX2E.SBALethalFormula"}}</label>
              <div class="formula-field-row">
                <input type="text" name="system.upgradeTiers.{{i}}.soakBonus.lethalFormula"
                       value="{{tier.soakBonus.lethalFormula}}"
                       placeholder="e.g. @sta"
                       {{#unless @root.isEditable}}readonly{{/unless}}>
                {{#if @root.isEditable}}
                <button type="button" class="btn-fx" data-action="openFormula"
                        data-path="system.upgradeTiers.{{i}}.soakBonus.lethalFormula"
                        data-label="{{localize 'EX2E.SBALethalFormula'}}"
                        data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
                  <i class="fa-solid fa-function"></i>
                </button>
                {{/if}}
              </div>
            </div>
            <div class="field-group">
              <label>{{localize "EX2E.SBAAggravatedFormula"}}</label>
              <div class="formula-field-row">
                <input type="text" name="system.upgradeTiers.{{i}}.soakBonus.aggravatedFormula"
                       value="{{tier.soakBonus.aggravatedFormula}}"
                       placeholder="e.g. @sta"
                       {{#unless @root.isEditable}}readonly{{/unless}}>
                {{#if @root.isEditable}}
                <button type="button" class="btn-fx" data-action="openFormula"
                        data-path="system.upgradeTiers.{{i}}.soakBonus.aggravatedFormula"
                        data-label="{{localize 'EX2E.SBAAggravatedFormula'}}"
                        data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
                  <i class="fa-solid fa-function"></i>
                </button>
                {{/if}}
              </div>
            </div>
          </div>
          {{/if}}
        </div>

        {{!-- Stat Boost --}}
        <div class="effect-section">
          <label class="effect-enable-row">
            <input type="checkbox" name="system.upgradeTiers.{{i}}.statBoost.enabled"
                   {{#if tier.statBoost.enabled}}checked{{/if}}
                   {{#unless @root.isEditable}}disabled{{/unless}}>
            <span>{{localize "EX2E.EffectStatBoost"}}</span>
          </label>
          {{#if tier.statBoost.enabled}}
          <div class="effect-body">
            {{#if tier.statBoost.changes}}
            <div class="sb-change-header">
              <span>{{localize "EX2E.StatBoostPath"}}</span>
              <span>{{localize "EX2E.StatBoostValue"}}</span>
            </div>
            {{/if}}
            {{#each tier.statBoost.changes as |ch j|}}
            <div class="sb-change-row">
              <select name="system.upgradeTiers.{{../i}}.statBoost.changes.{{j}}.path" {{#unless @root.isEditable}}disabled{{/unless}}>
                <option value="">—</option>
                {{#each @root.statBoostPaths as |sp|}}
                <option value="{{sp.value}}" {{#if (eq sp.value ch.path)}}selected{{/if}}>{{sp.label}}</option>
                {{/each}}
              </select>
              <input type="text" name="system.upgradeTiers.{{../i}}.statBoost.changes.{{j}}.value"
                     value="{{ch.value}}" style="width:4em"
                     {{#unless @root.isEditable}}readonly{{/unless}}>
              {{#if @root.isEditable}}
              <button type="button" class="btn-remove" data-action="removeTierStatBoostChange"
                      data-tier-index="{{../i}}" data-index="{{j}}"><i class="fa-solid fa-times"></i></button>
              {{/if}}
            </div>
            {{/each}}
            {{#if @root.isEditable}}
            <button type="button" class="btn-add-row" data-action="addTierStatBoostChange"
                    data-tier-index="{{i}}">
              {{localize "EX2E.StatBoostAdd"}}
            </button>
            {{/if}}
          </div>
          {{/if}}
        </div>

        {{!-- Health Grant --}}
        <div class="effect-section">
          <label class="effect-enable-row">
            <input type="checkbox" name="system.upgradeTiers.{{i}}.healthGrant.enabled"
                   {{#if tier.healthGrant.enabled}}checked{{/if}}
                   {{#unless @root.isEditable}}disabled{{/unless}}>
            <span>{{localize "EX2E.EffectHealthGrant"}}</span>
          </label>
          {{#if tier.healthGrant.enabled}}
          <div class="effect-body">
            <p class="effect-section-label">{{localize "EX2E.HGOptions"}}</p>
            {{#each tier.healthGrant.options as |opt j|}}
            <div class="hg-option-row">
              <input type="text" name="system.upgradeTiers.{{../i}}.healthGrant.options.{{j}}.label"
                     value="{{opt.label}}" placeholder="{{localize 'EX2E.HGOptionLabel'}}"
                     {{#unless @root.isEditable}}readonly{{/unless}}>
              <label>{{localize "EX2E.HGZero"}}</label>
              <input type="number" name="system.upgradeTiers.{{../i}}.healthGrant.options.{{j}}.zero"
                     value="{{opt.zero}}" min="0" {{#unless @root.isEditable}}readonly{{/unless}}>
              <label>{{localize "EX2E.HGOne"}}</label>
              <input type="number" name="system.upgradeTiers.{{../i}}.healthGrant.options.{{j}}.one"
                     value="{{opt.one}}" min="0" {{#unless @root.isEditable}}readonly{{/unless}}>
              <label>{{localize "EX2E.HGTwo"}}</label>
              <input type="number" name="system.upgradeTiers.{{../i}}.healthGrant.options.{{j}}.two"
                     value="{{opt.two}}" min="0" {{#unless @root.isEditable}}readonly{{/unless}}>
              {{#if @root.isEditable}}
              <button type="button" class="btn-remove" data-action="removeTierHealthGrantOption"
                      data-tier-index="{{../i}}" data-index="{{j}}"><i class="fa-solid fa-times"></i></button>
              {{/if}}
            </div>
            {{/each}}
            {{#if @root.isEditable}}
            <button type="button" class="btn-add-row" data-action="addTierHealthGrantOption"
                    data-tier-index="{{i}}">
              {{localize "EX2E.HGAddOption"}}
            </button>
            {{/if}}
          </div>
          {{/if}}
        </div>

        {{!-- Rate Bonus --}}
        <div class="effect-section">
          <label class="effect-enable-row">
            <input type="checkbox" name="system.upgradeTiers.{{i}}.rateBonus.enabled"
                   {{#if tier.rateBonus.enabled}}checked{{/if}}
                   {{#unless @root.isEditable}}disabled{{/unless}}>
            <span>{{localize "EX2E.EffectRateBonus"}}</span>
          </label>
          {{#if tier.rateBonus.enabled}}
          <div class="effect-body effect-grid-2">
            <div class="field-group">
              <label>{{localize "EX2E.RateBonusFormula"}}</label>
              <div class="formula-field-row">
                <input type="text" name="system.upgradeTiers.{{i}}.rateBonus.formula"
                       value="{{tier.rateBonus.formula}}"
                       placeholder="e.g. 1"
                       {{#unless @root.isEditable}}readonly{{/unless}}>
                {{#if @root.isEditable}}
                <button type="button" class="btn-fx" data-action="openFormula"
                        data-path="system.upgradeTiers.{{i}}.rateBonus.formula"
                        data-label="{{localize 'EX2E.RateBonusFormula'}}"
                        data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
                  <i class="fa-solid fa-function"></i>
                </button>
                {{/if}}
              </div>
            </div>
          </div>
          {{/if}}
        </div>

        {{!-- Speed Modifier --}}
        <div class="effect-section">
          <label class="effect-enable-row">
            <input type="checkbox" name="system.upgradeTiers.{{i}}.speedModifier.enabled"
                   {{#if tier.speedModifier.enabled}}checked{{/if}}
                   {{#unless @root.isEditable}}disabled{{/unless}}>
            <span>{{localize "EX2E.EffectSpeedModifier"}}</span>
          </label>
          {{#if tier.speedModifier.enabled}}
          <div class="effect-body effect-grid-2">
            <div class="field-group">
              <label>{{localize "EX2E.SMDelta"}}</label>
              <input type="number" name="system.upgradeTiers.{{i}}.speedModifier.delta"
                     value="{{tier.speedModifier.delta}}"
                     {{#unless @root.isEditable}}readonly{{/unless}}>
            </div>
            <div class="field-group">
              <label>{{localize "EX2E.SMDeltaFormula"}}</label>
              <div class="formula-field-row">
                <input type="text" name="system.upgradeTiers.{{i}}.speedModifier.deltaFormula"
                       value="{{tier.speedModifier.deltaFormula}}"
                       placeholder="e.g. -@dex"
                       {{#unless @root.isEditable}}readonly{{/unless}}>
                {{#if @root.isEditable}}
                <button type="button" class="btn-fx" data-action="openFormula"
                        data-path="system.upgradeTiers.{{i}}.speedModifier.deltaFormula"
                        data-label="{{localize 'EX2E.SMDeltaFormula'}}"
                        data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
                  <i class="fa-solid fa-function"></i>
                </button>
                {{/if}}
              </div>
            </div>
            <div class="field-group">
              <label>{{localize "EX2E.SMMinimum"}}</label>
              <input type="number" name="system.upgradeTiers.{{i}}.speedModifier.minimum"
                     value="{{tier.speedModifier.minimum}}" min="1"
                     {{#unless @root.isEditable}}readonly{{/unless}}>
            </div>
          </div>
          {{/if}}
        </div>

      </div>
    </div>
    {{/each}}
  </div>

</div>
