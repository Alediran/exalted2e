                   {{#if tier.targetPenalty.enabled}}checked{{/if}}
                   {{#unless @root.isEditable}}disabled{{/unless}}>
            <span>{{localize "EX2E.EffectTargetPenalty"}}</span>
          </label>
          {{#if tier.targetPenalty.enabled}}
          <div class="effect-body effect-grid-2">
            <div class="field-group">
              <label>{{localize "EX2E.TPAmount"}}</label>
              <input type="number" name="system.upgradeTiers.{{i}}.targetPenalty.amount"
                     value="{{tier.targetPenalty.amount}}" max="0"
                     {{#unless @root.isEditable}}readonly{{/unless}}>
            </div>
            <div class="field-group">
              <label>{{localize "EX2E.TPAmountFormula"}}</label>
              <div class="formula-field-row">
