<div class="tab {{cssClass}} sheet-body charm-effects-body" data-tab="tabEffects" data-group="sheet">

  {{!-- ── COUNTERMAGIC ──────────────────────────────────────────────────────── --}}
  <div class="effect-section">
    <label class="effect-enable-row">
      <input type="checkbox" name="system.isCountermagic"
             {{#if system.isCountermagic}}checked{{/if}}
             {{#unless isEditable}}disabled{{/unless}}>
      <span>{{localize "EX2E.IsCountermagic"}}</span>
    </label>
    {{#if system.isCountermagic}}
    <div class="effect-body effect-grid-2">
      <div class="field-group">
        <label>{{localize "EX2E.CountermagicTier"}}</label>
        <select name="system.countermagicTier" {{#unless isEditable}}disabled{{/unless}}>
          <option value="1" {{#if (eq system.countermagicTier 1)}}selected{{/if}}>1 — {{localize "EX2E.CountermagicTierEmerald"}}</option>
          <option value="2" {{#if (eq system.countermagicTier 2)}}selected{{/if}}>2 — {{localize "EX2E.CountermagicTierSapphire"}}</option>
          <option value="3" {{#if (eq system.countermagicTier 3)}}selected{{/if}}>3 — {{localize "EX2E.CountermagicTierAdamant"}}</option>
        </select>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.CountermagicTradition"}}</label>
        <select name="system.countermagicTradition" {{#unless isEditable}}disabled{{/unless}}>
          <option value="sorcery"    {{#if (eq system.countermagicTradition "sorcery")}}selected{{/if}}>{{localize "EX2E.TraditionSorcery"}}</option>
          <option value="necromancy" {{#if (eq system.countermagicTradition "necromancy")}}selected{{/if}}>{{localize "EX2E.TraditionNecromancy"}}</option>
          <option value="both"       {{#if (eq system.countermagicTradition "both")}}selected{{/if}}>{{localize "EX2E.CountermagicBoth"}}</option>
        </select>
      </div>
      {{#if isEditable}}
      <div class="field-group" style="grid-column:1/-1">
        <button type="button" data-action="dispelOther" class="btn-dispel-other">
          <i class="fa-solid fa-wand-sparkles"></i> {{localize "EX2E.CountermagicDispelOther"}}
        </button>
      </div>
      {{/if}}
    </div>
    {{/if}}
  </div>

  {{!-- ── OFFENSIVE ─────────────────────────────────────────────────────────── --}}
  <h4 class="effects-group-header">{{localize "EX2E.EffectGroupOffensive"}}</h4>

  {{!-- M0 Weapon-Like Attack ──────────────────────────────────────────────── --}}
  <div class="effect-section">
    <label class="effect-enable-row">
      <input type="checkbox" name="system.attack.enabled" {{#if system.attack.enabled}}checked{{/if}}
             {{#unless isEditable}}disabled{{/unless}}>
      <span>{{localize "EX2E.CharmAttackEnable"}}</span>
    </label>
    {{#if system.attack.enabled}}
    <div class="effect-body">
      <p class="effect-section-label">{{localize "EX2E.CharmAttackHelp"}}</p>
      <div class="field-group" style="margin-bottom:4px">
        <label>{{localize "EX2E.CharmAttackWeaponName"}}</label>
        <input type="text" name="system.attack.name" value="{{system.attack.name}}"
               placeholder="{{item.name}}" {{#unless isEditable}}readonly{{/unless}}>
      </div>
      <div class="effect-grid-3">
        <div class="field-group">
          <label>{{localize "EX2E.Speed"}}</label>
          <div class="formula-field-row">
            <input type="text" name="system.attack.speed" value="{{system.attack.speed}}"
                   {{#unless isEditable}}readonly{{/unless}}>
            {{#if isEditable}}
            <button type="button" class="btn-fx" data-action="openFormula"
                    data-path="system.attack.speed" data-label="{{localize 'EX2E.Speed'}}"
                    data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
              <i class="fa-solid fa-function"></i>
            </button>
            {{/if}}
          </div>
        </div>
        <div class="field-group">
          <label>{{localize "EX2E.Accuracy"}}</label>
          <div class="formula-field-row">
            <input type="text" name="system.attack.accuracy" value="{{system.attack.accuracy}}"
                   {{#unless isEditable}}readonly{{/unless}}>
            {{#if isEditable}}
            <button type="button" class="btn-fx" data-action="openFormula"
                    data-path="system.attack.accuracy" data-label="{{localize 'EX2E.Accuracy'}}"
                    data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
              <i class="fa-solid fa-function"></i>
            </button>
            {{/if}}
          </div>
        </div>
        <div class="field-group">
          <label>{{localize "EX2E.Damage"}}</label>
          <div class="formula-field-row">
            <input type="text" name="system.attack.damage" value="{{system.attack.damage}}"
                   {{#unless isEditable}}readonly{{/unless}}>
            {{#if isEditable}}
            <button type="button" class="btn-fx" data-action="openFormula"
                    data-path="system.attack.damage" data-label="{{localize 'EX2E.Damage'}}"
                    data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
              <i class="fa-solid fa-function"></i>
            </button>
            {{/if}}
          </div>
        </div>
        <div class="field-group">
          <label>{{localize "EX2E.DamageType"}}</label>
          <select name="system.attack.damageType" {{#unless isEditable}}disabled{{/unless}}>
            {{#each damageTypes}}
            <option value="{{this.value}}" {{#if (eq this.value ../system.attack.damageType)}}selected{{/if}}>{{this.label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="field-group">
          <label>{{localize "EX2E.Overwhelming"}}</label>
          <div class="formula-field-row">
            <input type="text" name="system.attack.overwhelming" value="{{system.attack.overwhelming}}"
                   {{#unless isEditable}}readonly{{/unless}}>
            {{#if isEditable}}
            <button type="button" class="btn-fx" data-action="openFormula"
                    data-path="system.attack.overwhelming" data-label="{{localize 'EX2E.Overwhelming'}}"
                    data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
              <i class="fa-solid fa-function"></i>
            </button>
            {{/if}}
          </div>
        </div>
        <div class="field-group">
          <label>{{localize "EX2E.Defense"}}</label>
          <div class="formula-field-row">
            <input type="text" name="system.attack.defense" value="{{system.attack.defense}}"
                   {{#unless isEditable}}readonly{{/unless}}>
            {{#if isEditable}}
            <button type="button" class="btn-fx" data-action="openFormula"
                    data-path="system.attack.defense" data-label="{{localize 'EX2E.Defense'}}"
                    data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
              <i class="fa-solid fa-function"></i>
            </button>
            {{/if}}
          </div>
        </div>
        <div class="field-group">
          <label>{{localize "EX2E.Rate"}}</label>
          <div class="formula-field-row">
            <input type="text" name="system.attack.rate" value="{{system.attack.rate}}"
                   {{#unless isEditable}}readonly{{/unless}}>
            {{#if isEditable}}
            <button type="button" class="btn-fx" data-action="openFormula"
                    data-path="system.attack.rate" data-label="{{localize 'EX2E.Rate'}}"
                    data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
              <i class="fa-solid fa-function"></i>
            </button>
            {{/if}}
          </div>
        </div>
        <div class="field-group">
          <label>{{localize "EX2E.Range"}}</label>
          <div class="formula-field-row">
            <input type="text" name="system.attack.range" value="{{system.attack.range}}"
                   {{#unless isEditable}}readonly{{/unless}}>
            {{#if isEditable}}
            <button type="button" class="btn-fx" data-action="openFormula"
                    data-path="system.attack.range" data-label="{{localize 'EX2E.Range'}}"
                    data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
              <i class="fa-solid fa-function"></i>
            </button>
            {{/if}}
          </div>
        </div>
        <div class="field-group">
          <label>{{localize "EX2E.MinStrength"}}</label>
          <div class="formula-field-row">
            <input type="text" name="system.attack.minStrength" value="{{system.attack.minStrength}}"
                   {{#unless isEditable}}readonly{{/unless}}>
            {{#if isEditable}}
            <button type="button" class="btn-fx" data-action="openFormula"
                    data-path="system.attack.minStrength" data-label="{{localize 'EX2E.MinStrength'}}"
                    data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
              <i class="fa-solid fa-function"></i>
            </button>
            {{/if}}
          </div>
        </div>
        <div class="field-group">
          <label>{{localize "EX2E.MinDexterity"}}</label>
          <div class="formula-field-row">
            <input type="text" name="system.attack.minDexterity" value="{{system.attack.minDexterity}}"
                   {{#unless isEditable}}readonly{{/unless}}>
            {{#if isEditable}}
            <button type="button" class="btn-fx" data-action="openFormula"
                    data-path="system.attack.minDexterity" data-label="{{localize 'EX2E.MinDexterity'}}"
                    data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
              <i class="fa-solid fa-function"></i>
            </button>
            {{/if}}
          </div>
        </div>
        <div class="field-group">
          <label>{{localize "EX2E.MinMartialArts"}}</label>
          <div class="formula-field-row">
            <input type="text" name="system.attack.minMartialArts" value="{{system.attack.minMartialArts}}"
                   {{#unless isEditable}}readonly{{/unless}}>
            {{#if isEditable}}
            <button type="button" class="btn-fx" data-action="openFormula"
                    data-path="system.attack.minMartialArts" data-label="{{localize 'EX2E.MinMartialArts'}}"
                    data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
              <i class="fa-solid fa-function"></i>
            </button>
            {{/if}}
          </div>
        </div>
      </div>
      <div class="charm-attack-tags tags-block" style="margin-top:4px">
        <div class="tags-header">
          <label>{{localize "EX2E.Tags"}}</label>
          {{#if isEditable}}
          <button data-action="addAttackTag"><i class="fa-solid fa-plus"></i></button>
          {{/if}}
        </div>
        <div class="tags-list">
          {{#each system.attack.tags as |tg idx|}}
          <span class="keyword-tag-edit">
            <select name="system.attack.tags.{{idx}}" {{#unless @root.isEditable}}disabled{{/unless}}>
              {{#each @root.weaponTags as |opt|}}
              <option value="{{opt}}" {{#if (eq opt tg)}}selected{{/if}}>{{opt}}</option>
              {{/each}}
            </select>
            {{#if @root.isEditable}}
            <button data-action="removeAttackTag" data-index="{{idx}}">✕</button>
            {{/if}}
          </span>
          {{/each}}
        </div>
      </div>
    </div>
    {{/if}}
  </div>

  {{!-- M12 Attack Bonus (Supplemental) ───────────────────────────────────── --}}
  <div class="effect-section">
    <div class="effect-section-header-row">
      <label class="effect-enable-row">
        <input type="checkbox" name="system.attackBonus.enabled"
               {{#if system.attackBonus.enabled}}checked{{/if}}
               {{#unless isEditable}}disabled{{/unless}}>
        <span>{{localize "EX2E.EffectAttackBonus"}}</span>
      </label>
      {{#if system.upgradeTiers.length}}
      <label class="mode-exclusive-label" data-tooltip="{{localize 'EX2E.BaseModeOnlyTooltip'}}">
        <input type="checkbox" name="system.attackBonus.modeExclusive"
               {{#if system.attackBonus.modeExclusive}}checked{{/if}}
               {{#unless isEditable}}disabled{{/unless}}>
        {{localize "EX2E.BaseModeOnly"}}
      </label>
      {{/if}}
    </div>
    {{#if system.attackBonus.enabled}}
    <div class="effect-body">
      <div class="field-group">
        <label>{{localize "EX2E.ABAccuracyDice"}}</label>
        <div class="formula-field-row">
          <input type="text" name="system.attackBonus.accuracyDice"
                 value="{{system.attackBonus.accuracyDice}}"
                 {{#unless isEditable}}readonly{{/unless}}>
          {{#if isEditable}}
          <button type="button" class="btn-fx" data-action="openFormula"
                  data-path="system.attackBonus.accuracyDice"
                  data-label="{{localize 'EX2E.ABAccuracyDice'}}"
                  data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
            <i class="fa-solid fa-function"></i>
          </button>
          {{/if}}
        </div>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.ABAccuracySuccesses"}}</label>
        <div class="formula-field-row">
          <input type="text" name="system.attackBonus.accuracySuccesses"
                 value="{{system.attackBonus.accuracySuccesses}}"
                 {{#unless isEditable}}readonly{{/unless}}>
          {{#if isEditable}}
          <button type="button" class="btn-fx" data-action="openFormula"
                  data-path="system.attackBonus.accuracySuccesses"
                  data-label="{{localize 'EX2E.ABAccuracySuccesses'}}"
                  data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
            <i class="fa-solid fa-function"></i>
          </button>
          {{/if}}
        </div>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.ABDamageDice"}}</label>
        <div class="formula-field-row">
          <input type="text" name="system.attackBonus.damageDice"
                 value="{{system.attackBonus.damageDice}}"
                 {{#unless isEditable}}readonly{{/unless}}>
          {{#if isEditable}}
          <button type="button" class="btn-fx" data-action="openFormula"
                  data-path="system.attackBonus.damageDice"
                  data-label="{{localize 'EX2E.ABDamageDice'}}"
                  data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
            <i class="fa-solid fa-function"></i>
          </button>
          {{/if}}
        </div>
      </div>
      <div class="field-group">
        <label class="checkbox-label">
          <input type="checkbox" name="system.attackBonus.damageDicePerMote"
                 {{#if system.attackBonus.damageDicePerMote}}checked{{/if}}
                 {{#unless isEditable}}disabled{{/unless}}>
          {{localize "EX2E.ABDamageDicePerMote"}}
        </label>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.ABPostSoakDamageDice"}}</label>
        <div class="formula-field-row">
          <input type="text" name="system.attackBonus.postSoakDamageDice"
                 value="{{system.attackBonus.postSoakDamageDice}}"
                 {{#unless isEditable}}readonly{{/unless}}>
          {{#if isEditable}}
          <button type="button" class="btn-fx" data-action="openFormula"
                  data-path="system.attackBonus.postSoakDamageDice"
                  data-label="{{localize 'EX2E.ABPostSoakDamageDice'}}"
                  data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
            <i class="fa-solid fa-function"></i>
          </button>
          {{/if}}
        </div>
      </div>
      <div class="field-group">
        <label class="checkbox-label">
          <input type="checkbox" name="system.attackBonus.postSoakDicePerMote"
                 {{#if system.attackBonus.postSoakDicePerMote}}checked{{/if}}
                 {{#unless isEditable}}disabled{{/unless}}>
          {{localize "EX2E.ABPostSoakDicePerMote"}}
        </label>
      </div>
      <div class="field-group">
        <label class="checkbox-label">
          <input type="checkbox" name="system.attackBonus.ignoreAccuracyPenalties"
                 {{#if system.attackBonus.ignoreAccuracyPenalties}}checked{{/if}}
                 {{#unless isEditable}}disabled{{/unless}}>
          {{localize "EX2E.ABIgnoreAccuracyPenalties"}}
        </label>
      </div>
      <div class="field-group">
        <label class="checkbox-label">
          <input type="checkbox" name="system.attackBonus.ignoreRangeBand"
                 {{#if system.attackBonus.ignoreRangeBand}}checked{{/if}}
                 {{#unless isEditable}}disabled{{/unless}}>
          {{localize "EX2E.ABIgnoreRangeBand"}}
        </label>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.ABSoakPiercing"}}</label>
        <input type="number" name="system.attackBonus.soakPiercing"
               value="{{system.attackBonus.soakPiercing}}"
               min="0" {{#unless isEditable}}readonly{{/unless}}>
      </div>
      <div class="field-group">
        <label class="checkbox-label">
          <input type="checkbox" name="system.attackBonus.ignoresArmor"
                 {{#if system.attackBonus.ignoresArmor}}checked{{/if}}
                 {{#unless isEditable}}disabled{{/unless}}>
          {{localize "EX2E.ABIgnoresArmor"}}
        </label>
      </div>
    </div>
    {{/if}}
  </div>

  {{!-- M12b Attack Success Multiplier ─────────────────────────────────────── --}}
  <div class="effect-section">
    <div class="field-group">
      <label>{{localize "EX2E.AttackSuccessMultiplier"}}</label>
      <input type="number" name="system.attackSuccessMultiplier"
             value="{{system.attackSuccessMultiplier}}"
             min="1" {{#unless isEditable}}readonly{{/unless}}>
    </div>
  </div>

  {{!-- M12c Extra Success Multiplier ─────────────────────────────────────────── --}}
  <div class="effect-section">
    <div class="field-group">
      <label>{{localize "EX2E.ExtraSuccessMultiplier"}}</label>
      <input type="number" name="system.extraSuccessMultiplier"
             value="{{system.extraSuccessMultiplier}}"
             min="1" {{#unless isEditable}}readonly{{/unless}}>
    </div>
  </div>

  {{!-- M12d Attack Success Bonus ─────────────────────────────────────────────── --}}
  <div class="effect-section">
    <div class="field-group">
      <label>{{localize "EX2E.AttackSuccessBonus"}}</label>
      <input type="number" name="system.attackSuccessBonus"
             value="{{system.attackSuccessBonus}}"
             min="0" {{#unless isEditable}}readonly{{/unless}}>
    </div>
  </div>

  {{!-- M11 Penalty to Target ──────────────────────────────────────────────── --}}
  <div class="effect-section">
    <div class="effect-section-header-row">
      <label class="effect-enable-row">
        <input type="checkbox" name="system.targetPenalty.enabled"
               {{#if system.targetPenalty.enabled}}checked{{/if}}
               {{#unless isEditable}}disabled{{/unless}}>
        <span>{{localize "EX2E.EffectTargetPenalty"}}</span>
      </label>
      {{#if system.upgradeTiers.length}}
      <label class="mode-exclusive-label" data-tooltip="{{localize 'EX2E.BaseModeOnlyTooltip'}}">
        <input type="checkbox" name="system.targetPenalty.modeExclusive"
               {{#if system.targetPenalty.modeExclusive}}checked{{/if}}
               {{#unless isEditable}}disabled{{/unless}}>
        {{localize "EX2E.BaseModeOnly"}}
      </label>
      {{/if}}
    </div>
    {{#if system.targetPenalty.enabled}}
    <div class="effect-body effect-grid-2">
      <div class="field-group">
        <label>{{localize "EX2E.TPAmount"}}</label>
        <input type="number" name="system.targetPenalty.amount"
               value="{{system.targetPenalty.amount}}" max="0"
               {{#unless isEditable}}readonly{{/unless}}>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.TPAmountFormula"}}</label>
        <div class="formula-field-row">
          <input type="text" name="system.targetPenalty.amountFormula"
                 value="{{system.targetPenalty.amountFormula}}"
                 placeholder="e.g. -2"
                 {{#unless isEditable}}readonly{{/unless}}>
          {{#if isEditable}}
          <button type="button" class="btn-fx" data-action="openFormula"
                  data-path="system.targetPenalty.amountFormula"
                  data-label="{{localize 'EX2E.TPAmountFormula'}}"
                  data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
            <i class="fa-solid fa-function"></i>
          </button>
          {{/if}}
        </div>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.TPScope"}}</label>
        <select name="system.targetPenalty.scope" {{#unless isEditable}}disabled{{/unless}}>
          {{#each targetPenaltyScopes}}
          <option value="{{this.value}}" {{#if (eq this.value ../system.targetPenalty.scope)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.TPDuration"}}</label>
        <select name="system.targetPenalty.duration" {{#unless isEditable}}disabled{{/unless}}>
          {{#each durations}}
          <option value="{{this.value}}" {{#if (eq this.value ../system.targetPenalty.duration)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </div>
    </div>
    {{/if}}
  </div>

  {{!-- M19 Move Bonus ─────────────────────────────────────────────────────── --}}
  <div class="effect-section">
    <label class="effect-enable-row">
      <input type="checkbox" name="system.moveBonus.enabled"
             {{#if system.moveBonus.enabled}}checked{{/if}}
             {{#unless isEditable}}disabled{{/unless}}>
      <span>{{localize "EX2E.EffectMoveBonus"}}</span>
    </label>
    {{#if system.moveBonus.enabled}}
    <div class="effect-body">
      <div class="field-group">
        <label>{{localize "EX2E.MBDashAdd"}}</label>
        <div class="formula-field-row">
          <input type="text" name="system.moveBonus.dashAdd"
                 value="{{system.moveBonus.dashAdd}}"
                 placeholder="e.g. @ess or 3"
                 {{#unless isEditable}}readonly{{/unless}}>
          {{#if isEditable}}
          <button type="button" class="btn-fx" data-action="openFormula"
                  data-path="system.moveBonus.dashAdd"
                  data-label="{{localize 'EX2E.MBDashAdd'}}"
                  data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
            <i class="fa-solid fa-function"></i>
          </button>
          {{/if}}
        </div>
      </div>
      <div class="field-group">
        <label class="checkbox-label">
          <input type="checkbox" name="system.moveBonus.flight"
                 {{#if system.moveBonus.flight}}checked{{/if}}
                 {{#unless isEditable}}disabled{{/unless}}>
          {{localize "EX2E.MBFlight"}}
        </label>
      </div>
      <div class="field-group">
        <label class="checkbox-label">
          <input type="checkbox" name="system.moveBonus.waterWalking"
                 {{#if system.moveBonus.waterWalking}}checked{{/if}}
                 {{#unless isEditable}}disabled{{/unless}}>
          {{localize "EX2E.MBWaterWalking"}}
        </label>
      </div>
    </div>
    {{/if}}
  </div>

  {{!-- M14 Rate Bonus ──────────────────────────────────────────────────────── --}}
  <div class="effect-section">
    <div class="effect-section-header-row">
      <label class="effect-enable-row">
        <input type="checkbox" name="system.rateBonus.enabled"
               {{#if system.rateBonus.enabled}}checked{{/if}}
               {{#unless isEditable}}disabled{{/unless}}>
        <span>{{localize "EX2E.EffectRateBonus"}}</span>
      </label>
      {{#if system.upgradeTiers.length}}
      <label class="mode-exclusive-label" data-tooltip="{{localize 'EX2E.BaseModeOnlyTooltip'}}">
        <input type="checkbox" name="system.rateBonus.modeExclusive"
               {{#if system.rateBonus.modeExclusive}}checked{{/if}}
               {{#unless isEditable}}disabled{{/unless}}>
        {{localize "EX2E.BaseModeOnly"}}
      </label>
      {{/if}}
    </div>
    {{#if system.rateBonus.enabled}}
    <div class="effect-body effect-grid-2">
      <div class="field-group">
        <label>{{localize "EX2E.RateBonusFormula"}}</label>
        <div class="formula-field-row">
          <input type="text" name="system.rateBonus.formula"
                 value="{{system.rateBonus.formula}}"
                 placeholder="e.g. 1"
                 {{#unless isEditable}}readonly{{/unless}}>
          {{#if isEditable}}
          <button type="button" class="btn-fx" data-action="openFormula"
                  data-path="system.rateBonus.formula"
                  data-label="{{localize 'EX2E.RateBonusFormula'}}"
                  data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
            <i class="fa-solid fa-function"></i>
          </button>
          {{/if}}
        </div>
      </div>
    </div>
    {{/if}}
  </div>

