                {{/each}}
              </select>
            </div>
            <div class="field-group">
              <label>{{localize "EX2E.TPDuration"}}</label>
              <select name="system.upgradeTiers.{{i}}.targetPenalty.duration" {{#unless @root.isEditable}}disabled{{/unless}}>
                {{#each @root.durations as |dur|}}
                <option value="{{dur.value}}" {{#if (eq dur.value tier.targetPenalty.duration)}}selected{{/if}}>{{dur.label}}</option>
                {{/each}}
              </select>
            </div>
          </div>
          {{/if}}
