        </div>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.SMMinimum"}}</label>
        <input type="number" name="system.speedModifier.minimum"
               value="{{system.speedModifier.minimum}}" min="1"
               {{#unless isEditable}}readonly{{/unless}}>
      </div>
    </div>
    {{/if}}
  </div>

  {{!-- M15 Willpower Recovery ─────────────────────────────────────────────── --}}
  <div class="effect-section">
    <label class="effect-enable-row">
      <input type="checkbox" name="system.willpowerRecovery.enabled"
             {{#if system.willpowerRecovery.enabled}}checked{{/if}}
             {{#unless isEditable}}disabled{{/unless}}>
      <span>{{localize "EX2E.EffectWillpowerRecovery"}}</span>
    </label>
    {{#if system.willpowerRecovery.enabled}}
    <div class="effect-body effect-grid-2">
      <div class="field-group">
        <label>{{localize "EX2E.WillpowerRecoveryEvent"}}</label>
        <select name="system.willpowerRecovery.event" {{#unless isEditable}}disabled{{/unless}}>
          {{#each willpowerRecoveryEventChoices}}
          <option value="{{this.value}}" {{#if (eq this.value ../system.willpowerRecovery.event)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.WillpowerRecoveryFormula"}}</label>
        <div class="formula-field-row">
          <input type="text" name="system.willpowerRecovery.formula"
                 value="{{system.willpowerRecovery.formula}}"
                 placeholder="e.g. 1"
                 {{#unless isEditable}}readonly{{/unless}}>
          {{#if isEditable}}
          <button type="button" class="btn-fx" data-action="openFormula"
                  data-path="system.willpowerRecovery.formula"
                  data-label="{{localize 'EX2E.WillpowerRecoveryFormula'}}"
                  data-tooltip="{{localize 'EX2E.FormulaBuilder'}}">
            <i class="fa-solid fa-function"></i>
          </button>
          {{/if}}
        </div>
      </div>
    </div>
    {{/if}}
  </div>

  {{!-- M17 Grants Initiation ─────────────────────────────────────────────── --}}
  <div class="effect-section">
    <label class="effect-enable-row">
      <input type="checkbox" name="system.grantsInitiation.enabled"
             {{#if system.grantsInitiation.enabled}}checked{{/if}}
             {{#unless isEditable}}disabled{{/unless}}>
      <span>{{localize "EX2E.EffectGrantsInitiation"}}</span>
    </label>
    {{#if system.grantsInitiation.enabled}}
    <div class="effect-body effect-grid-2">
      <div class="field-group">
        <label>{{localize "EX2E.GITradition"}}</label>
        <select name="system.grantsInitiation.tradition" {{#unless isEditable}}disabled{{/unless}}>
          {{#each initiationTraditionChoices}}
          <option value="{{this.value}}" {{#if (eq this.value ../system.grantsInitiation.tradition)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.GILevel"}}</label>
        <select name="system.grantsInitiation.level" {{#unless isEditable}}disabled{{/unless}}>
          {{#each initiationLevelChoices}}
          <option value="{{this.value}}" {{#if (eq this.value ../system.grantsInitiation.level)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </div>
    </div>
    {{/if}}
  </div>

</div>
