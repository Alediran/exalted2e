<div class="sheet-body armor-body">
  <div class="armor-stats-grid">
    <div class="field-group"><label>{{localize "EX2E.BashingSoak"}}</label>
      <input type="number" name="system.soak.bashing"    value="{{system.soak.bashing}}"    min="0" {{#unless isEditable}}readonly{{/unless}}></div>
    <div class="field-group"><label>{{localize "EX2E.LethalSoak"}}</label>
      <input type="number" name="system.soak.lethal"     value="{{system.soak.lethal}}"     min="0" {{#unless isEditable}}readonly{{/unless}}></div>
    <div class="field-group"><label>{{localize "EX2E.AggravatedSoak"}}</label>
      <input type="number" name="system.soak.aggravated" value="{{system.soak.aggravated}}"  min="0" {{#unless isEditable}}readonly{{/unless}}></div>
    <div class="field-group"><label>{{localize "EX2E.Hardness"}}</label>
      <input type="number" name="system.hardness"        value="{{system.hardness}}"        min="0" {{#unless isEditable}}readonly{{/unless}}></div>
    <div class="field-group"><label>{{localize "EX2E.MobilityPenalty"}}</label>
      <input type="number" name="system.mobilityPenalty" value="{{system.mobilityPenalty}}" min="-4" max="0" {{#unless isEditable}}readonly{{/unless}}></div>
    <div class="field-group"><label>{{localize "EX2E.FatiguePenalty"}}</label>
      <input type="number" name="system.fatiguePenalty"  value="{{system.fatiguePenalty}}"  min="-4" max="0" {{#unless isEditable}}readonly{{/unless}}></div>
  </div>

  <div class="field-group checkbox-field" style="margin-top:8px">
    <label><input type="checkbox" name="system.isBroken" {{#if system.isBroken}}checked{{/if}}
                  {{#unless isEditable}}disabled{{/unless}}> {{localize "EX2E.IsBroken"}}</label>
  </div>
  <div class="field-group checkbox-field" style="margin-top:8px">
    <label><input type="checkbox" name="system.artifact" {{#if system.artifact}}checked{{/if}}
                  {{#unless isEditable}}disabled{{/unless}}> {{localize "EX2E.ArtifactArmor"}}</label>
  </div>
  {{#if system.artifact}}
  <div class="field-group">
    <label>{{localize "EX2E.MagicalMaterial"}}</label>
    <select name="system.magicalMaterial" {{#unless isEditable}}disabled{{/unless}}>
      <option value="">—</option>
      {{#each magicalMaterials}}
      <option value="{{this.value}}" {{#if (eq this.value ../system.magicalMaterial)}}selected{{/if}}>{{this.label}}</option>
      {{/each}}
    </select>
  </div>
  <div class="field-group">
    <label>{{localize "EX2E.AttunementCost"}}</label>
    <input type="number" name="system.attunementCost" value="{{system.attunementCost}}"
           min="0" {{#unless isEditable}}readonly{{/unless}}>
  </div>
  <div class="field-group checkbox-field">
    <label><input type="checkbox" name="system.attuned" {{#if system.attuned}}checked{{/if}}
                  {{#unless isEditable}}disabled{{/unless}}> {{localize "EX2E.CurrentlyAttuned"}}</label>
  </div>
  <div class="field-group">
    <label>{{localize "EX2E.ArtifactRating"}}</label>
    <input type="hidden" name="system.artifactRating" value="{{system.artifactRating}}">
    {{dotRating name="system.artifactRating" value=system.artifactRating max=5 min=0}}
  </div>
  <div class="field-group">
    <label>{{localize "EX2E.HearthstoneSlots"}}</label>
    <input type="number" name="system.hearthstoneSlots" value="{{system.hearthstoneSlots}}"
           min="0" max="3" {{#unless isEditable}}readonly{{/unless}}>
  </div>
  {{#if system.hearthstoneSlots}}
  <div class="hearthstone-socket-rows" style="margin-top:4px">
    {{#each socketedSlots as |slot|}}
    <div class="hearthstone-slot-row ex2e-row">
      {{#if slot.filled}}
      <span class="socket-label">⬡ {{slot.stoneName}} ★{{slot.stoneRating}}</span>
      {{#if @root.isEditable}}
      <button class="socket-btn" data-action="unsocketHearthstone" data-slot-index="{{slot.index}}">×</button>
      {{/if}}
      {{else}}
      {{#if @root.isEditable}}
      <button class="socket-btn" data-action="socketHearthstone" data-slot-index="{{slot.index}}">○ {{localize "EX2E.SocketHearthstone"}}</button>
      {{else}}
      <span class="socket-label socket-empty">○ —</span>
      {{/if}}
      {{/if}}
    </div>
    {{/each}}
  </div>
  {{/if}}
  {{/if}}

  <!-- Tags -->
  <div class="tags-block" style="margin-top:10px">
    <label>{{localize "EX2E.Tags"}}</label>
    <div class="tags-list">
      {{#each system.tags as |tag idx|}}
      <span class="keyword-tag-edit">
        <select name="system.tags.{{idx}}" {{#unless @root.isEditable}}disabled{{/unless}}>
          {{#each @root.allTags as |opt|}}
          <option value="{{opt}}" {{#if (eq opt tag)}}selected{{/if}}>{{opt}}</option>
          {{/each}}
        </select>
        {{#if @root.isEditable}}
        <button data-action="removeTag" data-index="{{idx}}">✕</button>
        {{/if}}
      </span>
      {{/each}}
      {{#if isEditable}}
      <button data-action="addTag">+ Tag</button>
      {{/if}}
    </div>
  </div>

  <div class="editor-container">
    {{#if isEditable}}
    {{> "systems/exalted2e/templates/item/_partials/description-langs.hbs"}}
    {{else}}
    <div class="editor-content">{{{enrichedDescription}}}</div>
    {{/if}}
  </div>
</div>
