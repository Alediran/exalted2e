<div class="tab {{cssClass}} sheet-body spell-body" data-tab="tabBody" data-group="sheet">

  <!-- Cost grid — shares the charm-stats-grid so inputs use the same widths -->
  <div class="charm-stats-grid">
    <div class="field-group">
      <label>{{localize "EX2E.Motes"}}</label>
      <input type="text" name="system.cost.motes" value="{{system.cost.motes}}"
             placeholder="e.g. 15m"
             {{#unless isEditable}}readonly{{/unless}}>
    </div>
    <div class="field-group">
      <label>{{localize "EX2E.Willpower"}}</label>
      <input type="number" name="system.cost.willpower" value="{{system.cost.willpower}}" min="0"
             {{#unless isEditable}}readonly{{/unless}}>
    </div>
    <div class="field-group">
      <label>{{localize "EX2E.CostBashingHealth"}}</label>
      <input type="number" name="system.cost.bashingHealth" value="{{system.cost.bashingHealth}}" min="0"
             {{#unless isEditable}}readonly{{/unless}}>
    </div>
    <div class="field-group">
      <label>{{localize "EX2E.CostLethalHealth"}}</label>
      <input type="number" name="system.cost.lethalHealth" value="{{system.cost.lethalHealth}}" min="0"
             {{#unless isEditable}}readonly{{/unless}}>
    </div>
    <div class="field-group">
      <label>{{localize "EX2E.CostAggravatedHealth"}}</label>
      <input type="number" name="system.cost.aggravatedHealth" value="{{system.cost.aggravatedHealth}}" min="0"
             {{#unless isEditable}}readonly{{/unless}}>
    </div>
    <div class="field-group">
      <label>{{localize "EX2E.CostExperience"}}</label>
      <input type="number" name="system.cost.xp" value="{{system.cost.xp}}" min="0"
             {{#unless isEditable}}readonly{{/unless}}>
    </div>
  </div>

  {{#if (eq system.tradition "weaving")}}
  <div class="charm-stats-grid" style="margin-top:4px">
    <div class="field-group">
      <label>{{localize "EX2E.MinimumClarity"}}</label>
      <input type="number" name="system.minimumClarity"
             value="{{system.minimumClarity}}" min="0" step="1"
             {{#unless isEditable}}readonly{{/unless}}>
    </div>
  </div>
  {{/if}}

  <!-- Resolution -->
  <h2 class="section-header">{{localize "EX2E.SpellResolution"}}</h2>
  <div class="spell-resolution-grid">
    <div class="field-group">
      <label>{{localize "EX2E.Duration"}}</label>
      <select name="system.duration" {{#unless isEditable}}disabled{{/unless}}>
        {{#each durations}}
        <option value="{{value}}" {{#if (eq value ../system.duration)}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="field-group" style="flex:1">
      <label>{{localize "EX2E.SpellTarget"}}</label>
      <input type="text" name="system.target" value="{{system.target}}"
             placeholder="{{localize 'EX2E.SpellTargetPlaceholder'}}"
             {{#unless isEditable}}readonly{{/unless}}>
    </div>
    <div class="field-group" style="flex:1">
      <label>{{localize "EX2E.SpellRange"}}</label>
      <input type="text" name="system.range" value="{{system.range}}"
             placeholder="{{localize 'EX2E.SpellRangePlaceholder'}}"
             {{#unless isEditable}}readonly{{/unless}}>
    </div>
  </div>

  <!-- Description -->
  <div class="editor-container">
    {{#if isEditable}}
    {{> "systems/exalted2e/templates/item/_partials/description-langs.hbs"}}
    {{else}}
    <div class="editor-content">{{{enrichedDescription}}}</div>
    {{/if}}
  </div>

</div>
