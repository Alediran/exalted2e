<div class="item-header weapon-header">
  <img class="item-portrait" src="{{item.img}}" alt="{{item.name}}"
       data-action="editImage" {{#unless isEditable}}disabled{{/unless}}>
  <div class="item-header-fields">
    <input class="item-name-input" type="text" name="name" value="{{item.name}}"
           {{#unless isEditable}}readonly{{/unless}}>
    <div class="weapon-mode-summaries">
      {{#each system.modes as |mode|}}
      <div class="weapon-stat-summary">
        <strong>{{mode.name}}:</strong>
        Spd {{mode.effectiveSpeed}} · Acc {{mode.accuracyLabel}} · Dmg {{mode.damageLabel}}
        · Def {{mode.defenseLabel}} · Rate {{mode.effectiveRate}}
        {{#if mode.range}} · Range {{mode.effectiveRange}}{{/if}}
      </div>
      {{/each}}
    </div>
    {{#if system.artifact}}
    <span class="keyword-tag" style="margin-top:4px">Artifact{{#if system.magicalMaterial}} · {{localize (lookup config.magicalMaterials system.magicalMaterial)}}{{/if}}</span>
    {{/if}}
    {{#if system.attuned}}
    <span class="keyword-tag" style="color:var(--ex2e-gold-main);margin-top:4px">Attuned</span>
    {{/if}}
  </div>
</div>
