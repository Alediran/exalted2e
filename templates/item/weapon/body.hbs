<div class="sheet-body weapon-body">

  <!-- ═══════════════ MODES OF USE ═══════════════ -->
  <div class="section-toolbar">
    <h2 class="section-header" style="margin:0;flex:1">{{localize "EX2E.Modes"}}</h2>
    {{#if isEditable}}
    <button class="btn-add-item" data-action="addMode" title="{{localize 'EX2E.AddMode'}}">
      <i class="fa-solid fa-plus"></i>
    </button>
    {{/if}}
  </div>

  {{#each system.modes as |mode mIdx|}}
  <div class="weapon-mode" data-mode-index="{{mIdx}}">
    <div class="mode-header">
      <input type="text" class="mode-name-input" name="system.modes.{{mIdx}}.name"
             value="{{mode.name}}" placeholder="{{localize 'EX2E.ModeName'}}"
             {{#unless @root.isEditable}}readonly{{/unless}}>
      {{#if @root.isEditable}}
      {{#if (gt @root.system.modes.length 1)}}
      <button class="btn-remove-mode" data-action="removeMode" data-index="{{mIdx}}" title="{{localize 'EX2E.RemoveMode'}}">
        <i class="fa-solid fa-xmark"></i>
      </button>
      {{/if}}
      {{/if}}
    </div>

    <div class="weapon-stats-grid">
      <div class="field-group"><label>{{localize "EX2E.Speed"}}</label>
        <input type="number" name="system.modes.{{mIdx}}.speed"      value="{{mode.speed}}"      min="0"  max="10"  {{#unless @root.isEditable}}readonly{{/unless}}></div>
      <div class="field-group"><label>{{localize "EX2E.Accuracy"}}</label>
        <input type="number" name="system.modes.{{mIdx}}.accuracy"   value="{{mode.accuracy}}"   min="-5" max="10"  {{#unless @root.isEditable}}readonly{{/unless}}></div>
      <div class="field-group"><label>{{localize "EX2E.Damage"}}</label>
        <input type="number" name="system.modes.{{mIdx}}.damage"     value="{{mode.damage}}"     min="0"  max="20"  {{#unless @root.isEditable}}readonly{{/unless}}></div>
      <div class="field-group"><label>{{localize "EX2E.Type"}}</label>
        <select name="system.modes.{{mIdx}}.damageType" {{#unless @root.isEditable}}disabled{{/unless}}>
          {{#each @root.damageTypes}}
          <option value="{{this.value}}" {{#if (eq this.value mode.damageType)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="field-group"><label>{{localize "EX2E.Overwhelming"}}</label>
        <input type="number" name="system.modes.{{mIdx}}.overwhelming" value="{{mode.overwhelming}}" min="0" max="20" {{#unless @root.isEditable}}readonly{{/unless}}></div>
      <div class="field-group"><label>{{localize "EX2E.Defense"}}</label>
        <input type="number" name="system.modes.{{mIdx}}.defense"    value="{{mode.defense}}"    min="-5" max="10"  {{#unless @root.isEditable}}readonly{{/unless}}></div>
      <div class="field-group"><label>{{localize "EX2E.Rate"}}</label>
        <input type="number" name="system.modes.{{mIdx}}.rate"       value="{{mode.rate}}"       min="0"  max="10"  {{#unless @root.isEditable}}readonly{{/unless}}></div>
      <div class="field-group"><label>{{localize "EX2E.Range"}}</label>
        <input type="number" name="system.modes.{{mIdx}}.range"      value="{{mode.range}}"      min="0"  max="400" {{#unless @root.isEditable}}readonly{{/unless}}></div>
      <div class="field-group"><label>{{localize "EX2E.MinStrength"}}</label>
        <input type="hidden" name="system.modes.{{mIdx}}.minStrength" value="{{mode.minStrength}}">
        {{dotRating name=(concat "system.modes." mIdx ".minStrength")    value=mode.minStrength    max=5 min=0}}</div>
      <div class="field-group"><label>{{localize "EX2E.MinDexterity"}}</label>
        <input type="hidden" name="system.modes.{{mIdx}}.minDexterity" value="{{mode.minDexterity}}">
        {{dotRating name=(concat "system.modes." mIdx ".minDexterity")   value=mode.minDexterity   max=5 min=0}}</div>
      <div class="field-group"><label>{{localize "EX2E.MinMartialArts"}}</label>
        <input type="hidden" name="system.modes.{{mIdx}}.minMartialArts" value="{{mode.minMartialArts}}">
        {{dotRating name=(concat "system.modes." mIdx ".minMartialArts") value=mode.minMartialArts max=5 min=0}}</div>
    </div>

    <!-- Per-mode tags -->
    <div class="tags-block" style="margin-top:8px">
      <div class="tags-header">
        <label>{{localize "EX2E.Tags"}}</label>
        {{#if @root.isEditable}}
          <button data-action="addTag" data-mode-index="{{mIdx}}">
            <i class="fa-solid fa-plus"></i>
          </button>
        {{/if}}
      </div>
      <div class="tags-list">
        {{#each mode.tags as |tag tIdx|}}
        <span class="keyword-tag-edit">
          <select name="system.modes.{{mIdx}}.tags.{{tIdx}}" {{#unless @root.isEditable}}disabled{{/unless}}>
            {{#each @root.allTags as |opt|}}
            <option value="{{opt}}" {{#if (eq opt tag)}}selected{{/if}}>{{opt}}</option>
            {{/each}}
          </select>
          {{#if @root.isEditable}}
          <button data-action="removeTag" data-mode-index="{{mIdx}}" data-index="{{tIdx}}">
            <i class="fa-solid fa-xmark"></i>
          </button>
          {{/if}}
        </span>
        {{/each}}
      </div>
    </div>

    {{#if (includes mode.tags "Area")}}
    <div class="area-config-block" style="margin-top:8px">
      <div class="field-group">
        <label>{{localize "EX2E.AreaShape"}}</label>
        <select name="system.modes.{{mIdx}}.areaShape" {{#unless @root.isEditable}}disabled{{/unless}}>
          <option value="circle" {{#if (eq mode.areaShape "circle")}}selected{{/if}}>{{localize "EX2E.AreaShapeCircle"}}</option>
          <option value="cone"   {{#if (eq mode.areaShape "cone")}}selected{{/if}}>{{localize "EX2E.AreaShapeCone"}}</option>
          <option value="rect"   {{#if (eq mode.areaShape "rect")}}selected{{/if}}>{{localize "EX2E.AreaShapeRect"}}</option>
          <option value="ray"    {{#if (eq mode.areaShape "ray")}}selected{{/if}}>{{localize "EX2E.AreaShapeRay"}}</option>
        </select>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.AreaSize"}}</label>
        <input type="text" name="system.modes.{{mIdx}}.areaSize" value="{{mode.areaSize}}"
               {{#unless @root.isEditable}}readonly{{/unless}}>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.AreaResistPool"}}</label>
        <input type="text" name="system.modes.{{mIdx}}.areaResistPool" value="{{mode.areaResistPool}}"
               {{#unless @root.isEditable}}readonly{{/unless}}>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.AreaResistDifficulty"}}</label>
        <input type="text" name="system.modes.{{mIdx}}.areaResistDifficulty" value="{{mode.areaResistDifficulty}}"
               {{#unless @root.isEditable}}readonly{{/unless}}>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.AreaResistEffect"}}</label>
        <select name="system.modes.{{mIdx}}.areaResistEffect" {{#unless @root.isEditable}}disabled{{/unless}}>
          <option value="avoid"  {{#if (eq mode.areaResistEffect "avoid")}}selected{{/if}}>{{localize "EX2E.AreaResistEffectAvoid"}}</option>
          <option value="reduce" {{#if (eq mode.areaResistEffect "reduce")}}selected{{/if}}>{{localize "EX2E.AreaResistEffectReduce"}}</option>
        </select>
      </div>
    </div>
    {{/if}}
  </div>
  {{/each}}

  <!-- ═══════════════ ARTIFACT / ATTUNEMENT ═══════════════ -->
  <div class="field-group checkbox-field" style="margin-top:12px">
    <label><input type="checkbox" name="system.artifact" {{#if system.artifact}}checked{{/if}}
                  {{#unless isEditable}}disabled{{/unless}}> {{localize "EX2E.ArtifactWeapon"}}</label>
  </div>
  {{#if system.artifact}}
  <div class="field-group">
    <label>{{localize "EX2E.MagicalMaterial"}}</label>
    <select name="system.magicalMaterial" {{#unless isEditable}}disabled{{/unless}}>
      <option value="">—</option>
      {{#each magicalMaterials}}
      <option value="{{this.value}}" {{#if (eq this.value @root.system.magicalMaterial)}}selected{{/if}}>{{this.label}}</option>
      {{/each}}
    </select>
  </div>
  <div class="field-group">
    <label>{{localize "EX2E.AttunementCost"}}</label>
    <input type="number" name="system.attunementCost" value="{{system.attunementCost}}"
           min="0" max="20" {{#unless isEditable}}readonly{{/unless}}>
  </div>
  <div class="field-group checkbox-field">
    <label>
      <input type="checkbox" name="system.attuned" {{#if system.attuned}}checked{{/if}}
        {{#unless isEditable}}disabled{{/unless}}> {{localize "EX2E.CurrentlyAttuned"}}
    </label>
  </div>
  <div class="field-group">
    <label>{{localize "EX2E.ArtifactRating"}}</label>
    <input type="hidden" name="system.artifactRating" value="{{system.artifactRating}}">
    {{dotRating name="system.artifactRating" value=system.artifactRating max=5 min=0}}
  </div>
  <div class="field-group">
    <label>{{localize "EX2E.HearthstoneSlots"}}</label>
    <input type="number" name="system.hearthstoneSlots" value="{{system.hearthstoneSlots}}"
           min="0" max="3" {{#unless isEditable}}readonly{{/unless}}>
  </div>
  {{#if system.hearthstoneSlots}}
  <div class="hearthstone-socket-rows" style="margin-top:4px">
    {{#each socketedSlots as |slot|}}
    <div class="hearthstone-slot-row">
      {{#if slot.filled}}
      <span class="socket-label">⬡ {{slot.stoneName}} ★{{slot.stoneRating}}</span>
      {{#if @root.isEditable}}
      <button class="socket-btn" data-action="unsocketHearthstone" data-slot-index="{{slot.index}}">×</button>
      {{/if}}
      {{else}}
      {{#if @root.isEditable}}
      <button class="socket-btn" data-action="socketHearthstone" data-slot-index="{{slot.index}}">○ {{localize "EX2E.SocketHearthstone"}}</button>
      {{else}}
      <span class="socket-label socket-empty">○ —</span>
      {{/if}}
      {{/if}}
    </div>
    {{/each}}
  </div>
  {{/if}}
  {{/if}}

  <!-- ═══════════════ DESCRIPTION ═══════════════ -->
  <h2 class="section-header">{{localize "EX2E.Description"}}</h2>
  <div class="editor-container">
    {{#if isEditable}}
    <prose-mirror name="system.description" data-document-uuid="{{item.uuid}}" value="{{system.description}}" collaborate="true" toggled="true">
      {{{enrichedDescription}}}
    </prose-mirror>
    {{else}}
    <div class="editor-content">{{{enrichedDescription}}}</div>
    {{/if}}
  </div>
</div>
