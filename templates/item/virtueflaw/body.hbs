<div class="sheet-body virtueflaw-body">

  <div class="field-group">
    <label>{{localize "EX2E.ExaltType"}}</label>
    <select name="system.exaltType" {{#unless isEditable}}disabled{{/unless}}>
      {{#each splatTypes}}
      <option value="{{this.value}}" {{#if (eq this.value ../system.exaltType)}}selected{{/if}}>{{this.label}}</option>
      {{/each}}
    </select>
  </div>

  <div class="field-group" style="margin-top:8px">
    <label>{{localize "EX2E.BaseVirtue"}}</label>
    <select name="system.baseVirtue" {{#unless isEditable}}disabled{{/unless}}>
      {{#each virtues}}
      <option value="{{this.value}}" {{#if (eq this.value ../system.baseVirtue)}}selected{{/if}}>{{this.label}}</option>
      {{/each}}
    </select>
  </div>

  <div class="virtueflaw-break-effect" style="margin-top:8px">
    <label title="{{localize 'EX2E.LimitBreakEffectHint'}}">{{localize "EX2E.LimitBreakEffect"}}</label>
    {{#each system.changes as |chg i|}}
    <div class="sb-change-row">
      <input type="text" name="system.changes.{{i}}.key" value="{{chg.key}}"
             placeholder="system.dv.dodge" {{#unless @root.isEditable}}readonly{{/unless}}>
      <input type="number" name="system.changes.{{i}}.mode" value="{{chg.mode}}" min="0" max="6" style="width:4em"
             {{#unless @root.isEditable}}readonly{{/unless}}>
      <input type="text" name="system.changes.{{i}}.value" value="{{chg.value}}" style="width:6em"
             {{#unless @root.isEditable}}readonly{{/unless}}>
      {{#if @root.isEditable}}
      <button type="button" class="btn-remove" data-action="removeChange" data-index="{{i}}"><i class="fa-solid fa-times"></i></button>
      {{/if}}
    </div>
    {{/each}}
    {{#if isEditable}}
    <button type="button" class="btn-add-row" data-action="addChange">+ {{localize "EX2E.LimitBreakAddChange"}}</button>
    {{/if}}
  </div>

  <h2 class="section-header">{{localize "EX2E.Description"}}</h2>
  <div class="editor-container">
    {{#if isEditable}}
    <prose-mirror name="system.description" data-document-uuid="{{item.uuid}}" value="{{system.description}}" collaborate="true" toggled="true">
      {{{enrichedDescription}}}
    </prose-mirror>
    {{else}}
    <div class="editor-content">{{{enrichedDescription}}}</div>
    {{/if}}
  </div>
</div>
