<div class="tab {{cssClass}}" data-tab="tabMain" data-group="sheet">
  <div class="sheet-body">

    <!-- ═══════════════ ATTRIBUTES ═══════════════ -->
    <h2 class="section-header">{{localize "EX2E.Attributes"}}</h2>
    <div class="attributes-section">

      <!-- Physical -->
      <div class="attribute-group">
        <div class="group-label">{{localize "EX2E.AttrGroupPhysical"}}</div>
        {{#each (array "strength" "dexterity" "stamina") as |attrKey|}}
        <div class="attribute-row">
          <span class="attribute-label">{{localizeAttribute attrKey}}</span>
          {{dotRating name=(concat "system.attributes." attrKey ".value")
                      value=(lookup (lookup ../system.attributes attrKey) "value")
                      max=5 min=1}}
        </div>
        {{/each}}
      </div>

      <!-- Social -->
      <div class="attribute-group">
        <div class="group-label">{{localize "EX2E.AttrGroupSocial"}}</div>
        {{#each (array "charisma" "manipulation" "appearance") as |attrKey|}}
        <div class="attribute-row">
          <span class="attribute-label">{{localizeAttribute attrKey}}</span>
          {{dotRating name=(concat "system.attributes." attrKey ".value")
                      value=(lookup (lookup ../system.attributes attrKey) "value")
                      max=5 min=1}}
        </div>
        {{/each}}
      </div>

      <!-- Mental -->
      <div class="attribute-group">
        <div class="group-label">{{localize "EX2E.AttrGroupMental"}}</div>
        {{#each (array "perception" "intelligence" "wits") as |attrKey|}}
        <div class="attribute-row">
          <span class="attribute-label">{{localizeAttribute attrKey}}</span>
          {{dotRating name=(concat "system.attributes." attrKey ".value")
                      value=(lookup (lookup ../system.attributes attrKey) "value")
                      max=5 min=1}}
        </div>
        {{/each}}
      </div>
    </div>

    <!-- ═══════════════ ABILITIES ═══════════════ -->
    {{#if useFourColumnAbilities}}
    {{> "systems/exalted2e/templates/actor/character/abilities-four.hbs"}}
    {{else}}
    {{> "systems/exalted2e/templates/actor/character/abilities-default.hbs"}}
    {{/if}}

    <!-- ═══════════════ VIRTUES ═══════════════ -->
    <h2 class="section-header">{{localize "EX2E.Virtues"}}</h2>
    <div class="virtues-section">
      {{#each (array "compassion" "temperance" "conviction" "valor") as |v|}}
      <div class="virtue-row">
        <button class="virtue-label" data-action="rollPool"
                data-pool="{{lookup (lookup ../system.virtues v) 'value'}}"
                data-flavor="{{localize (concat 'EX2E.Virtue' (capitalize v))}}">{{localize (concat "EX2E.Virtue" (capitalize v))}}</button>
        <div class="virtue-tracks">
          {{dotRating name=(concat "system.virtues." v ".value")
                      value=(lookup (lookup ../system.virtues v) "value")
                      max=5 min=1}}
          {{boxRating name=(concat "system.virtues." v ".current")
                      value=(lookup (lookup ../system.virtues v) "current")
                      max=(lookup (lookup ../system.virtues v) "value")
                      total=5
                      min=0}}
        </div>

      </div>
      {{/each}}

      <!-- Virtue Flaw (input-style lookup slot) -->
      <div class="virtue-flaw-row"{{#if virtueFlaw}} data-item-id="{{virtueFlaw.id}}"{{/if}}>
        <span class="virtue-flaw-label">{{localize "EX2E.VirtueFlaw"}}</span>
        <div class="virtue-flaw-input-group">
          {{#if virtueFlaw}}
          <button type="button" class="virtue-flaw-input virtue-flaw-open" data-action="editItem"
                  title="{{localize 'EX2E.SheetVirtueFlaw'}}">{{virtueFlaw.name}}</button>
          {{else}}
          <span class="virtue-flaw-input virtue-flaw-empty">—</span>
          {{/if}}
          {{#if isEditable}}
          <button type="button" class="virtue-flaw-lookup" data-action="pickVirtueFlaw"
                  title="{{localize 'EX2E.LookupVirtueFlaw'}}">
            <i class="fa-solid fa-magnifying-glass"></i>
          </button>
          {{#if virtueFlaw}}
          <button type="button" class="virtue-flaw-clear" data-action="clearVirtueFlaw"
                  title="{{localize 'EX2E.Clear'}}">
            <i class="fa-solid fa-xmark"></i>
          </button>
          {{/if}}
          {{/if}}
        </div>
      </div>
    </div>

    <!-- ═══════════════ SPLAT-SPECIFIC TRAITS ═══════════════ -->
    {{> "systems/exalted2e/templates/actor/character/_splat.hbs"}}

  </div><!-- .sheet-body -->
</div><!-- .tab -->
