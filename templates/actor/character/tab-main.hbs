<div class="tab {{cssClass}}" data-tab="tabMain" data-group="sheet">
  <div class="sheet-body">

    <!-- ═══════════════ ATTRIBUTES ═══════════════ -->
    <h2 class="section-header">{{localize "EX2E.Attributes"}}</h2>
    <div class="attributes-section">

      <!-- Physical -->
      <div class="attribute-group">
        <div class="group-label">{{localize "EX2E.AttrGroupPhysical"}}</div>
        {{#each (array "strength" "dexterity" "stamina") as |attrKey|}}
        {{#with (lookup ../system.attributes attrKey) as |attr|}}
        <div class="attribute-row {{#if attr.caste}}caste-attribute{{else if attr.favored}}favored-attribute{{/if}}">
          {{#if @root.useAttributeCasteUI}}
          <button class="attribute-flag attribute-flag--{{#if attr.caste}}caste{{else if attr.favored}}favored{{else}}none{{/if}}"
                  data-action="cycleAttributeFlag" data-attr="{{attrKey}}"
                  title="{{#if attr.caste}}{{localize 'EX2E.AttributeCaste'}}{{else if attr.favored}}{{localize 'EX2E.AttributeFavored'}}{{else}}—{{/if}}"
                  {{#unless @root.isEditable}}disabled{{/unless}}>
          </button>
          {{/if}}
          <span class="attribute-label">{{localizeAttribute attrKey}}</span>
          {{dotRating name=(concat "system.attributes." attrKey ".value")
                      value=attr.value
                      max=5 min=1}}
        </div>
        {{/with}}
        {{/each}}
      </div>

      <!-- Social -->
      <div class="attribute-group">
        <div class="group-label">{{localize "EX2E.AttrGroupSocial"}}</div>
        {{#each (array "charisma" "manipulation" "appearance") as |attrKey|}}
        {{#with (lookup ../system.attributes attrKey) as |attr|}}
        <div class="attribute-row {{#if attr.caste}}caste-attribute{{else if attr.favored}}favored-attribute{{/if}}">
          {{#if @root.useAttributeCasteUI}}
          <button class="attribute-flag attribute-flag--{{#if attr.caste}}caste{{else if attr.favored}}favored{{else}}none{{/if}}"
                  data-action="cycleAttributeFlag" data-attr="{{attrKey}}"
                  title="{{#if attr.caste}}{{localize 'EX2E.AttributeCaste'}}{{else if attr.favored}}{{localize 'EX2E.AttributeFavored'}}{{else}}—{{/if}}"
                  {{#unless @root.isEditable}}disabled{{/unless}}>
          </button>
          {{/if}}
          <span class="attribute-label">{{localizeAttribute attrKey}}</span>
          {{dotRating name=(concat "system.attributes." attrKey ".value")
                      value=attr.value
                      max=5 min=1}}
        </div>
        {{/with}}
        {{/each}}
      </div>

      <!-- Mental -->
      <div class="attribute-group">
        <div class="group-label">{{localize "EX2E.AttrGroupMental"}}</div>
        {{#each (array "perception" "intelligence" "wits") as |attrKey|}}
        {{#with (lookup ../system.attributes attrKey) as |attr|}}
        <div class="attribute-row {{#if attr.caste}}caste-attribute{{else if attr.favored}}favored-attribute{{/if}}">
          {{#if @root.useAttributeCasteUI}}
          <button class="attribute-flag attribute-flag--{{#if attr.caste}}caste{{else if attr.favored}}favored{{else}}none{{/if}}"
                  data-action="cycleAttributeFlag" data-attr="{{attrKey}}"
                  title="{{#if attr.caste}}{{localize 'EX2E.AttributeCaste'}}{{else if attr.favored}}{{localize 'EX2E.AttributeFavored'}}{{else}}—{{/if}}"
                  {{#unless @root.isEditable}}disabled{{/unless}}>
          </button>
          {{/if}}
          <span class="attribute-label">{{localizeAttribute attrKey}}</span>
          {{dotRating name=(concat "system.attributes." attrKey ".value")
                      value=attr.value
                      max=5 min=1}}
        </div>
        {{/with}}
        {{/each}}
      </div>
    </div>

    <!-- ═══════════════ ABILITIES ═══════════════ -->
    {{#if useFourColumnAbilities}}
    {{> "systems/exalted2e/templates/actor/character/abilities-four.hbs"}}
    {{else}}
    {{> "systems/exalted2e/templates/actor/character/abilities-default.hbs"}}
    {{/if}}

    <!-- ═══════════════ VIRTUES + HEALTH + ANIMA (3-column row) ═══════════════ -->
    <div class="main-tab-triple-row"
         style="display:grid; grid-template-columns: 1fr 1fr 1fr; gap: var(--ex2e-gap-lg); align-items:start;">

      {{!-- Column 1: Virtues 2x2 + Virtue Flaw below --}}
      <section class="virtues-column">
        <div class="section-toolbar">
          <h2 class="section-header" style="margin:0;flex:1">{{localize "EX2E.Virtues"}}</h2>
        </div>
        <div class="virtues-section">
          {{#each (array "compassion" "temperance" "conviction" "valor") as |v|}}
          <div class="virtue-row">
            <div class="virtue-label-group">
              <button class="virtue-label" data-action="rollPool"
                      data-pool="{{lookup (lookup ../system.virtues v) 'value'}}"
                      data-flavor="{{localize (concat 'EX2E.Virtue' (capitalize v))}}">{{localize (concat "EX2E.Virtue" (capitalize v))}}</button>
              {{#if @root.isEditable}}
              <button type="button" class="virtue-roll-btn"
                      data-action="rollVirtue"
                      data-virtue="{{v}}"
                      title="{{localize (concat 'EX2E.Virtue' (capitalize v))}}">
                <i class="fa-solid fa-dice"></i>
              </button>
              {{/if}}
            </div>
            <div class="virtue-tracks">
              {{dotRating name=(concat "system.virtues." v ".value")
                          value=(lookup (lookup ../system.virtues v) "value")
                          max=5 min=1}}
              {{boxRating name=(concat "system.virtues." v ".current")
                          value=(lookup (lookup ../system.virtues v) "current")
                          max=(lookup (lookup ../system.virtues v) "value")
                          total=5
                          min=0}}
            </div>
            <label class="virtue-channel-label" title="{{localize 'EX2E.VirtueChanneled'}}">
              <input type="checkbox"
                     name="{{concat 'system.virtues.' v '.channeled'}}"
                     {{#if (lookup (lookup ../system.virtues v) "channeled")}}checked{{/if}}
                     {{#unless @root.isEditable}}disabled{{/unless}}>
            </label>
            {{#if @root.isEditable}}
            <label class="virtue-primary-label" title="{{localize 'EX2E.PrimaryVirtue'}}">
              <input type="radio"
                     name="system.primaryVirtue"
                     value="{{v}}"
                     {{#if (eq @root.system.primaryVirtue v)}}checked{{/if}}
                     {{#if @root.document.system.purchaseLocked}}disabled{{/if}}>
            </label>
            {{/if}}
          </div>
          {{/each}}

          {{!-- Limit track + variant warnings (hidden for mortals) --}}
          {{#unless (eq system.exaltType "mortal")}}
          <div style="grid-column: 1 / -1; margin-top: var(--ex2e-gap-sm);">
            {{#if (eq system.exaltType "infernal")}}
            <div class="section-toolbar">
              <h2 class="section-header" style="flex:1">{{limitLabel}}</h2>
              {{#if isGM}}
              <button type="button" class="section-header-btn" data-action="rollActOfVillainy"
                      title="{{localize 'EX2E.SplatActOfVillainy'}}">
                <i class="fa-solid fa-dice"></i>
              </button>
              {{/if}}
            </div>
            {{else if (eq system.exaltType "abyssal")}}
            <div class="section-toolbar">
              <h2 class="section-header" style="flex:1">{{limitLabel}}</h2>
              {{#if isEditable}}
              <button type="button" class="section-header-btn" data-action="ventResonance"
                title="{{localize 'EX2E.VentResonance'}}">
                <i class="fa-solid fa-wind"></i>
              </button>
              {{/if}}
            </div>
            {{else}}
            <h2 class="section-header">{{limitLabel}}</h2>
            {{/if}}
            {{boxRating name="system.limit"
                        value=system.limit
                        max=10
                        min=0
                        total=10}}

            {{#if (eq system.exaltType "alchemical")}}
            <div class="trait-row clarity-permanent-row">
              <label>{{localize "EX2E.ClarityPermanent"}}</label>
              <span class="clarity-permanent-value">{{system.splat.alchemical.clarity.permanent}}</span>
            </div>
            {{#if (gt system.clarityModifiers.socialPenalty 0)}}
            <div class="clarity-modifiers-block">
              <span>−{{system.clarityModifiers.socialPenalty}} {{localize "EX2E.ClaritySocialPenalty"}}</span>
              <span class="clarity-autochthon">+{{system.clarityModifiers.autochthonBonus}} {{localize "EX2E.ClarityAutochthonBonus"}}</span>
            </div>
            {{/if}}
            {{#if (gt system.clarityModifiers.mentalBonus 0)}}
            <div class="clarity-modifiers-block">
              <span>+{{system.clarityModifiers.mentalBonus}} {{localize "EX2E.ClarityMentalBonus"}}</span>
            </div>
            {{/if}}
            {{#if system.clarityModifiers.compassionAutoFail}}
            <div class="clarity-modifiers-block clarity-compassion-suppressed">
              <span>{{localize "EX2E.ClarityCompassionSuppressed"}}</span>
            </div>
            {{else}}
            {{#if (gt system.clarityModifiers.compassionPenalty 0)}}
            <div class="clarity-modifiers-block clarity-compassion-penalty">
              <span>−{{system.clarityModifiers.compassionPenalty}} {{localize "EX2E.ClarityCompassionPenalty"}}</span>
            </div>
            {{/if}}
            {{/if}}
            <div class="trait-row dissonance-row">
              <label>{{localize "EX2E.Dissonance"}}</label>
              {{#if isEditable}}
              <button type="button" class="btn-sm" data-action="dissonanceDown" title="{{localize 'EX2E.DissonanceDown'}}">
                <i class="fa-solid fa-minus"></i>
              </button>
              {{/if}}
              {{boxRating name="system.splat.alchemical.dissonance"
                          value=system.splat.alchemical.dissonance
                          max=10 min=0 total=10}}
              {{#if isEditable}}
              <button type="button" class="btn-sm" data-action="dissonanceUp" title="{{localize 'EX2E.DissonanceUp'}}">
                <i class="fa-solid fa-plus"></i>
              </button>
              {{/if}}
            </div>
            {{/if}}

            {{#if (and (eq system.exaltType "abyssal") (eq system.limit 10))}}
            <div class="resonance-eruption-warning">{{localize "EX2E.ResonanceEruption"}}</div>
            {{/if}}


            {{#if (and (includes (array "solar" "lunar" "terrestrial" "sidereal") system.exaltType) (eq system.limit 10))}}
            <div class="limit-break-warning">{{localize "EX2E.LimitBreak"}}</div>
            {{/if}}
            {{#if gremlinSyndromeActive}}
            <div class="limit-break-warning gremlin-syndrome-warning">{{localize "EX2E.GremlinSyndrome"}}</div>
            {{/if}}
          </div>

          {{#if (eq system.exaltType "sidereal")}}
          <div style="grid-column: 1 / -1; margin-top: var(--ex2e-gap-sm);">
            <h2 class="section-header">{{localize "EX2E.Paradox"}}</h2>
            {{boxRating name="system.splat.sidereal.paradox"
                        value=system.splat.sidereal.paradox
                        max=10
                        min=0
                        total=10}}
            {{#if (eq system.splat.sidereal.paradox 10)}}
            <div class="limit-break-warning">{{localize "EX2E.PatternBite"}}</div>
            {{/if}}
            {{#if isGM}}
            <button type="button" class="btn-sm rparadox-roll-btn" data-action="rollResplendentParadox">
              <i class="fa-solid fa-dice"></i> {{localize "EX2E.ResplendentParadoxRoll"}}
            </button>
            {{/if}}
          </div>
          {{/if}}
          {{/unless}}

          {{!-- Virtue Flaw: hidden for Infernal (Urge instead), Abyssal, and Mortal --}}
          {{#unless (eq system.exaltType "infernal")}}{{#unless (eq system.exaltType "abyssal")}}{{#unless (eq system.exaltType "mortal")}}
          <div class="virtue-flaw-section" style="grid-column: 1 / -1;"
               {{#if virtueFlaw}}data-item-id="{{virtueFlaw.id}}"{{/if}}>
            <h2 class="section-header">{{localize "EX2E.VirtueFlaw"}}</h2>
            <div class="virtue-flaw-input-group">
              {{#if virtueFlaw}}
              <button type="button" class="virtue-flaw-input virtue-flaw-open" data-action="editItem"
                      title="{{localize 'EX2E.SheetVirtueFlaw'}}">{{virtueFlaw.name}}</button>
              {{else}}
              <span class="virtue-flaw-input virtue-flaw-empty">—</span>
              {{/if}}
              {{#if isEditable}}
              <button type="button" class="virtue-flaw-lookup" data-action="pickVirtueFlaw"
                      title="{{localize 'EX2E.LookupVirtueFlaw'}}">
                <i class="fa-solid fa-magnifying-glass"></i>
              </button>
              {{#if virtueFlaw}}
              <button type="button" class="virtue-flaw-clear" data-action="clearVirtueFlaw"
                      title="{{localize 'EX2E.Clear'}}">
                <i class="fa-solid fa-xmark"></i>
              </button>
              {{/if}}
              {{/if}}
            </div>
          </div>
          {{/unless}}{{/unless}}{{/unless}}
          {{#if (eq system.exaltType "infernal")}}
          <div class="virtue-flaw-section" style="grid-column: 1 / -1;"
               {{#if urgeItem}}data-item-id="{{urgeItem.id}}"{{/if}}>
            <div class="section-toolbar">
              <h2 class="section-header" style="margin:0;flex:1">{{localize "EX2E.SplatUrge"}}</h2>
              {{#if urgeItem}}
              <img class="urge-item-icon" src="{{urgeItem.img}}"
                   data-action="editItem"
                   title="{{urgeItem.name}}">
              {{else if isEditable}}
              <button type="button" data-action="createItem" data-type="urge"
                      title="{{localize 'EX2E.AddUrge'}}">
                <i class="fa-solid fa-plus"></i>
              </button>
              {{else}}
              <span class="virtue-flaw-input virtue-flaw-empty">—</span>
              {{/if}}
            </div>
            <div class="virtue-flaw-input-group">
              <input type="text" class="virtue-flaw-input" name="system.splat.infernal.urge"
                     value="{{system.splat.infernal.urge}}"
                     placeholder="{{localize 'EX2E.SplatUrgePlaceholder'}}"
                     {{#unless isEditable}}readonly{{/unless}}>
            </div>
          </div>
          {{/if}}

          {{#if hasAfflictions}}
          <div class="afflictions-panel" style="grid-column: 1 / -1; margin-top: var(--ex2e-gap-sm);">
            <h2 class="section-header">{{localize "EX2E.AfflictionsHeader"}}</h2>
            {{#each afflictions as |aff|}}
            <div class="affliction-row" data-effect-id="{{aff.effectId}}">
              <span class="affliction-name">{{aff.name}}</span>
              {{#if (eq aff.kind "poison")}}<span class="affliction-intervals">{{aff.remainingIntervals}} {{localize "EX2E.AfflictionIntervalsLeft"}}</span>{{/if}}
              {{#if @root.isEditable}}
              <button type="button" class="btn-sm" data-action="advanceAffliction" data-effect-id="{{aff.effectId}}">{{localize "EX2E.AfflictionAdvance"}}</button>
              <button type="button" class="btn-sm" data-action="treatAffliction" data-effect-id="{{aff.effectId}}">{{localize "EX2E.AfflictionTreat"}}</button>
              <button type="button" class="btn-sm" data-action="removeAffliction" data-effect-id="{{aff.effectId}}" title="{{localize 'EX2E.Delete'}}">✕</button>
              {{/if}}
            </div>
            {{/each}}
          </div>
          {{/if}}
        </div>
      </section>

      {{!-- Column 2: Health --}}
      <section class="health-column">
        <div class="section-toolbar">
          <h2 class="section-header" style="margin:0;flex:1">{{localize "EX2E.HealthLevels"}}</h2>
        </div>
        {{healthTrack health=system.health exaltType=system.exaltType}}
        <div class="health-info">
          <span class="wound-penalty-label">{{localize "EX2E.WoundPenalty"}}:
            <strong>{{#if system.health.incapacitated}}Incapacitated{{else}}{{system.health.woundPenalty}}{{/if}}</strong>
          </span>
          <span class="damage-tally">
            <span class="dmg-bashing">{{system.health.bashing}}B</span> /
            <span class="dmg-lethal">{{system.health.lethal}}L</span> /
            <span class="dmg-aggravated">{{system.health.aggravated}}A</span>
          </span>
        </div>
        {{#if isEditable}}
        <div class="damage-controls">
          <button class="damage-btn bashing" data-action="applyDamage"
                  data-damage-type="bashing" data-amount="1">+1 Bashing</button>
          <button class="damage-btn lethal" data-action="applyDamage"
                  data-damage-type="lethal" data-amount="1">+1 Lethal</button>
          <button class="damage-btn aggravated" data-action="applyDamage"
                  data-damage-type="aggravated" data-amount="1">+1 Aggravated</button>
          <button class="damage-btn heal" data-action="healDamage"
                  data-amount="1">Heal 1</button>
        </div>
        {{/if}}
      </section>

      {{!-- Column 3: Anima (hidden for mortals) --}}
      {{#unless (eq system.exaltType "mortal")}}
      <section class="anima-column">
        <div class="section-toolbar">
          <h2 class="section-header" style="margin:0;flex:1">{{localize "EX2E.Anima"}}</h2>
          {{#each greaterSigns as |gs|}}
            <button type="button"
                    class="greater-sign-btn{{#if gs.active}} active{{/if}}"
                    data-action="activateGreaterSign"
                    data-item-id="{{gs.id}}"
                    title="{{gs.name}}">
              <i class="fa-solid {{gs.icon}}"></i>
            </button>
          {{/each}}
          {{#if canEditAnimaColors}}
            <button type="button" class="anima-color-btn" data-action="configureAnimaColors"
                    title="{{localize 'EX2E.AnimaColorConfigure'}}">
              <i class="fa-solid fa-palette"></i>
            </button>
          {{/if}}
        </div>
        <div class="anima-tier anima-tier--{{system.anima}}">
          {{animaLabel}}
          
        </div>

        <div class="anima-scene-peripheral">
          <span class="anima-label">{{localize "EX2E.ScenePeripheralSpend"}}</span>
          <div class="anima-nudge-row">
            {{#if isGM}}
            <button type="button" data-action="nudgeScenePeripheral" data-delta="-1" class="anima-nudge-btn">−</button>
            {{/if}}
            <span class="anima-counter">{{system.scenePeripheral}}</span>
            {{#if isGM}}
            <button type="button" data-action="nudgeScenePeripheral" data-delta="1" class="anima-nudge-btn">+</button>
            {{/if}}
          </div>
          {{#if isGM}}
          <button type="button" data-action="endScene" class="anima-end-scene-btn">{{localize "EX2E.EndScene"}}</button>
          {{/if}}
          {{#if isEditable}}
          <button type="button" data-action="morningRest" class="anima-end-scene-btn">{{localize "EX2E.MorningRest"}}</button>
          {{/if}}
        </div>

        {{#if dbFluxInfo}}
        <div class="anima-flux-note">
          <i class="fa-solid fa-bolt"></i>
          {{#if (eq dbFluxInfo.tier "totemic")}}
            {{localize "EX2E.DBFluxIntervalTotemic"}}
          {{else}}
            {{localize "EX2E.DBFluxInterval" interval=dbFluxInfo.interval}}
          {{/if}}
        </div>
        {{/if}}

        {{#if animaPower}}
        <div class="anima-power-row">
          <span class="anima-power-summary">{{animaPower.system.summary}}</span>
          <div class="anima-power-controls">
            <span class="anima-power-dot {{#if animaPower.system.active}}active{{/if}}"></span>
            <button type="button"
                    data-action="activateAnimaPower"
                    data-item-id="{{animaPower.id}}"
                    class="anima-power-btn {{#if animaPower.system.active}}is-active{{/if}}"
                    {{#unless isEditable}}disabled{{/unless}}>
              {{#if animaPower.system.active}}
                {{localize "EX2E.AnimaPowerDeactivate"}}
              {{else}}
                {{localize "EX2E.AnimaPowerActivate"}}
              {{/if}}
            </button>
            <button type="button"
                    data-action="viewAnimaPower"
                    data-item-id="{{animaPower.id}}"
                    class="anima-power-details-btn"
                    title="{{localize 'EX2E.AnimaPowerViewDetails'}}">?</button>
          </div>
        </div>
        {{/if}}
      </section>
      {{/unless}}

      {{!-- Crippling Injuries (full-width row below all three columns) --}}
      {{#if (or isEditable (gt system.cripplingInjuries.length 0))}}
      <section class="crippling-injuries-section">
        <div class="section-toolbar">
          <h2 class="section-header" style="margin:0;flex:1">{{localize "EX2E.CripplingInjuries"}}</h2>
          {{#if isEditable}}
          <button type="button" class="section-header-btn" data-action="addCripplingInjury"
                  title="{{localize 'EX2E.CripplingInjuryAdd'}}">
            <i class="fa-solid fa-plus"></i>
          </button>
          {{/if}}
        </div>
        {{#if system.cripplingInjuries.length}}
        <ul class="injury-list">
          {{#each system.cripplingInjuries as |inj i|}}
          <li class="injury-row">
            <span class="injury-type">{{lookup @root.cripplingInjuryTypes inj.type}}</span>
            {{#if inj.description}}<span class="injury-desc">{{inj.description}}</span>{{/if}}
            <span class="injury-penalty">−{{inj.penalty}}</span>
            {{#if @root.isEditable}}
            <button type="button" class="injury-heal-btn" data-action="deleteCripplingInjury" data-index="{{i}}"
                    title="{{localize 'EX2E.CripplingInjuryHeal'}}">
              <i class="fa-solid fa-heart-pulse"></i>
            </button>
            {{/if}}
          </li>
          {{/each}}
        </ul>
        {{else}}
        <p class="injury-empty">{{localize "EX2E.CripplingInjuryNone"}}</p>
        {{/if}}
      </section>
      {{/if}}

    </div>

    <!-- ═══════════════ SPLAT-SPECIFIC TRAITS ═══════════════ -->
    {{> "systems/exalted2e/templates/actor/character/_splat.hbs"}}

  </div><!-- .sheet-body -->
</div><!-- .tab -->
