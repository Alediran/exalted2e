<div class="tab {{cssClass}}" data-tab="tabCharms" data-group="sheet">
  <div class="sheet-body">


    {{#if (eq system.exaltType "alchemical")}}
    <div class="module-slots">
      <div>
        <label>{{localize "EX2E.SlotDedicated"}}</label>
        {{dotRating name="" value=system.dedicatedSlotsUsed max=system.splat.alchemical.dedicatedSlots min=0}}
      </div>
      {{#if isEditable}}
      <button type="button" data-action="addDedicatedSlot"
              title="{{localize 'EX2E.SlotAddDedicated'}}">
        {{localize "EX2E.SlotAddDedicated"}}
      </button>
      <button type="button" data-action="upgradeSlot"
              {{#unless (gt system.splat.alchemical.dedicatedSlots 0)}}disabled{{/unless}}
              title="{{localize 'EX2E.SlotUpgrade'}}">
        {{localize "EX2E.SlotUpgrade"}}
      </button>
      <button type="button" data-action="addGeneralSlot"
              title="{{localize 'EX2E.SlotAddGeneral'}}">
        {{localize "EX2E.SlotAddGeneral"}}
      </button>
      {{/if}}
      <div>
        <label>{{localize "EX2E.SlotGeneral"}}</label>
        {{dotRating name="" value=system.generalSlotsUsed max=system.splat.alchemical.generalSlots min=0}}        
      </div>
    </div>
    {{/if}}

    <div class="section-toolbar">
      <h2 class="section-header" style="margin:0;flex:1">{{localize "EX2E.TabCharms"}}</h2>
      {{#if isEditable}}
      <button class="btn-add-item" data-action="createItem" data-type="charm"
              data-exalt-type="{{system.exaltType}}"
              title="{{localize 'EX2E.AddCharm'}}">
        <i class="fa-solid fa-plus"></i> {{localize "EX2E.AddCharm"}}
      </button>
      {{/if}}
    </div>

    {{#if charms.length}}
    {{#each charmGroups as |group|}}
    <details class="charm-group" data-group-key="charm:{{group.key}}" open>
    <summary class="charm-group-header">
      {{group.label}}
      {{#if isEditable}}{{#if (eq @root.system.exaltType "infernal")}}
      <button type="button" class="btn-add-item charm-group-add"
              data-action="createItem" data-type="charm"
              data-exalt-type="{{@root.system.exaltType}}"
              data-yozi-patron="{{group.key}}"
              title="{{localize 'EX2E.AddCharm'}}">
        <i class="fa-solid fa-plus"></i>
      </button>
      {{/if}}{{/if}}
    </summary>
    <div class="charms-list">
      {{#each group.charms as |charm|}}
      <div class="charm-row item-row {{#if charm.system.active}}charm-active{{/if}}"
           data-item-id="{{charm.id}}">
        <img class="item-img" src="{{charm.img}}" alt="{{charm.name}}">
        <span class="item-name charm-name">
          {{#with (lookup @root.charmPrereqs charm.id) as |p|}}
            {{#if p.has}}
              {{#unless p.met}}
              <i class="fa-solid fa-triangle-exclamation charm-prereq-missing"
                 title="{{p.missing}}"></i>
              {{/unless}}
            {{/if}}
          {{/with}}
          {{#if (eq charm.system.excellency "first")}}
          <span class="charm-excellency-badge" title="{{localize 'EX2E.FirstExcellency'}}">I</span>
          {{else if (eq charm.system.excellency "second")}}
          <span class="charm-excellency-badge" title="{{localize 'EX2E.SecondExcellency'}}">II</span>
          {{else if (eq charm.system.excellency "third")}}
          <span class="charm-excellency-badge" title="{{localize 'EX2E.ThirdExcellency'}}">III</span>
          {{/if}}
          {{charm.name}}
          <span class="charm-meta">
            {{charm.system.cost.motes}}m
            {{#if charm.system.cost.willpower}}+{{charm.system.cost.willpower}}wp{{/if}}
            · {{charm.system.duration}}
            {{#if (eq @root.system.exaltType "alchemical")}}{{#if charm.system.installed}}{{#if charm.system.essenceCommitment}}<span class="charm-commit">[{{charm.system.essenceCommitment}}m]</span>{{/if}}{{/if}}{{/if}}
          </span>
        </span>
        <!-- Keywords -->
        {{#if charm.system.keywords.length}}
        <span class="charm-keywords">
          {{#each charm.system.keywords as |kw|}}
          <span class="keyword-tag">{{kw}}</span>
          {{/each}}
        </span>
        {{/if}}
        <div class="item-controls">
          {{#if (eq @root.system.exaltType "alchemical")}}
            {{#if this.system.installed}}
            <button type="button" data-action="uninstallCharm" data-charm-id="{{this.id}}"
                    title="{{localize 'EX2E.Uninstall'}}">⊖</button>
            {{else}}
            <button type="button" data-action="installCharm" data-charm-id="{{this.id}}"
                    title="{{localize 'EX2E.Install'}} ({{this.system.essenceCommitment}}m)">⊕</button>
            {{/if}}
          {{/if}}
          {{#if (eq @root.system.exaltType "alchemical")}}
          {{#if charm.system.installed}}
          {{#if @root.isEditable}}
          <button type="button" data-action="createSubmodule"
                  data-charm-id="{{charm.id}}"
                  title="{{localize 'EX2E.AddSubmodule'}}">
            <i class="fa-solid fa-plus"></i>
          </button>
          {{/if}}
          {{/if}}
          {{/if}}
          {{#if charm.system.healingRoll.enabled}}
          <button type="button" data-action="rollHealingCharm"
                  title="{{localize 'EX2E.RollHeal'}}">
            <i class="fa-solid fa-heart-pulse"></i>
          </button>
          {{/if}}
          <button type="button" data-action="activateCharm" title="{{localize 'EX2E.ActivateCharm'}}">⚡</button>
          <button data-action="sendItemToChat" title="{{localize 'EX2E.SendToChat'}}">💬</button>
          {{#if @root.isEditable}}
          <button data-action="editItem"   title="Edit">✏️</button>
          <button data-action="deleteItem" title="Delete">🗑</button>
          {{/if}}
        </div>
      </div>
      {{#with (lookup @root.submodulesByParent charm.id) as |subs|}}
      {{#if subs.length}}
      <div class="submodule-list">
        {{#each subs as |sub|}}
        <div class="submodule-row {{#unless sub.system.effectivelyActive}}submodule-inactive{{/unless}}"
             data-item-id="{{sub.id}}">
          <span class="submodule-name">
            {{#unless sub.system.requirementsMet}}
            <i class="fa-solid fa-triangle-exclamation charm-prereq-missing"
               title="{{localize 'EX2E.SubmoduleReqNotMet'}}"></i>
            {{/unless}}
            {{#unless sub.system.parentInstalled}}
            <i class="fa-solid fa-circle-minus charm-prereq-missing"
               title="{{localize 'EX2E.SubmoduleParentNotInstalled'}}"></i>
            {{/unless}}
            {{sub.name}}
            {{#if sub.system.cost.motes}}
            <span class="charm-meta">
              {{sub.system.cost.motes}}m
              {{#if sub.system.cost.willpower}}+{{sub.system.cost.willpower}}wp{{/if}}
            </span>
            {{/if}}
          </span>
          <div class="item-controls">
            {{#unless (eq sub.system.charmType "permanent")}}
            <button data-action="activateCharm" title="{{localize 'EX2E.ActivateCharm'}}"
                    {{#unless sub.system.effectivelyActive}}disabled{{/unless}}>⚡</button>
            {{/unless}}
            <button data-action="sendItemToChat" title="{{localize 'EX2E.SendToChat'}}">💬</button>
            {{#if @root.isEditable}}
            <button data-action="editItem"   title="Edit">✏️</button>
            <button data-action="deleteItem" title="Delete">🗑</button>
            {{/if}}
          </div>
        </div>
        {{/each}}
      </div>
      {{/if}}
      {{/with}}
      {{/each}}
    </div>
    </details>
    {{/each}}
    {{#with (lookup submodulesByParent "__orphan__") as |orphans|}}
    {{#if orphans.length}}
    <div class="section-toolbar" style="margin-top:16px">
      <h2 class="section-header" style="margin:0;flex:1">{{localize "EX2E.OrphanedSubmodules"}}</h2>
    </div>
    <div class="charms-list">
      {{#each orphans as |sub|}}
      <div class="charm-row item-row submodule-inactive" data-item-id="{{sub.id}}">
        <img class="item-img" src="{{sub.img}}" alt="{{sub.name}}">
        <span class="item-name charm-name">
          <i class="fa-solid fa-triangle-exclamation charm-prereq-missing"></i>
          {{sub.name}}
        </span>
        <div class="item-controls">
          {{#if @root.isEditable}}
          <button data-action="editItem"   title="Edit">✏️</button>
          <button data-action="deleteItem" title="Delete">🗑</button>
          {{/if}}
        </div>
      </div>
      {{/each}}
    </div>
    {{/if}}
    {{/with}}
    {{else}}
    <p class="empty-msg">{{localize "EX2E.NoCharms"}}</p>
    {{/if}}

    {{!-- Sorcery / Necromancy section — shown per tradition. --}}
    {{#each spellSections as |section|}}
    <div class="section-toolbar spell-section-toolbar" style="margin-top:16px">
      <div class="spell-section-title-group">
        <h2 class="section-header" style="margin:0">{{section.label}}</h2>
        <label class="spell-initiation-label">
          <span>{{section.initiationLabel}}</span>
          {{dotRating value=section.initiation max=section.initiationMax min=0 readonly=true}}
        </label>
      </div>
      {{#if @root.isEditable}}
      <button class="btn-add-item" data-action="createItem" data-type="spell"
              data-tradition="{{section.tradition}}"
              title="{{localize 'EX2E.AddSpell'}}">
        <i class="fa-solid fa-plus"></i> {{localize "EX2E.AddSpell"}}
      </button>
      {{/if}}
    </div>

    {{#if section.groups.length}}
    {{#each section.groups as |group|}}
    <details class="charm-group" data-group-key="spell:{{section.tradition}}:{{group.circle}}" open>
    <summary class="charm-group-header">{{group.label}}</summary>
    <div class="charms-list">
      {{#each group.spells as |spell|}}
      <div class="charm-row item-row" data-item-id="{{spell.id}}">
        <img class="item-img" src="{{spell.img}}" alt="{{spell.name}}">
        <span class="item-name charm-name">
          {{#with (lookup @root.spellInitStatus spell.id) as |s|}}
            {{#unless s.ok}}
            <i class="fa-solid fa-triangle-exclamation charm-prereq-missing"
               title="{{localize 'EX2E.SpellInitiationMissing'}}"></i>
            {{/unless}}
          {{/with}}
          {{spell.name}}
          <span class="charm-meta">
            {{spell.system.cost.motes}}m
            {{#if spell.system.cost.willpower}}+{{spell.system.cost.willpower}}wp{{/if}}
            · {{spell.system.duration}}
          </span>
        </span>
        <div class="item-controls">
          {{#with (lookup @root.spellCastButton spell.id) as |b|}}
          <button data-action="activateCharm"
                  title="{{localize 'EX2E.CastSpell'}}"
                  {{#unless b.enabled}}disabled{{/unless}}
                  {{#if b.tooltip}}data-tooltip="{{b.tooltip}}"{{/if}}>⚡</button>
          {{else}}
          <button data-action="activateCharm" title="{{localize 'EX2E.CastSpell'}}">⚡</button>
          {{/with}}
          <button data-action="sendItemToChat" title="{{localize 'EX2E.SendToChat'}}">💬</button>
          {{#if @root.isEditable}}
          <button data-action="editItem"   title="Edit">✏️</button>
          <button data-action="deleteItem" title="Delete">🗑</button>
          {{/if}}
        </div>
      </div>
      {{/each}}
    </div>
    </details>
    {{/each}}
    {{else}}
    <p class="empty-msg">{{localize "EX2E.NoSpells"}}</p>
    {{/if}}
    {{/each}}

    {{!-- Knacks section (Lunar only) --}}
    {{#if isLunar}}
    <div class="section-toolbar" style="margin-top:16px">
      <h2 class="section-header" style="margin:0;flex:1">{{localize "EX2E.Knacks"}}</h2>
      {{#if isEditable}}
      <button class="btn-add-item" data-action="createItem" data-type="knack"
              title="{{localize 'EX2E.AddKnack'}}">
        <i class="fa-solid fa-plus"></i> {{localize "EX2E.AddKnack"}}
      </button>
      {{/if}}
    </div>

    {{#if knacks.length}}
    <div class="charms-list">
      {{#each knacks as |knack|}}
      <div class="charm-row item-row" data-item-id="{{knack.id}}">
        <img class="item-img" src="{{knack.img}}" alt="{{knack.name}}">
        <span class="item-name charm-name">
          {{knack.name}}
          <span class="charm-meta">
            {{localize "EX2E.Essence"}} {{knack.system.essence}}
          </span>
        </span>
        {{#if knack.system.keywords.length}}
        <span class="charm-keywords">
          {{#each knack.system.keywords as |kw|}}
          <span class="keyword-tag">{{kw}}</span>
          {{/each}}
        </span>
        {{/if}}
        <div class="item-controls">
          <button data-action="sendItemToChat" title="{{localize 'EX2E.SendToChat'}}">💬</button>
          {{#if ../isEditable}}
          <button data-action="editItem" title="Edit">✏️</button>
          <button data-action="deleteItem" title="Delete">🗑</button>
          {{/if}}
        </div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <p class="empty-msg">{{localize "EX2E.NoKnacks"}}</p>
    {{/if}}
    {{/if}}

    {{!-- Combos (errata edition) — saved charm packets. --}}
    <div class="section-toolbar" style="margin-top:16px">
      <h2 class="section-header" style="margin:0;flex:1">{{localize "EX2E.Combos"}}</h2>
      {{#if isEditable}}
      <button class="btn-add-item" data-action="createItem" data-type="combo"
              title="{{localize 'EX2E.AddCombo'}}">
        <i class="fa-solid fa-plus"></i> {{localize "EX2E.AddCombo"}}
      </button>
      {{/if}}
    </div>

    {{#if combos.length}}
    <div class="charms-list">
      {{#each combos as |combo|}}
      <div class="charm-row item-row combo-row" data-item-id="{{combo.id}}">
        <img class="item-img" src="{{combo.img}}" alt="{{combo.name}}">
        <span class="item-name charm-name">
          {{combo.name}}
          <span class="charm-meta">
            {{#if combo.costPreview}}{{combo.costPreview}} · {{/if}}
            {{combo.totalCount}} {{localize "EX2E.Charms"}}
            {{#if combo.missingCount}}
              · <i class="fa-solid fa-triangle-exclamation charm-prereq-missing"
                   title="{{localize 'EX2E.ComboBroken'}}"></i> {{combo.missingCount}}
            {{/if}}
          </span>
        </span>
        <span class="charm-keywords combo-icon-strip">
          {{#each combo.iconStrip as |c|}}
          <img class="combo-strip-img" src="{{c.img}}" alt="{{c.name}}" title="{{c.name}}">
          {{/each}}
        </span>
        <div class="item-controls">
          <button data-action="activateCombo"
                  {{#unless combo.canActivate}}disabled{{/unless}}
                  title="{{localize 'EX2E.ComboActivate'}}">⚡</button>
          <button data-action="sendItemToChat" title="{{localize 'EX2E.SendToChat'}}">💬</button>
          {{#if @root.isEditable}}
          <button data-action="editItem"   title="Edit">✏️</button>
          <button data-action="deleteItem" title="Delete">🗑</button>
          {{/if}}
        </div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <p class="empty-msg">{{localize "EX2E.NoCombos"}}</p>
    {{/if}}

  </div>
</div>
