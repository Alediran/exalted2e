<div class="tab {{cssClass}}" data-tab="tabCombat" data-group="sheet">
  <div class="sheet-body">

    <!-- ═══════════════ DERIVED COMBAT STATS ═══════════════ -->
    <h2 class="section-header">{{localize "EX2E.CombatStats"}}</h2>
    <div class="combat-stat-grid">
      <div class="stat-item">
        <span class="stat-label">{{localize "EX2E.DodgeDV"}}</span>
        <span class="stat-value">{{system.dodgeDV}}</span>
      </div>
      <div class="stat-item">
        <span class="stat-label">{{localize "EX2E.DodgeMDV"}}</span>
        <span class="stat-value">{{system.dodgeMDV}}</span>
      </div>
      <div class="stat-item">
        <span class="stat-label">{{localize "EX2E.ParryMDV"}}</span>
        <span class="stat-value">{{system.parryMDV.best}}</span>
      </div>
      <div class="stat-item">
        <span class="stat-label">{{localize "EX2E.JoinBattle"}}</span>
        <span class="stat-value">
          <button class="roll-btn" data-action="rollPool"
                  data-pool="{{system.joinBattle}}"
                  data-flavor="{{localize 'EX2E.JoinBattle'}}">{{system.joinBattle}}⚄</button>
        </span>
      </div>
      <div class="stat-item">
        <span class="stat-label">{{localize "EX2E.Movement"}}</span>
        <span class="stat-value">{{system.movement}}</span>
      </div>
      <div class="stat-item">
        <span class="stat-label">{{localize "EX2E.Dash"}}</span>
        <span class="stat-value">{{system.dash}}</span>
      </div>
    </div>

    <!-- ═══════════════ SOAK ═══════════════ -->
    <h2 class="section-header">{{localize "EX2E.Soak"}}</h2>
    <div class="soak-grid">
      <div class="soak-row">
        <span class="soak-label">Bashing Soak:</span>
        <strong>{{system.totalSoak.bashing}}</strong>
        <span class="soak-natural">({{system.naturalSoak.bashing}} natural)</span>
      </div>
      <div class="soak-row">
        <span class="soak-label">Lethal Soak:</span>
        <strong>{{system.totalSoak.lethal}}</strong>
        <span class="soak-natural">({{system.naturalSoak.lethal}} natural)</span>
      </div>
      <div class="soak-row">
        <span class="soak-label">Aggravated Soak:</span>
        <strong>{{system.totalSoak.aggravated}}</strong>
      </div>
      {{#if system.hardness}}
      <div class="soak-row">
        <span class="soak-label">Hardness:</span>
        <strong>{{system.hardness}}</strong>
      </div>
      {{/if}}
      {{#if system.armorName}}
      <div class="soak-row">
        <span class="soak-label">Armor:</span>
        <em>{{system.armorName}}</em>
        {{#if system.mobilityPenalty}}
        <span class="penalty">Mobility {{system.mobilityPenalty}}</span>
        {{/if}}
      </div>
      {{/if}}
    </div>

    <!-- ═══════════════ SOCIAL ATTACK ═══════════════ -->
    <div class="action-button-row">
      <button type="button" data-action="rollSocialAttack">
        <i class="fa-solid fa-comments"></i> {{localize "EX2E.SocialAttack"}}
      </button>
    </div>

    <!-- ═══════════════ EQUIPPED WEAPONS ═══════════════ -->
    <h2 class="section-header">{{localize "EX2E.Weapons"}}</h2>
    {{#if system.equippedWeapons.length}}
    <table class="weapon-table">
      <thead>
        <tr>
          <th>Name</th><th>Spd</th><th>Acc</th><th>Dmg</th><th>Def</th><th>Rate</th><th></th>
        </tr>
      </thead>
      <tbody>
        {{#each system.equippedWeapons as |w|}}
        <tr data-weapon-id="{{w.id}}" data-mode-index="{{w.modeIndex}}">
          <td>{{w.name}}</td>
          <td>{{w.speed}}</td>
          <td>{{w.accuracy}}</td>
          <td>{{w.damage}}</td>
          <td>{{w.defense}}</td>
          <td>{{w.rate}}</td>
          <td>
            <button class="roll-btn" data-action="rollAttack"
                    title="{{localize 'EX2E.AttackRoll'}}">⚔</button>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p class="empty-msg"><em>No weapons equipped.</em></p>
    {{/if}}

    {{!-- 3c-2: Active Motivation Campaigns --}}
    {{#if showMotivationCampaigns}}
    <h2 class="section-header">{{localize "EX2E.MotivationBreakSheetSectionTitle"}}</h2>
    <section class="motivation-break-campaigns">

      {{#if motivationCampaignsTargetingMe.length}}
      <h3>{{localize "EX2E.MotivationBreakSheetSectionTargetedAtMe"}}</h3>
      <ul>
      {{#each motivationCampaignsTargetingMe}}
        <li class="campaign-row campaign-status-{{this.status}}">
          <strong>{{this.otherActorName}}</strong> &rarr;
          "<em>{{this.targetMotivation}}</em>"
          <span class="campaign-stats">
            {{this.attemptsLabel}} &middot; {{this.permWpLabel}} &middot;
            {{#if (eq this.status "active")}}{{localize "EX2E.MotivationBreakStatusActive"}}{{/if}}
            {{#if (eq this.status "broken")}}{{localize "EX2E.MotivationBreakStatusBroken"}}{{/if}}
            {{#if (eq this.status "abandoned")}}{{localize "EX2E.MotivationBreakStatusAbandoned"}}{{/if}}
          </span>
        </li>
      {{/each}}
      </ul>
      {{/if}}

      {{#if motivationCampaignsImRunning.length}}
      <h3>{{localize "EX2E.MotivationBreakSheetSectionImRunning"}}</h3>
      <ul>
      {{#each motivationCampaignsImRunning}}
        <li class="campaign-row campaign-status-{{this.status}}">
          <strong>{{this.otherActorName}}</strong> &rarr;
          "<em>{{this.targetMotivation}}</em>"
          <span class="campaign-stats">
            {{this.attemptsLabel}} &middot; {{this.permWpLabel}} &middot;
            {{#if (eq this.status "active")}}{{localize "EX2E.MotivationBreakStatusActive"}}{{/if}}
            {{#if (eq this.status "broken")}}{{localize "EX2E.MotivationBreakStatusBroken"}}{{/if}}
            {{#if (eq this.status "abandoned")}}{{localize "EX2E.MotivationBreakStatusAbandoned"}}{{/if}}
          </span>
          {{#if (eq this.status "active")}}
          {{#if ../isGM}}
          <button type="button"
                  data-action="abandonMotivationCampaign"
                  data-defender-id="{{this.defenderId}}">
            {{localize "EX2E.MotivationBreakAbandonButton"}}
          </button>
          {{/if}}
          {{/if}}
        </li>
      {{/each}}
      </ul>
      {{/if}}

    </section>
    {{/if}}

  </div><!-- .sheet-body -->
</div><!-- .tab -->
