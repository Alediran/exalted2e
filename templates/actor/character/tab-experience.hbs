<div class="tab {{cssClass}}" data-tab="tabExperience" data-group="sheet">
  <div class="sheet-body">

    <h2 class="section-header">{{localize "EX2E.Experience"}}</h2>
    <div class="xp-tracker">
      <div class="field-group">
        <label>{{localize "EX2E.CurrentXP"}}</label>
        <input type="number" name="system.experience.value"
               value="{{system.experience.value}}" min="0"
               {{#unless canEditXp}}readonly{{/unless}}>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.TotalXPEarned"}}</label>
        <input type="number" name="system.experience.total"
               value="{{system.experience.total}}" min="0"
               {{#unless canEditXp}}readonly{{/unless}}>
      </div>
    </div>

    <h2 class="section-header" style="margin-top:16px">{{localize "EX2E.PurchaseLog"}}</h2>
    {{#if purchaseLogRows.length}}
    <table class="purchase-log-table">
      <thead>
        <tr>
          <th>{{localize "EX2E.PurchaseLogDate"}}</th>
          <th>{{localize "EX2E.PurchaseLogTrait"}}</th>
          <th>{{localize "EX2E.PurchaseLogChange"}}</th>
          <th>{{localize "EX2E.PurchaseLogXP"}}</th>
          <th>{{localize "EX2E.PurchaseLogNote"}}</th>
          {{#if canEditXp}}<th></th>{{/if}}
        </tr>
      </thead>
      <tbody>
        {{#each purchaseLogRows as |row|}}
        <tr>
          <td>{{row.dateText}}</td>
          <td>{{row.traitLabel}}</td>
          <td>{{row.oldValue}} → {{row.newValue}}</td>
          <td class="{{#if row.overdraft}}xp-overdraft{{/if}}">{{row.xpCost}}</td>
          <td>{{row.note}}</td>
          {{#if @root.canEditXp}}
          <td class="purchase-log-actions">
            <div class="item-controls">
              <button type="button" data-action="editPurchaseEntry" data-index="{{row.index}}"
                      title="{{localize 'EX2E.Edit'}}">✏️</button>
              <button type="button" data-action="deletePurchaseEntry" data-index="{{row.index}}"
                      title="{{localize 'EX2E.Delete'}}">🗑</button>
            </div>
          </td>
          {{/if}}
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p class="empty-msg">{{localize "EX2E.PurchaseLogEmpty"}}</p>
    {{/if}}

    <!-- XP Cost Reference Table -->
    <h2 class="section-header" style="margin-top:20px">{{localize "EX2E.XPCosts"}}</h2>
    <table class="xp-table">
      <thead><tr><th>Trait</th><th>Caste/Favoured</th><th>Other</th></tr></thead>
      <tbody>
        <tr><td>Attribute</td><td>4×new rating</td><td>4×new rating</td></tr>
        <tr><td>Ability</td><td>1×new rating</td><td>2×new rating</td></tr>
        <tr><td>Speciality</td><td>1</td><td>2</td></tr>
        <tr><td>Charm</td><td>8</td><td>10</td></tr>
        <tr><td>Virtue</td><td colspan="2">3×new rating</td></tr>
        <tr><td>Willpower</td><td colspan="2">2×new rating</td></tr>
        <tr><td>Essence</td><td colspan="2">7×new rating</td></tr>
        <tr><td>Background</td><td colspan="2">3×new rating</td></tr>
        <tr><td>Spell</td><td>8 (terrestrial) / 10 (celestial) / 12 (solar)</td><td>same</td></tr>
      </tbody>
    </table>

  </div>
</div>
