<div class="tab tab-crafting {{cssClass}}" data-tab="tabCrafting" data-group="sheet">
  <div class="sheet-body">

    <!-- ═══════════════ CRAFT ABILITIES ═══════════════ -->
    <div class="craft-abilities-section">
      <div class="crafting-header">
        <h2 class="section-header">{{localize "EX2E.CraftAbilities"}}</h2>
        {{#if @root.isEditable}}
        <button type="button" data-action="addCraftVariant" class="btn-add-project">
          <i class="fa-solid fa-plus"></i>
          {{localize "EX2E.CraftVariantAdd"}}
        </button>
        {{/if}}
      </div>

      {{#each craftAbilities as |ca|}}
      <div class="item-row craft-ability-row">
        <input type="text"
               name="{{ca.namePath}}"
               value="{{ca.name}}"
               class="craft-variant-name"
               placeholder="{{#if ca.isBase}}{{localize 'EX2E.CraftBaseNamePlaceholder'}}{{else}}{{localize 'EX2E.CraftVariantNamePlaceholder'}}{{/if}}"
               {{#unless @root.isEditable}}disabled{{/unless}}>
        {{dotRating name=ca.valuePath value=ca.value max=5 min=0}}
        <div class="item-controls">
          <button type="button"
                  data-action="rollCraftVariant"
                  data-variant-index="{{ca.variantIndex}}"
                  title="{{localize 'EX2E.CraftingRoll'}}">
            <i class="fa-solid fa-dice"></i>
          </button>
          {{#unless ca.isBase}}
          {{#if @root.isEditable}}
          <button type="button"
                  data-action="deleteCraftVariant"
                  data-variant-index="{{ca.variantIndex}}">
            <i class="fa-solid fa-trash"></i>
          </button>
          {{/if}}
          {{/unless}}
        </div>
      </div>
      {{/each}}
    </div>

    <div class="crafting-header">
      <h2 class="section-header">{{localize "EX2E.CraftingProjectsHeader"}}</h2>
      {{#if @root.isEditable}}
      <button type="button" data-action="addCraftingProject" class="btn-add-project">
        <i class="fa-solid fa-hammer"></i>
        {{localize "EX2E.CraftingNewProject"}}
      </button>
      {{/if}}
    </div>

    {{#if craftingProjects.length}}
    <table class="crafting-table">
      <thead>
        <tr>
          <th>{{localize "EX2E.CraftingProjectName"}}</th>
          <th>{{localize "EX2E.CraftingProjectSize"}}</th>
          <th>{{localize "EX2E.CraftingProjectDiff"}}</th>
          <th>{{localize "EX2E.CraftingProjectBonus"}}</th>
          <th>{{localize "EX2E.CraftWorkshop"}}</th>
          <th>{{localize "EX2E.CraftAssistants"}}</th>
          <th>{{localize "EX2E.CraftingProjectStatus"}}</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each craftingProjects as |p|}}
        <tr class="crafting-project-row crafting-status-{{p.status}}">
          <td class="project-name">
            {{p.name}}
            {{#if p.isPerfect}}<em>({{localize "EX2E.CraftingPerfect"}})</em>{{/if}}
          </td>
          <td>{{p.sizeLabel}}</td>
          <td>{{p.difficulty}}</td>
          <td>{{#if (eq p.status "active")}}{{p.bonusDice}}{{else}}—{{/if}}</td>
          <td class="craft-workshop-cell">
            {{p.workshopLabel}} ({{#if (gte p.workshopMod 0)}}+{{/if}}{{p.workshopMod}})
            {{#if p.wordsAsWorkshop}}<span class="craft-waiver-badge" title="{{p.waiverName}}">★</span>{{/if}}
          </td>
          <td class="craft-assist-cell">{{#if p.assistantBonus}}+{{p.assistantBonus}}{{else}}—{{/if}}</td>
          <td><span class="status-text">{{p.statusLabel}}</span></td>
          <td class="crafting-row-actions">
            {{#if (eq p.status "active")}}
            {{#if @root.isEditable}}
            <button type="button" data-action="rollCraftingProject" data-project-id="{{p.id}}"
              class="btn-roll-project" title="{{localize 'EX2E.CraftingRoll'}}">
              <i class="fa-solid fa-dice"></i>
            </button>
            {{/if}}
            {{/if}}
            {{#if @root.isEditable}}
            <button type="button" data-action="deleteCraftingProject" data-project-id="{{p.id}}"
              class="btn-delete-project" title="{{localize 'EX2E.Delete'}}">
              <i class="fa-solid fa-times"></i>
            </button>
            {{/if}}
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p class="crafting-empty">{{localize "EX2E.CraftingNoProjects"}}</p>
    {{/if}}

    <!-- Artifact Projects -->
    <div class="crafting-header crafting-header-artifact">
      <h2 class="section-header">{{localize "EX2E.ArtifactCrafting"}}</h2>
      {{#if @root.isEditable}}
      <button type="button" data-action="addArtifactProject" class="btn-add-project">
        <i class="fa-solid fa-gem"></i>
        {{localize "EX2E.ArtifactNewProject"}}
      </button>
      {{/if}}
    </div>

    {{#if artifactProjects.length}}
    <table class="crafting-table artifact-table">
      <thead>
        <tr>
          <th>{{localize "EX2E.ArtifactProjectName"}}</th>
          <th>{{localize "EX2E.ArtifactRating"}}</th>
          <th>{{localize "EX2E.ArtifactMaterial"}}</th>
          <th>{{localize "EX2E.ArtifactProgressShort"}}</th>
          <th>{{localize "EX2E.ArtifactSeasons"}}</th>
          <th>{{localize "EX2E.CraftWorkshop"}}</th>
          <th>{{localize "EX2E.CraftAssistants"}}</th>
          <th>{{localize "EX2E.CraftingProjectStatus"}}</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each artifactProjects as |p|}}
        <tr class="crafting-project-row crafting-status-{{p.status}}">
          <td class="project-name">{{p.name}}</td>
          <td>{{p.rating}}</td>
          <td>
            {{#if p.material}}
              {{p.material}}
              {{#if p.hasIngredients}}
                <i class="fa-solid fa-gem" style="color:gold" title="{{localize 'EX2E.ArtifactIngredientsObtained'}}"></i>
              {{else}}
                <i class="fa-regular fa-gem" title="{{localize 'EX2E.ArtifactIngredientsMissing'}}"></i>
              {{/if}}
            {{else}}—{{/if}}
          </td>
          <td class="artifact-progress">{{p.currentSuccesses}} / {{p.targetSuccesses}}</td>
          <td>{{p.seasonsElapsed}}</td>
          <td class="craft-workshop-cell">
            {{p.workshopLabel}} ({{#if (gte p.workshopMod 0)}}+{{/if}}{{p.workshopMod}})
            {{#if p.wordsAsWorkshop}}<span class="craft-waiver-badge" title="{{p.waiverName}}">★</span>{{/if}}
          </td>
          <td class="craft-assist-cell">{{#if p.assistantBonus}}+{{p.assistantBonus}}{{else}}—{{/if}}</td>
          <td><span class="status-text">{{p.statusLabel}}</span></td>
          <td class="crafting-row-actions">
            {{#if (eq p.status "active")}}
            {{#if @root.isEditable}}
            <button type="button" data-action="toggleArtifactIngredients" data-project-id="{{p.id}}"
              class="btn-toggle-ingredients"
              title="{{localize 'EX2E.ArtifactToggleIngredients'}}">
              <i class="fa-solid fa-gem"></i>
            </button>
            <button type="button" data-action="rollArtifactProject" data-project-id="{{p.id}}"
              class="btn-roll-project" title="{{localize 'EX2E.ArtifactRoll'}}">
              <i class="fa-solid fa-dice"></i>
            </button>
            {{/if}}
            {{/if}}
            {{#if @root.isEditable}}
            <button type="button" data-action="deleteArtifactProject" data-project-id="{{p.id}}"
              class="btn-delete-project" title="{{localize 'EX2E.Delete'}}">
              <i class="fa-solid fa-times"></i>
            </button>
            {{/if}}
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p class="crafting-empty">{{localize "EX2E.ArtifactNoProjects"}}</p>
    {{/if}}

  </div>
</div>
