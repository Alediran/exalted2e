<div class="tab {{cssClass}}" data-tab="tabMartialArts" data-group="sheet">
  <div class="sheet-body">

    {{#if maStyles.length}}
    {{#each maStyles as |style|}}
    <details class="charm-group ma-style-group" data-group-key="ma:{{style.item.id}}" open>
      <summary class="charm-group-header">
        <img class="item-img" src="{{style.item.img}}" alt="{{style.item.name}}">
        <span class="ma-style-name">{{style.item.name}}</span>
        <span class="keyword-tag ma-tier-badge">{{style.item.system.tier}}</span>
        {{#if style.isMastered}}
        <span class="keyword-tag ma-mastered-badge"
              title="{{localize 'EX2E.MAStyleMastered'}}">★</span>
        {{/if}}
        {{#if style.item.system.weapons}}
        <span class="ma-weapons-hint">{{style.item.system.weapons}}</span>
        {{/if}}
        <div class="item-controls">
          <button data-action="editItem" data-item-id="{{style.item.id}}"
                  title="{{localize 'EX2E.Open'}}">✏️</button>
          {{#if @root.isEditable}}
          <button data-action="deleteItem" data-item-id="{{style.item.id}}"
                  title="Delete">🗑</button>
          {{/if}}
        </div>
      </summary>

      <div class="charms-list">
        {{#each style.charms as |charm|}}
        <div class="charm-row item-row {{#if charm.system.active}}charm-active{{/if}}"
             data-item-id="{{charm.id}}">
          <img class="item-img" src="{{charm.img}}" alt="{{charm.name}}">
          <span class="item-name charm-name">
            {{#with (lookup @root.charmPrereqs charm.id) as |p|}}
              {{#if p.has}}
                {{#unless p.met}}
                <i class="fa-solid fa-triangle-exclamation charm-prereq-missing"
                   title="{{p.missing}}"></i>
                {{/unless}}
              {{/if}}
            {{/with}}
            {{#if charm.system.grantsMastery}}
            <span class="charm-mastery-star"
                  title="{{localize 'EX2E.MAStyleMastered'}}">★</span>
            {{/if}}
            {{charm.name}}
            <span class="charm-meta">
              {{charm.system.cost.motes}}m
              {{#if charm.system.cost.willpower}}+{{charm.system.cost.willpower}}wp{{/if}}
              · {{charm.system.duration}}
            </span>
          </span>
          {{#if charm.system.keywords.length}}
          <span class="charm-keywords">
            {{#each charm.system.keywords as |kw|}}
            <span class="keyword-tag">{{kw}}</span>
            {{/each}}
          </span>
          {{/if}}
          <div class="item-controls">
            <button type="button" data-action="activateCharm"
                    title="{{localize 'EX2E.ActivateCharm'}}">⚡</button>
            <button data-action="sendItemToChat"
                    title="{{localize 'EX2E.SendToChat'}}">💬</button>
            {{#if @root.isEditable}}
            <button data-action="editItem" title="Edit">✏️</button>
            <button data-action="deleteItem" title="Delete">🗑</button>
            {{/if}}
          </div>
        </div>
        {{/each}}

        {{#unless style.charms.length}}
        <div class="charm-row empty-row">
          <em>{{localize "EX2E.MAStyleNoCharms"}}</em>
        </div>
        {{/unless}}
      </div>
    </details>
    {{/each}}

    {{else}}
    <div class="empty-section">
      <p>{{localize "EX2E.MAStyleNoStyles"}}</p>
    </div>
    {{/if}}

  </div>
</div>
