<div class="tab {{cssClass}}" data-tab="tabInventory" data-group="sheet">
  <div class="sheet-body">

    <!-- ═══════ WEAPONS ═══════ -->
    <div class="section-toolbar ex2e-row">
      <h2 class="section-header" style="margin:0;flex:1">{{localize "EX2E.Weapons"}}</h2>
      {{#if isEditable}}
      <button class="btn-add-item" data-action="createItem" data-type="weapon">
        <i class="fa-solid fa-plus"></i>
      </button>
      {{/if}}
    </div>
    {{#each weapons as |w|}}
    <div class="item-row" data-item-id="{{w.id}}">
      <img class="item-img" src="{{w.img}}" alt="{{w.name}}">
      <span class="item-name">{{w.name}}</span>
      {{#with (lookup @root.weaponAmmoData w.id) as |ammoData|}}
      {{#if ammoData}}
      <select class="ammo-selector" data-weapon-id="{{w.id}}"
              style="width:180px;flex-shrink:0"
              {{#unless @root.isEditable}}disabled{{/unless}}>
        <option value="">— {{localize "EX2E.NoAmmo"}} —</option>
        {{#each ammoData.items as |a|}}
        <option value="{{a.id}}" {{#if (eq a.id ammoData.selectedId)}}selected{{/if}}>
          {{a.name}} ({{a.system.quantity}})
        </option>
        {{/each}}
      </select>
      {{/if}}
      {{/with}}
      <span class="item-stat">{{w.system.modes.length}} {{#if (eq w.system.modes.length 1)}}{{localize "EX2E.Mode"}}{{else}}{{localize "EX2E.Modes"}}{{/if}}</span>
      <div class="item-controls">
        <button data-action="toggleEquip" title="{{#if w.system.equipped}}Unequip{{else}}Equip{{/if}}">
          {{#if w.system.equipped}}🗡{{else}}○{{/if}}
        </button>
        {{#if (and w.system.artifact ../hasAttunementMotes)}}
        <button data-action="coverArtifactAttunement" data-item-id="{{w.id}}"
                title="{{localize 'EX2E.CoverArtifactAttunement'}}"
                class="btn-attune-cover{{#if (gte w.system.attunementMotesCover w.system.attunementCost)}} attune-covered{{/if}}">
          <i class="fa-solid fa-gem"></i>
        </button>
        {{/if}}
        {{#if ../isEditable}}
        <button data-action="editItem">✏️</button>
        <button data-action="deleteItem">🗑</button>
        {{/if}}
      </div>
      {{#if w.system.hearthstoneSlots}}
      <div class="hearthstone-socket-rows">
        {{#each (lookup ../artifactSlotMap w.id) as |slot|}}
        <div class="hearthstone-slot-row ex2e-row">
          {{#if slot.filled}}
          <span class="socket-label">⬡ {{slot.stoneName}} ★{{slot.stoneRating}}</span>
          {{else}}
          <span class="socket-label socket-empty">○ —</span>
          {{/if}}
        </div>
        {{/each}}
      </div>
      {{/if}}
    </div>
    {{/each}}

    <!-- ═══════ AMMO ═══════ -->
    {{#if ammoItems.length}}
    <div class="section-toolbar ex2e-row" style="margin-top:8px">
      <h3 class="section-header" style="margin:0;flex:1;font-size:0.85em;opacity:0.8">{{localize "EX2E.Ammunition"}}</h3>
      {{#if isEditable}}
      <button class="btn-add-item" data-action="createItem" data-type="ammo">
        <i class="fa-solid fa-plus"></i>
      </button>
      {{/if}}
    </div>
    {{#each ammoItems as |a|}}
    <div class="item-row" data-item-id="{{a.id}}">
      <img class="item-img" src="{{a.img}}" alt="{{a.name}}">
      <span class="item-name">{{a.name}}</span>
      <span class="item-stat">{{#if (eq a.system.ammoType "arrows")}}{{localize "EX2E.AmmoTypeArrows"}}{{else}}{{localize "EX2E.AmmoTypeFiredust"}}{{/if}}</span>
      <span class="item-stat">×{{a.system.quantity}}</span>
      <div class="item-controls">
        {{#if ../isEditable}}
        <button data-action="editItem">✏️</button>
        <button data-action="deleteItem">🗑</button>
        {{/if}}
      </div>
    </div>
    {{/each}}
    {{else}}
    {{#if isEditable}}
    <div style="display:flex;justify-content:flex-end;margin-top:4px">
      <button class="btn-add-item" data-action="createItem" data-type="ammo"
              title="{{localize 'EX2E.AddAmmo'}}">
        <i class="fa-solid fa-plus"></i> {{localize "EX2E.Ammunition"}}
      </button>
    </div>
    {{/if}}
    {{/if}}

    <!-- ═══════ ARMOR ═══════ -->
    <div class="section-toolbar ex2e-row" style="margin-top:16px">
      <h2 class="section-header" style="margin:0;flex:1">{{localize "EX2E.Armor"}}</h2>
      {{#if isEditable}}
      <button class="btn-add-item" data-action="createItem" data-type="armor">
        <i class="fa-solid fa-plus"></i>
      </button>
      {{/if}}
    </div>
    {{#each armors as |a|}}
    <div class="item-row" data-item-id="{{a.id}}">
      <img class="item-img" src="{{a.img}}" alt="{{a.name}}">
      <span class="item-name">{{a.name}}</span>
      <span class="item-stat">B{{a.system.effectiveSoak.bashing}}/L{{a.system.effectiveSoak.lethal}}/A{{a.system.effectiveSoak.aggravated}}</span>
      <span class="item-stat">Hard {{a.system.effectiveHardness}}</span>
      <span class="item-stat">Mob {{a.system.effectiveMobilityPenalty}}</span>
      <div class="item-controls">
        <button data-action="toggleEquip">{{#if a.system.equipped}}🛡{{else}}○{{/if}}</button>
        {{#if (and a.system.artifact ../hasAttunementMotes)}}
        <button data-action="coverArtifactAttunement" data-item-id="{{a.id}}"
                title="{{localize 'EX2E.CoverArtifactAttunement'}}"
                class="btn-attune-cover{{#if (gte a.system.attunementMotesCover a.system.attunementCost)}} attune-covered{{/if}}">
          <i class="fa-solid fa-gem"></i>
        </button>
        {{/if}}
        {{#if ../isEditable}}
        <button data-action="editItem">✏️</button>
        <button data-action="deleteItem">🗑</button>
        {{/if}}
      </div>
      {{#if a.system.hearthstoneSlots}}
      <div class="hearthstone-socket-rows">
        {{#each (lookup ../artifactSlotMap a.id) as |slot|}}
        <div class="hearthstone-slot-row ex2e-row">
          {{#if slot.filled}}
          <span class="socket-label">⬡ {{slot.stoneName}} ★{{slot.stoneRating}}</span>
          {{else}}
          <span class="socket-label socket-empty">○ —</span>
          {{/if}}
        </div>
        {{/each}}
      </div>
      {{/if}}
    </div>
    {{/each}}

    <!-- ═══════ BACKGROUNDS ═══════ -->
    <div class="section-toolbar ex2e-row" style="margin-top:16px">
      <h2 class="section-header" style="margin:0;flex:1">{{localize "EX2E.Backgrounds"}}</h2>
      {{#if isEditable}}
      <button class="btn-add-item" data-action="createItem" data-type="background">
        <i class="fa-solid fa-plus"></i>
      </button>
      {{/if}}
    </div>
    {{#each backgrounds as |bg|}}
    <div class="item-row" data-item-id="{{bg.id}}">
      <img class="item-img" src="{{bg.img}}" alt="{{bg.name}}">
      <span class="item-name">{{bg.name}}</span>
      {{dotRating name="system.value" value=bg.system.value max=5 min=0}}
      <div class="item-controls">
        {{#if ../isEditable}}
        <button data-action="editItem">✏️</button>
        <button data-action="deleteItem">🗑</button>
        {{/if}}
      </div>
    </div>
    {{/each}}
    <!-- ═══════ FAMILIARS ═══════ -->
    <div class="section-toolbar ex2e-row" style="margin-top:16px">
      <h2 class="section-header" style="margin:0;flex:1">{{localize "EX2E.Familiars"}}</h2>
      {{#if isEditable}}
      <button class="btn-add-item" data-action="createItem" data-type="familiar">
        <i class="fa-solid fa-plus"></i>
      </button>
      {{/if}}
    </div>
    {{#each familiars as |f|}}
    <div class="item-row" data-item-id="{{f.id}}">
      <img class="item-img" src="{{f.img}}" alt="{{f.name}}">
      <span class="item-name">{{f.name}}</span>
      {{#if f.system.species}}<span class="keyword-tag">{{f.system.species}}</span>{{/if}}
      {{dotRating name="bondRating" value=f.bondRating max=5 min=0 readonly=true}}
      {{#if f.linkedActorId}}
      <span class="item-stat">{{f.linkedActorName}}</span>
      <button data-action="openFamiliarActor" data-actor-id="{{f.linkedActorId}}"
              title="{{f.linkedActorName}}">
        <i class="fa-solid fa-up-right-from-square"></i>
      </button>
      {{/if}}
      <div class="item-controls">
        {{#if @root.isEditable}}
        <button data-action="editItem"><i class="fa-solid fa-edit"></i></button>
        <button data-action="deleteItem"><i class="fa-solid fa-trash"></i></button>
        {{/if}}
      </div>
    </div>
    {{/each}}
    <!-- ═══════ VEHICLES / MOUNTS ═══════ -->
    {{#if linkedVehicles.length}}
    <div class="section-toolbar ex2e-row" style="margin-top:16px">
      <h2 class="section-header" style="margin:0;flex:1">{{localize "EX2E.VehiclesMounts"}}</h2>
    </div>
    {{#each linkedVehicles as |v|}}
    <div class="item-row" data-item-id="{{v.itemId}}">
      <img src="{{v.img}}" class="item-img">
      <span class="item-name">
        {{v.name}}
        <span class="charm-meta">{{localize (concat "EX2E.VehicleType" (capitalize v.vehicleType))}}</span>
      </span>
      <div class="item-controls">
        <button type="button" data-action="openLinkedVehicle" data-vehicle-id="{{v.vehicleId}}"
                title="{{localize 'EX2E.OpenVehicleSheet'}}">
          <i class="fa-solid fa-external-link"></i>
        </button>
        {{#if v.isMounted}}
        <button type="button" data-action="dismountVehicle"
                title="{{localize 'EX2E.DismountVehicle'}}">
          <i class="fa-solid fa-person-walking"></i>
        </button>
        {{else}}
        <button type="button" data-action="mountVehicle" data-vehicle-id="{{v.vehicleId}}"
                title="{{localize 'EX2E.MountVehicle'}}">
          <i class="fa-solid fa-horse"></i>
        </button>
        {{/if}}
      </div>
    </div>
    {{/each}}
    {{/if}}
    <!-- ═══════ CULTS ═══════ -->
    <div class="section-toolbar ex2e-row" style="margin-top:16px">
      <h2 class="section-header" style="margin:0;flex:1">{{localize "EX2E.Cults"}}</h2>
      {{#if isEditable}}
      <button class="btn-add-item" data-action="createItem" data-type="cult">
        <i class="fa-solid fa-plus"></i>
      </button>
      {{/if}}
    </div>
    {{#each cults as |c|}}
    <div class="item-row" data-item-id="{{c.id}}">
      <img class="item-img" src="{{c.img}}" alt="{{c.name}}">
      <span class="item-name">{{c.name}}</span>
      {{#if c.moteRegen}}
      <span class="item-stat">{{c.moteRegen}}/hr</span>
      {{/if}}
      {{#if c.wpHours}}
      <span class="item-stat">
        WP {{#if (eq c.wpHours 24)}}{{localize "EX2E.CultWpDaily"}}{{else}}1/{{c.wpHours}}h{{/if}}
      </span>
      {{/if}}
      <div class="item-controls">
        {{#if @root.isEditable}}
        <button data-action="editItem"><i class="fa-solid fa-edit"></i></button>
        <button data-action="deleteItem"><i class="fa-solid fa-trash"></i></button>
        {{/if}}
      </div>
    </div>
    {{/each}}

    <!-- ═══════ MERITS / FLAWS ═══════ -->
    <div class="section-toolbar ex2e-row" style="margin-top:16px">
      <h2 class="section-header" style="margin:0;flex:1">{{localize "EX2E.MeritsAndFlaws"}}</h2>
      {{#if isEditable}}
      <button class="btn-add-item" data-action="createItem" data-type="meritflaw">
        <i class="fa-solid fa-plus"></i>
      </button>
      {{/if}}
    </div>
    {{#each meritflaws as |mf|}}
    <div class="item-row" data-item-id="{{mf.id}}">
      <img class="item-img" src="{{mf.img}}" alt="{{mf.name}}">
      <span class="item-name {{#if (eq mf.system.meritFlawType 'flaw')}}flaw-name{{/if}}">{{mf.name}}</span>
      <span class="keyword-tag">{{mf.system.meritFlawType}}</span>
      {{dotRating name="system.value" value=mf.system.value max=5 min=1}}
      <div class="item-controls">
        {{#if ../isEditable}}
        <button data-action="editItem">✏️</button>
        <button data-action="deleteItem">🗑</button>
        {{/if}}
      </div>
    </div>
    {{/each}}

    <!-- ═══════ HEARTHSTONES ═══════ -->
    <div class="section-toolbar ex2e-row" style="margin-top:16px">
      <h2 class="section-header" style="margin:0;flex:1">{{localize "EX2E.Hearthstones"}}</h2>
      {{#if isEditable}}
      <button class="btn-add-item" data-action="createItem" data-type="hearthstone">
        <i class="fa-solid fa-plus"></i>
      </button>
      {{/if}}
    </div>
    {{#each hearthstones as |hs|}}
    <div class="item-row" data-item-id="{{hs.id}}">
      <img class="item-img" src="{{hs.img}}" alt="{{hs.name}}">
      <span class="item-name">{{hs.name}}</span>
      <span class="item-stat">★{{hs.system.rating}} · {{mul hs.system.rating 2}}m/h</span>
      <div class="item-controls">
        {{#if ../isEditable}}
        <button data-action="editItem">✏️</button>
        <button data-action="deleteItem">🗑</button>
        {{/if}}
      </div>
    </div>
    {{/each}}

    <!-- ═══════ MANSES ═══════ -->
    <div class="section-toolbar ex2e-row" style="margin-top:16px">
      <h2 class="section-header" style="margin:0;flex:1">{{localize "EX2E.Manses"}}</h2>
      {{#if isEditable}}
      <button class="btn-add-item" data-action="createItem" data-type="manse">
        <i class="fa-solid fa-plus"></i>
      </button>
      {{/if}}
    </div>
    {{#each manses as |m|}}
    <div class="item-row" data-item-id="{{m.id}}">
      <img class="item-img" src="{{m.img}}" alt="{{m.name}}">
      <span class="item-name">{{m.name}}</span>
      <div class="item-controls">
        {{#if ../isEditable}}
        <button data-action="editItem">✏️</button>
        <button data-action="deleteItem">🗑</button>
        {{/if}}
      </div>
    </div>
    {{/each}}

    <!-- ═══════ EQUIPMENT ═══════ -->
    <div class="section-toolbar ex2e-row" style="margin-top:16px">
      <h2 class="section-header" style="margin:0;flex:1">{{localize "EX2E.Equipment"}}</h2>
      {{#if isEditable}}
      <button class="btn-add-item" data-action="createItem" data-type="equipment">
        <i class="fa-solid fa-plus"></i>
      </button>
      {{/if}}
    </div>
    {{#each equipments as |eq|}}
    <div class="item-row" data-item-id="{{eq.id}}">
      <img class="item-img" src="{{eq.img}}" alt="{{eq.name}}">
      <span class="item-name">{{eq.name}}</span>
      {{#if eq.system.artifact}}<span class="keyword-tag">{{localize "EX2E.ArtifactItem"}}</span>{{/if}}
      <div class="item-controls">
        <button data-action="toggleEquip">{{#if eq.system.equipped}}✓{{else}}○{{/if}}</button>
        {{#if ../isEditable}}
        <button data-action="editItem">✏️</button>
        <button data-action="deleteItem">🗑</button>
        {{/if}}
      </div>
      {{#if eq.system.hearthstoneSlots}}
      <div class="hearthstone-socket-rows">
        {{#each (lookup ../artifactSlotMap eq.id) as |slot|}}
        <div class="hearthstone-slot-row ex2e-row">
          {{#if slot.filled}}
          <span class="socket-label">⬡ {{slot.stoneName}} ★{{slot.stoneRating}}</span>
          {{else}}
          <span class="socket-label socket-empty">○ —</span>
          {{/if}}
        </div>
        {{/each}}
      </div>
      {{/if}}
    </div>
    {{/each}}

  </div>
</div>
