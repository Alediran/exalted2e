{{!-- Splat-specific scalar tracks. Rendered conditionally based on
     system.exaltType. Solar and mortal have no splat scalars in this
     pass, so nothing renders for them. --}}

{{#if (eq system.exaltType "lunar")}}
<h2 class="section-header">{{localize "EX2E.Splat"}}</h2>
<div class="splat-section">
  <div class="trait-row">
    <label>{{localize "EX2E.SplatLunarTell"}}</label>
    <input type="text" name="system.splat.lunar.tell" value="{{system.splat.lunar.tell}}"
           {{#unless isEditable}}readonly{{/unless}}>
  </div>
</div>
{{/if}}

{{#if (eq system.exaltType "terrestrial")}}
<h2 class="section-header">{{localize "EX2E.Splat"}}</h2>
<div class="splat-section">
  <div class="trait-row">
    <label>{{localize "EX2E.SplatBreeding"}}</label>
    {{dotRating name="system.splat.terrestrial.breeding" value=system.splat.terrestrial.breeding max=5 min=0}}
  </div>
</div>
{{/if}}

{{#if (eq system.exaltType "sidereal")}}
<h2 class="section-header">{{localize "EX2E.Splat"}}</h2>
<div class="splat-section">
  <div class="trait-row">
    <label>{{localize "EX2E.SplatParadox"}}</label>
    <input type="number" name="system.splat.sidereal.paradox" value="{{system.splat.sidereal.paradox}}"
           min="0" max="10" step="1" {{#unless isEditable}}readonly{{/unless}}>
  </div>
  <div class="trait-row">
    <label>{{localize "EX2E.SplatArcaneFate"}}</label>
    <input type="number" name="system.splat.sidereal.arcaneFate" value="{{system.splat.sidereal.arcaneFate}}"
           min="0" max="20" step="1" {{#unless isEditable}}readonly{{/unless}}>
  </div>
</div>
{{/if}}

{{#if (eq system.exaltType "abyssal")}}
<h2 class="section-header">{{localize "EX2E.Splat"}}</h2>
<div class="splat-section">
  <div class="trait-row">
    <label>{{localize "EX2E.SplatWhispers"}}</label>
    <input type="number" name="system.splat.abyssal.whispers" value="{{system.splat.abyssal.whispers}}"
           min="0" max="5" step="1" {{#unless isEditable}}readonly{{/unless}}>
  </div>
</div>
{{/if}}

{{#if (eq system.exaltType "infernal")}}
<h2 class="section-header">{{localize "EX2E.Splat"}}</h2>
<div class="splat-section">
  <div class="trait-row">
    <label>{{localize "EX2E.SplatPatron"}}</label>
    <select name="system.splat.infernal.patron" {{#unless isEditable}}disabled{{/unless}}>
      <option value="" {{#unless system.splat.infernal.patron}}selected{{/unless}}>{{localize "EX2E.SplatPatronNone"}}</option>
      {{#each yoziPatrons}}
      <option value="{{this.key}}" {{#if (eq this.key ../system.splat.infernal.patron)}}selected{{/if}}>{{this.label}}</option>
      {{/each}}
    </select>
  </div>
  <div class="trait-row">
    <label>{{localize "EX2E.SplatUrge"}}</label>
    <input type="text" name="system.splat.infernal.urge" value="{{system.splat.infernal.urge}}"
           {{#unless isEditable}}readonly{{/unless}}>
  </div>
  <div class="trait-row">
    <label>{{localize "EX2E.SplatActOfVillainy"}}</label>
    <input type="number" name="system.splat.infernal.actOfVillainy" value="{{system.splat.infernal.actOfVillainy}}"
           min="0" max="20" step="1" {{#unless isEditable}}readonly{{/unless}}>
  </div>
</div>
{{/if}}

{{#if (eq system.exaltType "alchemical")}}
<h2 class="section-header">{{localize "EX2E.Splat"}}</h2>
<div class="splat-section">
  <div class="trait-row">
    <label>{{localize "EX2E.SplatDissonance"}}</label>
    <input type="number" name="system.splat.alchemical.dissonance" value="{{system.splat.alchemical.dissonance}}"
           min="0" max="10" step="1" {{#unless isEditable}}readonly{{/unless}}>
  </div>
</div>
{{/if}}
