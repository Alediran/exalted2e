<div class="sheet-body npc-body">

  <!-- Combat Stats -->
  <h2 class="section-header">{{localize "EX2E.Combat"}}</h2>
  <div class="combat-stat-grid">
    <div class="stat-item">
      <span class="stat-label">{{localize "EX2E.JoinBattle"}}</span>
      <button class="roll-btn" data-action="rollPool"
              data-pool="{{system.combat.joinBattle}}" data-flavor="Join Battle">
        {{system.combat.joinBattle}}⚄
      </button>
    </div>
    <div class="stat-item">
      <span class="stat-label">{{localize "EX2E.DodgeDV"}}</span>
      <span class="stat-value">{{system.combat.dodgeDV}}</span>
    </div>
    <div class="stat-item">
      <span class="stat-label">{{localize "EX2E.ParryDV"}}</span>
      <span class="stat-value">{{system.combat.parryDV}}</span>
    </div>
    <div class="stat-item">
      <span class="stat-label">{{localize "EX2E.DodgeMDV"}}</span>
      <span class="stat-value">{{system.combat.dodgeMDV}}</span>
    </div>
    <div class="stat-item">
      <span class="stat-label">{{localize "EX2E.ParryMDV"}}</span>
      <span class="stat-value">{{system.combat.parryMDV}}</span>
    </div>
    <div class="stat-item">
      <span class="stat-label">{{localize "EX2E.Hardness"}}</span>
      <span class="stat-value">{{system.combat.hardness}}</span>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="action-button-row">
    <button type="button" data-action="rollSocialAttack">
      <i class="fa-solid fa-comments"></i> {{localize "EX2E.SocialAttack"}}
    </button>
  </div>

  <!-- Soak -->
  <div class="soak-row">
    <strong>{{localize "EX2E.Soak"}}:</strong>
    B{{system.combat.soak.bashing}} / L{{system.combat.soak.lethal}} / A{{system.combat.soak.aggravated}}
  </div>

  <!-- Pools -->
  <h2 class="section-header">{{localize "EX2E.DicePools"}}</h2>
  <div class="combat-stat-grid">
    <div class="stat-item">
      <span class="stat-label">{{localize "EX2E.Combat"}}</span>
      <button class="roll-btn" data-action="rollPool"
              data-pool="{{system.pools.combat}}" data-flavor="Combat Roll">
        {{system.pools.combat}}⚄
      </button>
    </div>
    <div class="stat-item">
      <span class="stat-label">{{localize "EX2E.SocialPool"}}</span>
      <button class="roll-btn" data-action="rollPool"
              data-pool="{{system.pools.social}}" data-flavor="Social Roll">
        {{system.pools.social}}⚄
      </button>
    </div>
    <div class="stat-item">
      <span class="stat-label">{{localize "EX2E.PhysicalPool"}}</span>
      <button class="roll-btn" data-action="rollPool"
              data-pool="{{system.pools.physical}}" data-flavor="Physical Roll">
        {{system.pools.physical}}⚄
      </button>
    </div>
  </div>

  {{#if isEditable}}
  <!-- Edit combat stats directly -->
  <details class="stat-edit-block">
    <summary>Edit Stats</summary>
    <div class="stat-edit-grid">
      <div class="field-group"><label>{{localize "EX2E.JoinBattle"}}</label>
        <input type="number" name="system.combat.joinBattle" value="{{system.combat.joinBattle}}" min="0" max="30"></div>
      <div class="field-group"><label>{{localize "EX2E.DodgeDV"}}</label>
        <input type="number" name="system.combat.dodgeDV"    value="{{system.combat.dodgeDV}}"    min="0" max="15"></div>
      <div class="field-group"><label>{{localize "EX2E.ParryDV"}}</label>
        <input type="number" name="system.combat.parryDV"    value="{{system.combat.parryDV}}"    min="0" max="15"></div>
      <div class="field-group"><label>{{localize "EX2E.DodgeMDV"}}</label>
        <input type="number" name="system.combat.dodgeMDV" value="{{system.combat.dodgeMDV}}" min="0" max="15"></div>
      <div class="field-group"><label>{{localize "EX2E.ParryMDV"}}</label>
        <input type="number" name="system.combat.parryMDV" value="{{system.combat.parryMDV}}" min="0" max="15"></div>
      <div class="field-group"><label>{{localize "EX2E.Hardness"}}</label>
        <input type="number" name="system.combat.hardness"   value="{{system.combat.hardness}}"   min="0" max="20"></div>
      <div class="field-group"><label>{{localize "EX2E.SoakBashing"}}</label>
        <input type="number" name="system.combat.soak.bashing"    value="{{system.combat.soak.bashing}}"    min="0"></div>
      <div class="field-group"><label>{{localize "EX2E.SoakLethal"}}</label>
        <input type="number" name="system.combat.soak.lethal"     value="{{system.combat.soak.lethal}}"     min="0"></div>
      <div class="field-group"><label>{{localize "EX2E.SoakAggravated"}}</label>
        <input type="number" name="system.combat.soak.aggravated" value="{{system.combat.soak.aggravated}}"  min="0"></div>
      <div class="field-group"><label>{{localize "EX2E.CombatPool"}}</label>
        <input type="number" name="system.pools.combat"   value="{{system.pools.combat}}"  min="0"></div>
      <div class="field-group"><label>{{localize "EX2E.SocialPool"}}</label>
        <input type="number" name="system.pools.social"   value="{{system.pools.social}}"  min="0"></div>
      <div class="field-group"><label>{{localize "EX2E.PhysicalPool"}}</label>
        <input type="number" name="system.pools.physical" value="{{system.pools.physical}}" min="0"></div>
      <div class="field-group"><label>{{localize "EX2E.WoundPenalty"}}</label>
        <input type="number" name="system.combat.woundPenalty" value="{{system.combat.woundPenalty}}" min="0" max="4"></div>
    </div>
  </details>
  {{/if}}

  <!-- Health Track -->
  <h2 class="section-header">{{localize "EX2E.Health"}}</h2>
  {{healthTrack health=system.health}}
  <div class="health-info">
    <span>Total Boxes:
      {{#if isEditable}}
      <input type="number" name="system.health.totalBoxes" value="{{system.health.totalBoxes}}" min="1" max="50" style="width:50px">
      {{else}}{{system.health.totalBoxes}}{{/if}}
    </span>
  </div>
  {{#if isEditable}}
  <div class="damage-controls">
    <button class="damage-btn bashing"    data-action="applyDamage" data-damage-type="bashing"    data-amount="1">+1B</button>
    <button class="damage-btn lethal"     data-action="applyDamage" data-damage-type="lethal"     data-amount="1">+1L</button>
    <button class="damage-btn aggravated" data-action="applyDamage" data-damage-type="aggravated" data-amount="1">+1A</button>
    <button class="damage-btn heal"       data-action="healDamage"  data-amount="1">{{localize "EX2E.Heal"}} 1</button>
  </div>
  {{/if}}

  <!-- Attacks -->
  <h2 class="section-header">{{localize "EX2E.Attacks"}}</h2>
  {{#if isEditable}}
  <button class="btn-add-item" data-action="addAttack">+ {{localize "EX2E.AddAttack"}}</button>
  {{/if}}
  {{#each system.attacks as |atk idx|}}
  <div class="item-row attack-row" data-attack-index="{{idx}}">
    {{#if @root.isEditable}}
    <input type="text"   name="system.attacks.{{idx}}.name"   value="{{atk.name}}"   style="width:110px" title="Name">
    <input type="number" name="system.attacks.{{idx}}.pool"   value="{{atk.pool}}"   min="0" max="50" style="width:42px" title="Pool">
    <input type="text"   name="system.attacks.{{idx}}.damage" value="{{atk.damage}}" style="width:42px" title="Damage (e.g. 8L)">
    <span class="stat-label" style="font-size:0.75em">Spd</span>
    <input type="number" name="system.attacks.{{idx}}.speed"  value="{{atk.speed}}"  min="1" max="10" style="width:36px" title="Speed">
    <span class="stat-label" style="font-size:0.75em">Rate</span>
    <input type="number" name="system.attacks.{{idx}}.rate"   value="{{atk.rate}}"   min="1" max="10" style="width:36px" title="Rate">
    {{else}}
    <span class="item-name">{{atk.name}}</span>
    <span class="stat-value" style="font-size:0.85em">{{atk.pool}}⚄ {{atk.damage}} Spd{{atk.speed}} Rate{{atk.rate}}</span>
    {{/if}}
    <div class="item-controls">
      <button data-action="rollNpcAttack" title="{{localize 'EX2E.RollAttack'}}">⚔</button>
      {{#if @root.isEditable}}
      <button data-action="deleteAttack" title="Delete">🗑</button>
      {{/if}}
    </div>
  </div>
  {{/each}}

  <!-- Charms -->
  <h2 class="section-header">{{localize "EX2E.CharmsPowers"}}</h2>
  {{#if isEditable}}
  <button class="btn-add-item" data-action="createItem" data-type="charm">+ {{localize "EX2E.AddCharm"}}</button>
  {{/if}}
  {{#each charms as |c|}}
  <div class="item-row" data-item-id="{{c.id}}">
    <img class="item-img" src="{{c.img}}" alt="{{c.name}}">
    <span class="item-name">{{c.name}}</span>
    <div class="item-controls">
      <button data-action="activateCharm" title="{{localize 'EX2E.ActivateCharm'}}">⚡</button>
      <button data-action="sendItemToChat" title="{{localize 'EX2E.SendToChat'}}">💬</button>
      {{#if @root.isEditable}}
      <button data-action="editItem" title="Edit">✏️</button>
      <button data-action="deleteItem" title="Delete">🗑</button>
      {{/if}}
    </div>
  </div>
  {{/each}}

  <!-- Combos -->
  <div class="section-toolbar" style="margin-top:16px">
    <h2 class="section-header" style="margin:0;flex:1">{{localize "EX2E.Combos"}}</h2>
    {{#if isEditable}}
    <button class="btn-add-item" data-action="createItem" data-type="combo"
            title="{{localize 'EX2E.AddCombo'}}">
      <i class="fa-solid fa-plus"></i> {{localize "EX2E.AddCombo"}}
    </button>
    {{/if}}
  </div>
  {{#if combos.length}}
  <div class="charms-list">
    {{#each combos as |combo|}}
    <div class="charm-row item-row combo-row" data-item-id="{{combo.id}}">
      <img class="item-img" src="{{combo.img}}" alt="{{combo.name}}">
      <span class="item-name charm-name">
        {{combo.name}}
        <span class="charm-meta">
          {{#if combo.costPreview}}{{combo.costPreview}} · {{/if}}
          {{combo.totalCount}} {{localize "EX2E.Charms"}}
          {{#if combo.missingCount}}
            · <i class="fa-solid fa-triangle-exclamation charm-prereq-missing"
                 title="{{localize 'EX2E.ComboBroken'}}"></i> {{combo.missingCount}}
          {{/if}}
        </span>
      </span>
      <span class="charm-keywords combo-icon-strip">
        {{#each combo.iconStrip as |c|}}
        <img class="combo-strip-img" src="{{c.img}}" alt="{{c.name}}" title="{{c.name}}">
        {{/each}}
      </span>
      <div class="item-controls">
        <button data-action="activateCombo"
                {{#unless combo.canActivate}}disabled{{/unless}}
                title="{{localize 'EX2E.ComboActivate'}}">⚡</button>
        <button data-action="sendItemToChat" title="{{localize 'EX2E.SendToChat'}}">💬</button>
        {{#if @root.isEditable}}
        <button data-action="editItem"   title="Edit">✏️</button>
        <button data-action="deleteItem" title="Delete">🗑</button>
        {{/if}}
      </div>
    </div>
    {{/each}}
  </div>
  {{else}}
  <p class="empty-msg">{{localize "EX2E.NoCombos"}}</p>
  {{/if}}

  <!-- Powers -->
  <h2 class="section-header">{{localize "EX2E.NotesPowers"}}</h2>
  <div class="editor-container">
    {{#if isEditable}}
    <prose-mirror name="system.powers" data-document-uuid="{{actor.uuid}}" value="{{system.powers}}" collaborate="true" toggled="true">
      {{{enrichedPowers}}}
    </prose-mirror>
    {{else}}
    <div class="editor-content">{{{enrichedPowers}}}</div>
    {{/if}}
  </div>

  <!-- Attack Notes -->
  {{#if enrichedNotes}}
  <h2 class="section-header">{{localize "EX2E.AttackNotes"}}</h2>
  <div class="editor-container">
    {{#if isEditable}}
    <prose-mirror name="system.notes" data-document-uuid="{{actor.uuid}}" value="{{system.notes}}" collaborate="true" toggled="true">
      {{{enrichedNotes}}}
    </prose-mirror>
    {{else}}
    <div class="editor-content">{{{enrichedNotes}}}</div>
    {{/if}}
  </div>
  {{/if}}

  <!-- Biography -->
  {{#if enrichedBiography}}
  <details class="biography-block" style="margin-top:8px">
    <summary style="cursor:pointer"><h2 class="section-header" style="display:inline;margin:0">{{localize "EX2E.Biography"}}</h2></summary>
    <div class="editor-container" style="margin-top:4px">
      {{#if isEditable}}
      <prose-mirror name="system.biography" data-document-uuid="{{actor.uuid}}" value="{{system.biography}}" collaborate="true" toggled="true">
        {{{enrichedBiography}}}
      </prose-mirror>
      {{else}}
      <div class="editor-content">{{{enrichedBiography}}}</div>
      {{/if}}
    </div>
  </details>
  {{/if}}

</div>
