<div class="character-header npc-header">
  <div class="portrait-frame">
    <img class="actor-portrait" src="{{actor.img}}" alt="{{actor.name}}" data-edit="img" title="{{actor.name}}"
         data-action="onEditImage" {{#unless isEditable}}disabled{{/unless}}>
  </div>
  <div class="header-fields">
    <input class="actor-name" type="text" name="name" value="{{actor.name}}"
           {{#unless isEditable}}readonly{{/unless}}>
    <div class="identity-row">
      <div class="field-group" style="flex:0 0 auto">
        <label>{{localize "EX2E.NpcType"}}</label>
        <select name="system.npcType" {{#unless isEditable}}disabled{{/unless}}>
          {{#each npcTypes}}
          <option value="{{@key}}"{{#if (eq ../system.npcType @key)}} selected{{/if}}>{{localize this}}</option>
          {{/each}}
        </select>
      </div>
      <div class="field-group">
        <label>{{localize "EX2E.Concept"}}</label>
        <input type="text" name="system.concept" value="{{system.concept}}"
               placeholder="{{localize 'EX2E.ConceptPlaceholder'}}" {{#unless isEditable}}readonly{{/unless}}>
      </div>
      <div class="field-group" style="align-items:center">
        <label style="display:flex;align-items:center;gap:4px;cursor:pointer;white-space:nowrap">
          {{#if isEditable}}
          <input type="checkbox" name="system.isExtra" {{#if system.isExtra}}checked{{/if}}>
          {{/if}}
          {{#unless isEditable}}{{#if system.isExtra}}<i class="fa-solid fa-user-minus"></i>{{/if}}{{/unless}}
          {{localize "EX2E.Extra"}}
        </label>
      </div>
    </div>
    <!-- Essence + Willpower + Motes row -->
    <div class="ex2e-header-row">
      <div class="field-group" style="flex:0 0 auto">
        <label>{{localize "EX2E.Essence"}}</label>
        {{dotRating name="system.essence.value" value=system.essence.value max=10 min=1}}
      </div>
      <div class="field-group willpower-group">
        <label>{{localize "EX2E.Willpower"}}</label>
        {{dotRating name="system.willpower.max" value=system.willpower.max max=10 min=1}}
        {{boxRating name="system.willpower.value" value=system.willpower.value max=system.willpower.max total=10 min=0}}
      </div>
      <div class="field-group mote-pools" style="flex:0 0 auto">
        <div class="mote-pool-block"
             title="{{localize 'EX2E.Motes'}} {{system.motes.value}} / {{system.motes.max}}">
          <span class="pool-label">{{localize "EX2E.Motes"}}</span>
          <input type="number" name="system.motes.value" value="{{system.motes.value}}"
                 min="0" max="{{system.motes.max}}"
                 {{#unless isEditable}}readonly{{/unless}}>
          <span class="pool-sep">/</span>
          {{#if isEditable}}
          <input type="number" name="system.motes.max" value="{{system.motes.max}}"
                 min="0" max="2000" style="width:44px">
          {{else}}
          <span class="pool-max">{{system.motes.max}}</span>
          {{/if}}
        </div>
      </div>
    </div>
  </div>
</div>
